@model DomainEntities.ChangePassword
<script src="~/Scripts/jquery.validate.min.js"></script>
<script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>
<script src="~/Scripts/Client Scripts/mvcfoolproof.unobtrusive.min.js"></script>
<script type="text/javascript">
    $(document).ready(function () {

        $(".modal").on("hidden.bs.modal", function () {
            $("#errorMessage").html("");
            $('#formChangePassword')[0].reset();

        });


        $("#changePassword").click(function (e) {
        if (!$('form#formChangePassword').data('unobtrusiveValidation').validate()) {
            e.preventDefault();
            return false;
        }
        else {

            $.ajax({
                url: '@Url.Action("changePassword", "ChangePassword")',
                type: 'POST',
                dataType: 'json',
                data: {
                    oldPassword: $("#oldPassword").val(),
                    newPassword1: $("#newPassword1").val(),
                    newPassword2: $("#newPassword2").val()
                },
                success: function (data) {
                    $("#errorMessage").html(data.responseText);
                    $('#formChangePassword')[0].reset();
                }
            });
        }
        });
    });

</script>

@using (Html.BeginForm("", "", FormMethod.Post, new { enctype = "multipart/form-data", id = "formChangePassword", name = "formChangePassword", onSubmit = "return false;" }))
{
    @Html.AntiForgeryToken()
    <div class="modal fade" id="myModal" role="dialog">
        <div class="modal-dialog">

            <!-- Modal content-->
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                    <h4 class="modal-title">Change Password</h4>
                </div>

                <div class="modal-body">
                    
                            <div class="form-group success">
                                @Html.LabelFor(model => model.oldPassword)<span style="color:red">*</span>
                                @Html.PasswordFor(model => model.oldPassword, new { @class = "form-control" })
                                @Html.ValidationMessageFor(model => model.oldPassword, String.Empty, new { @class = "text-danger" })
                            </div>

                            <div class="form-group  success">
                                @Html.LabelFor(model => model.newPassword1)<span style="color:red">*</span>
                                @Html.PasswordFor(model => model.newPassword1, new { @class = "form-control" })
                                @Html.ValidationMessageFor(model => model.newPassword1, String.Empty, new { @class = "text-danger" })
                            </div>
                            <div class="form-group success">
                               @Html.LabelFor(model => model.newPassword2)<span style="color:red">*</span>
                            @Html.PasswordFor(model => model.newPassword2, new { @class = "form-control" })
                            @Html.ValidationMessageFor(model => model.newPassword2, String.Empty, new { @class = "text-danger" })
                            </div>
                       
                </div>
                <div class="modal-footer">
                    <span id="errorMessage" style="float:left;color:red"></span>
                    <input class="btn btn-primary" name="changePassword" id="changePassword" value="Change Password" type="submit"/>
                    <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
                 </div>
            </div>

        </div>
    </div>
}