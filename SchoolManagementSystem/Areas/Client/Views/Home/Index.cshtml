@model DomainEntities.ClientLogin
@using CaptchaMvc.HtmlHelpers
@{
    Layout = null;
}
<script src="~/Scripts/jquery-1.10.2.min.js"></script>
<script src="~/Scripts/jquery.validate.min.js"></script>
<script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>

<link href="~/Content/CSS/bootstrap.css" rel="stylesheet" />
<script src="~/Scripts/bootstrap.min.js"></script>
<script src="~/Content/JS/FrontEnd/ClientLogin.js"></script>
<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Parents Login</title>
    <style>
        #CaptchaImage {
            max-height: 40px;
            float: left;
        }

        #CaptchaInputText {
            display: block;
            width: 37%;
            height: 28px;
            padding: 6px 10px;
            font-size: 14px;
            line-height: 1.42857143;
            color: #555;
            background-color: #fff;
            background-image: none;
            border: 1px solid #ccc;
            border-radius: 4px !important;
            -webkit-box-shadow: inset 0 1px 1px rgba(0, 0, 0, .075);
            box-shadow: inset 0 1px 1px rgba(0, 0, 0, .075);
            -webkit-transition: border-color ease-in-out .15s, -webkit-box-shadow ease-in-out .15s;
            -o-transition: border-color ease-in-out .15s, box-shadow ease-in-out .15s;
            transition: border-color ease-in-out .15s, box-shadow ease-in-out .15s;
        }
    </style>
</head>
<body>
    <div class="container-fluid">
        <div class="row" style="margin-top:100px;">
            <div class="col-lg-4 col-sm-3 col-xs-1"></div>
            <div class="col-lg-4 col-sm-6 col-xs-10" style="border-radius:6px;border:1px solid black">
                <h2>Parent Login</h2>
                <hr />
                @using (Html.BeginForm("Login", "Home", FormMethod.Post, new { enctype = "multipart/form-data", id = "formParent", name = "formParent" }))
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(model => model.ID)
                    <div class="row">
                        <div class="col-lg-12">
                            <div class="form-group success">
                                @Html.LabelFor(model => model.Email)
                                @Html.TextBoxFor(model => model.Email, new { @class = "form-control", type = "Email", placeholder = "Enter Email" })
                                @Html.ValidationMessageFor(model => model.Email, String.Empty, new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="col-lg-12">
                            <div class="form-group success">
                                @Html.LabelFor(model => model.Password)
                                @Html.TextBoxFor(model => model.Password, new { @class = "form-control", type = "Password", Placeholder = "Enter Password" })
                                @Html.ValidationMessageFor(model => model.Password, String.Empty, new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="col-lg-12 col-sm-12">
                            <span>@Html.Captcha(5)</span>
                            <div class="form-group error">
                                <input class="btn btn-success" style="width:17%" name="clientLogin" id="clientLogin" value="Login" type="submit">
                                <input class="btn btn-danger" style="width:17%" name="clientCancel" id="ClientCancel" value="Cancel" type="reset">
                                &nbsp;<b> OR </b>&nbsp;
                                
                                <a href="javascript:void(0);" data-toggle="modal" data-target="#myModal"><u>Forgot Password !!!</u></a>
                            </div>
                        </div>
                        <div class="col-lg-12">
                            <span id="errorMsg" style="color:Black; font-weight:bold;">@TempData["Login_Error"]</span>
                        </div>
                    </div>
                }
                <div class="row" style="background-color:black;color:white;">
                    <p style="padding:8px 0px 0px 10px;">&copy; Creative Techno Solutions. | @DateTime.Now.Year</p>
                </div>
            </div>
            <div class="col-lg-4 col-sm-3 col-xs-1"></div>
        </div>
    </div>
    @{ Html.RenderAction("Index", "ForgotPassword", new { area = "Client" }); }
</body>
</html>
