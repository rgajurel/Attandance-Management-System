<div class="page-header">
    <div class="breadcrumb-line">
        <ul class="breadcrumb">
            <li>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<i class="fa fa-home position-left"></i>Parents</li>
            <li class="active">Students Result</li>
        </ul>

    </div>
</div>
<br />

<div class="container-fluid">
    @using (Html.BeginForm("", "", FormMethod.Post, new { enctype = "multipart/form-data", id = "formMarksEntry", name = "formMarksEntry", onSubmit = "return false;" }))
    {
        <div class="row" style="margin:0px !important">
             <div class="col-lg-3 col-sm-6">
                @Html.LabelFor(model => model.Name)<span style="color:red">*</span>
                @Html.DropDownListFor(model => model.ID, (SelectList)ViewBag.termsList, "--Select--", new { @class = "form-control", required = "required" })
                @Html.ValidationMessageFor(model => model.ID, String.Empty, new { @class = "text-danger" })
            </div>
            <div class="col-lg-3">
                <button style="margin-top:23px" class="btn refresh" onclick="printMarksheet()">View Result</button> 
            </div>
        </div>
    }
</div>
<div id="divPrintContiner" style="display:none"></div>
<style>
    
    *{
	-webkit-padding-start: 0px;
}


.flex{
	display: flex;
	align-items: center;
	justify-content: space-between;
}
.marksheet{
	border:1px solid #2f2f2f;
    margin: 0 auto;
   width: 21cm;
  height: 29.6cm; 
    display: block;
   
} 
header{
    position: relative;
    border-bottom: 1px solid #2f2f2f;
}
header img {
    position: absolute;
    left: 10px;
}
.centered{
	margin:0 auto;
	display: block;
}
.txt-centered{
	text-align: center;
}
.progress-report{
	display: flex;
	align-items: center;
	justify-content: space-around;
}
.sm-bot-border{
	border-bottom: 1px dotted #716b6b;
    padding: 0px 40px 0px 0px;
}
.md-bot-border{
	border-bottom: 1px dotted #716b6b;
    padding: 0px 40px 0px 0px;
}
.lg-bot-border{
	border-bottom: 1px dotted #716b6b;
    padding: 0px 40px 0px 0px;
}
.student-detail{
	border-bottom: 1px solid #2f2f2f;
}
.student-detail >div {
    width: 90%;
}
td, th {
    border-bottom: 1px solid #000;
    border-right: 1px solid #000;
   height:27px;
    text-align: center;
}
[colspan="3"] {
    border-bottom: 2px solid black;
}
table {
    display: table;
    border-collapse: collapse;
    border: 1px solid black;
    width: 100%;
}
.tables{
	padding:0px 5px;
}
/*table tr th:nth-child(2) {
    width: 25%;
}*/
section.table-detail table {
    width: 59%;
    height:290px;
    float: left;
    margin-right: 1%;
    border-radius:2px 2px 2px 2px;
}

section.table-detail article {
    width: 38.2%;
    float: left;
    height:293px;
    border: 0.5px solid #000;
    padding: 5px;
    border-radius:2px 2px 2px 2px;
}
section.table-detail article label {
    border-bottom: 1px solid #383737;
}
section.table-detail article ul {
    list-style: none;
    margin: 2px;
}
section.table-detail article ul li{
	display: flex;
	align-items: center;
	justify-content: space-between;
	padding: 3px 10px 2px 20px; 
}
section.table-detail {
    padding: 5px;
    overflow: hidden;
}
h1, h2, h3, h4, h5, h6 {
    margin: 8px 0px !important;
}
footer {
    height: 70px;
   margin-top: 70px;
}
footer ul {
    list-style: none;
    display: flex;
    justify-content: space-around;
}
footer ul li{
	text-align: center;
	    display: flex;
    flex-direction: column;
}
</style>
