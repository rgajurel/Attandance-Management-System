

@model DomainEntities.TakeAdvance
    @using Kendo.Mvc.UI
<script src="~/Scripts/jquery.validate.min.js"></script>
<script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>
<script src="~/Content/JS/BackEnd/TakeAdvance.js"></script>


<div class="row">
    <div class="col-md-12">
        <ol class="breadcrumb">
            <li><i class="fa fa-home"></i><a href="/Admin/AccumulativeLeave">HR/Payroll</a></li>
            <li><a href="/Admin/AccumulativeLeave">Take Advance</a></li>
            <li class="pull-right"><button class="btn btn-danger create" type="submit">Create New</button></li>
        </ol>
    </div>
</div>

<div style="display:none" id="hide">
    <div class="content">
        <div class="row">
            <div class="col-sm-12">
                <div class="panel panel-default">
                    <div class="panel-heading">
                        <h4 class="panel-title">Take Advance</h4>
                    </div>

                    <div class="panel-body">
                        <div class="col-sm-12">
                            @using (Html.BeginForm("", "", FormMethod.Post, new { enctype = "multipart/form-data",autocomplete="off", id = "formTakeAdvanceEntry", name = "formTakeAdvanceEntry", onSubmit = "return false;" }))
                            {
                                @Html.AntiForgeryToken()

                                <div class="row">
                                    <div class="col-md-3">
                                        @Html.HiddenFor(model => model.ID)
                                        @Html.LabelFor(model => model.OrganisationID)<span style="color:red">*</span>
                                        @Html.DropDownListFor(model => model.OrganisationID, Enumerable.Empty<SelectListItem>(), "--Select--", new { @class = "form-control", required = "required" })
                                        @Html.ValidationMessageFor(model => model.OrganisationID, String.Empty, new { @class = "text-danger" })
                                    </div>
                                    <div class="col-md-3">

                                        @Html.LabelFor(model => model.EmployeeID)<span style="color:red">*</span>
                                        @Html.DropDownListFor(model => model.EmployeeID, Enumerable.Empty<SelectListItem>(), "--Select--", new { @class = "form-control", required = "required" })
                                        @Html.ValidationMessageFor(model => model.EmployeeID, String.Empty, new { @class = "text-danger" })
                                    </div>
                                    <div class="col-md-2">

                                        @Html.LabelFor(model => model.Year)<span style="color:red">*</span>
                                        @Html.DropDownListFor(model => model.Year, (SelectList)ViewBag.sessionList, "--Select--", new { @class = "form-control", required = "required" })
                                        @Html.ValidationMessageFor(model => model.Year, String.Empty, new { @class = "text-danger" })
                                    </div>

                                    <div class="col-md-2">
                                        @Html.LabelFor(model => model.Month)<span style="color:red">*</span>
                                        @Html.DropDownListFor(model => model.Month, (SelectList)ViewBag.monthList, "--Select--", new { @class = "form-control", required = "required" })
                                        @Html.ValidationMessageFor(model => model.Month, String.Empty, new { @class = "text-danger" })
                                    </div>
                                   
                                    <div class="col-md-2">
                                        @Html.LabelFor(model => model.Date)
                                        @(Html.Kendo().DateTimePickerFor(m => m.Date)
       .Name("Date")
        .Value(DateTime.Now)
        .Format("MM-dd-yyyy")
                                         .HtmlAttributes(new { @class = "form-control" })
                                        )
                                        @Html.ValidationMessageFor(model => model.Date, String.Empty, new { @class = "text-danger" })
                                    </div>



                                </div>
                                <div class="row">
                                    <div class="col-md-2">

                                        @Html.LabelFor(model => model.Amount)<span style="color:red">*</span>
                                        @Html.TextBoxFor(model => model.Amount, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(model => model.Amount, String.Empty, new { @class = "text-danger" })
                                    </div>
                                    <div class="col-sm-3 pulldown">
                                        <input  class="btn btn-danger " name="saveTakeAdvance" id="saveTakeAdvance" value="Save" type="submit">
                                        <button type="button" class="btn cancel" name="Cancel">Cancel</button>  

                                    </div>

                                </div>

                            }

                        </div>
                    </div>
                </div>
            </div>
        </div>
        </div>
</div>
        <div id="list">
            
        </div>

<div class="row" id="show">
    <div class="col-md-12">
      @Html.Partial("~/Areas/Admin/Views/TakeAdvance/TakeAdvanceList.cshtml")
    </div>
</div> 
