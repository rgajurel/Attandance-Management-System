
@model DomainEntities.TakeLeave
@using Kendo.Mvc.UI
<script src="~/Scripts/jquery.validate.min.js"></script>
<script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>
<script src="~/Content/JS/BackEnd/TakeLeave.js"></script>


<div class="row">
    <div class="col-md-12">
        <ol class="breadcrumb">
            <li><i class="fa fa-home"></i><a href="/Admin/SchoolInformation">HR/Payroll</a></li>
            <li><a href="/Admin/OrganisationType">Take Leave Manage</a></li>
            <li class="pull-right"><button class="btn btn-danger create" type="submit">Create New</button></li>
        </ol>
    </div>
</div>
<div style="display:none" id="hide">
    <div class="content">
        <div class="row">
            <div class="col-sm-12">
                <div class="panel panel-default">
                    <div class="panel-heading">
                        <h4 class="panel-title">Take Leave</h4>
                    </div>
                    <div class="panel-body">
                        <div class="col-sm-12">
                            @using (Html.BeginForm("", "", FormMethod.Post, new { enctype = "multipart/form-data", id = "formTakeLeave", name = "formTakeLeave", onSubmit = "return false;" }))
                            {
                                @Html.AntiForgeryToken()
                                <div class="row">
                                    <div class="form-group">

                                        <div class="col-md-3">
                                            @Html.HiddenFor(model => model.ID)
                                            @Html.LabelFor(model => model.OrganisationID)<span style="color:red">*</span>
                                            @Html.DropDownListFor(model => model.OrganisationID, Enumerable.Empty<SelectListItem>(), "--Organisation--", new { @class = "form-control", required = "required" })
                                            @Html.ValidationMessageFor(model => model.OrganisationID, String.Empty, new { @class = "text-danger" })
                                        </div>
                                        <div class="col-md-3">

                                            @Html.LabelFor(model => model.LeaveTypeID)<span style="color:red">*</span>
                                            @Html.DropDownListFor(model => model.LeaveTypeID, Enumerable.Empty<SelectListItem>(), "--Select--", new { @class = "form-control" })
                                            @Html.ValidationMessageFor(model => model.LeaveTypeID, String.Empty, new { @class = "text-danger" })
                                        </div>
                                        <div class="col-md-3">

                                            @Html.LabelFor(model => model.EmployeeID)<span style="color:red">*</span>
                                            @Html.DropDownListFor(model => model.EmployeeID, Enumerable.Empty<SelectListItem>(), "--Select--", new { @class = "form-control" })
                                            @Html.ValidationMessageFor(model => model.EmployeeID, String.Empty, new { @class = "text-danger" })
                                        </div>
                                        <div class="col-md-3">
                                            @Html.LabelFor(model => model.Year)<span style="color:red">*</span>
                                            @Html.DropDownListFor(model => model.Year, (SelectList)ViewBag.sessionListAll, new { @class = "form-control" })
                                            @Html.ValidationMessageFor(model => model.Year, String.Empty, new { @class = "text-danger" })
                                        </div>


                                    </div>
                                </div>

                                                <div class="row">
                                                    <div class="form-group">

                                                        <div class="col-md-3">
                                                            @Html.LabelFor(model => model.Month)<span style="color:red">*</span>
                                                            @Html.DropDownListFor(model => model.Month, ViewBag.monthList as SelectList, new { @class = "form-control" })
                                                            @Html.ValidationMessageFor(model => model.Month, String.Empty, new { @class = "text-danger" })
                                                        </div>

                                                        <div class="col-md-3" id="calculateremainingleavehide">
                                                            <button class="btn btn-danger pulldown" name="calculateremainingleave" id="calculateremainingleave" type="button">Calculate Remaining Leave</button>

                                                        </div>

                                                        <div class="col-md-3">
                                                            @Html.LabelFor(model => model.RemainingLeave)<span style="color:red">*</span>
                                                            @Html.TextBoxFor(model => model.RemainingLeave, new { @class = "form-control" })
                                                            @Html.ValidationMessageFor(model => model.RemainingLeave, String.Empty, new { @class = "text-danger" })
                                                        </div>

                                                    </div>
                                                </div>

                                                <div class="row">
                                                    <div class="form-group">                                                       

                                                        <div class="col-md-3 nepalishow">
                                                            @Html.LabelFor(model => model.NepaliDateFrom)
                                                            @Html.TextBoxFor(model => model.NepaliDateFrom, new { @class = "form-control" })

                                                            @Html.ValidationMessageFor(model => model.NepaliDateFrom, String.Empty, new { @class = "text-danger" })
                                                        </div>
                                                        <div class="col-md-3 englishshow">
                                                            @Html.LabelFor(model => model.DateFrom)
                                                            @(Html.Kendo().DateTimePickerFor(m => m.DateFrom)
                                                            .Name("DateFrom")
                                                            .Value(DateTime.Now)
                                                            .Format("yyyy-MM-dd")
                                                            .HtmlAttributes(new { @class = "form-control" })
                                                            )
                                                            @Html.ValidationMessageFor(model => model.DateFrom, String.Empty, new { @class = "text-danger" })
                                                        </div>
                                                        <div class="col-md-3 nepalishow">
                                                            @Html.LabelFor(model => model.NepaliDateTo)
                                                            @Html.TextBoxFor(model => model.NepaliDateTo, new { @class = "form-control" })
                                                            @Html.ValidationMessageFor(model => model.NepaliDateTo, String.Empty, new { @class = "text-danger" })
                                                        </div>
                                                        <div class="col-md-3 englishshow">
                                                            @Html.LabelFor(model => model.DateTo)
                                                            @(Html.Kendo().DateTimePickerFor(m => m.DateTo)
                                                            .Name("DateTo")
                                                            .Value(DateTime.Now)
                                                            .Format("yyyy-MM-dd")
                                                            .HtmlAttributes(new { @class = "form-control" })
                                                            )
                                                            @Html.ValidationMessageFor(model => model.DateTo, String.Empty, new { @class = "text-danger" })
                                                        </div>

                                                        <div class="col-md-3">
                                                            @Html.LabelFor(model => model.LeaveDaysID)<span style="color:red">*</span>
                                                            @Html.DropDownListFor(model => model.LeaveDaysID, Enumerable.Empty<SelectListItem>(), "--Select--", new { @class = "form-control" })
                                                            @Html.ValidationMessageFor(model => model.LeaveDaysID, String.Empty, new { @class = "text-danger" })
                                                        </div>

                                                        <div class="col-md-3">
                                                            @Html.LabelFor(model => model.Days)<span style="color:red">*</span>
                                                            @Html.TextBoxFor(model => model.Days, new { @class = "form-control" })
                                                            @Html.ValidationMessageFor(model => model.Days, String.Empty, new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="row">                                                   
                                                        <div class="col-md-4"  style="margin-top:10px">
                                                            <input class="btn btn-danger" name="takeLeaveSubmit" id="takeLeaveSubmit" value="Save" type="submit" />
                                                            <button type="button" class="btn cancel" name="Cancel">Cancel</button>                                                        
                                                    </div>
                                                </div>

                            }
                        </div>
                    </div>
                </div>

            </div>

        </div>

    </div>
</div>
           

<div class="modal fade" id="customPopupDialog" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                @*<button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>*@
                <h4 class="modal-title " id="customPopupTitle">Approve Leave Taken</h4>
            </div>
            <div class="modal-body message">
                <div class="row">
                    <input type="text" id="ID" hidden />
                    <input type="text" id="employeeID" hidden />
                    <div class="col-lg-4">
                        <label>Status</label>
                        <select id="status" class="form-control">
                            <option value="0">Approve</option>
                            <option value="1">Reject</option>
                        </select>
                    </div>
                    <div class="col-lg-4">
                        <label>Notification Type</label>
                        <select id="notificationtype" class="form-control">
                            <option value="1">Bell Notification</option>
                            <option value="2">Pop Up Notification</option>
                            <option value="4">SMS Notification</option>
                            <option value="3">Email Notification</option>
                            <option value="5">Mobile Push Notification</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger ok">Approve</button>
                <button type="button" class="btn" data-dismiss="modal">Close</button>
            </div>

        </div>
        <!-- /.modal-content -->
    </div>
    <!-- /.modal-dialog -->
</div>

<div class="modal fade" id="customPopupDialogDescription" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                @*<button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>*@
                <h4 class="modal-title " id="customPopupTitle">Leave Description</h4>
            </div>


            <div class="modal-body message">
                <div class="row">
                    <div class="col-lg-4">
                        <label class="bold">Organisation:</label>
                        <label id="organisation"></label>
                    </div>
                    <div class="col-lg-4">
                        <label class="bold"><strong>Leave Type:</strong></label>
                        <label id="leavetype"></label>
                    </div>
                    <div class="col-lg-4">
                        <label class="bold">Requested By:</label>
                        <label id="requestedby"></label>
                    </div>

                </div>
                <hr />
                <div class="row">
                    <div class="col-lg-4">
                        <label class="bold">Year:</label>
                        <label id="year"></label>
                    </div>
                    <div class="col-lg-4">
                        <label class="bold">Month:</label>
                        <label id="month"></label>

                    </div>
                    <div class="col-lg-4">
                        <label class="bold">Status:</label>
                        <label id="statusid"></label>

                    </div>

                </div>
                <hr />
                <div class="row">
                    <div class="col-lg-4">
                        <label class="bold">Date From:</label>
                        <label id="datefrom"></label>
                    </div>
                    <div class="col-lg-4">
                        <label class="bold">Date To:</label>
                        <label id="dateto"></label>
                    </div>
                    <div class="col-lg-4">
                        <label class="bold">Days:</label>
                        <label id="days"></label>
                    </div>

                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn" data-dismiss="modal">Close</button>
            </div>

        </div>
        <!-- /.modal-content -->
    </div>
    <!-- /.modal-dialog -->
</div>


<div class="row" id="show">
    <div class="col-md-12">
        @Html.Partial("~/Areas/Admin/Views/TakeLeave/TakeLeaveList.cshtml")
    </div>
</div> 

