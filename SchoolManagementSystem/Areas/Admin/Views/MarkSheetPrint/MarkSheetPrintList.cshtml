


<div class="row" style="margin-top:10px">
    <div class="col-lg-12">
        <div class="pageHeaderBox11">

        </div>
    </div>
    <!-- /.col-lg-12 -->
</div>

@using Kendo.Mvc.UI
@(Html.Kendo().Grid<DomainEntities.MarkSheetPrint>()
    .Name("MarksSheetPrint")
            .Columns(columns =>
            {
                columns.Bound(c => c.SN).Title("S.N").Width(20);
                //columns.Bound(p => p.IsAdmin).ClientTemplate("<input type='checkbox' name='chkbx' class='chkbx' ></input>").Title("Check").Width(100);
                columns.Bound(c => c.IsCheck).ClientTemplate("<input type='checkbox' name='checkbox' class='checkbox' ></input>").Title("<input type='checkbox' class='chkSelectAll' onclick='checkAll(this)'>Check All</>").Width(20);

                columns.Bound(c => c.ClassID).Hidden();
                columns.Bound(c => c.StudentID).Hidden();
                columns.Bound(c => c.TermID).Hidden();
                columns.Bound(c => c.SessionID).Hidden();
                columns.Bound(c => c.Section).Hidden();
                columns.Bound(c => c.StudentName).Title("Student Name").Width(250);
                columns.Bound(c => c.Session).Title("Session").Width(150);
                columns.Bound(c => c.Faculty).Title("Session").Width(150);
                columns.Bound(c => c.Class).Title("Class").Width(150);
                columns.Bound(c => c.Section).Title("Section").Width(150);
                columns.Bound(c => c.RollNo).Title("Roll No").Width(150);

                //columns.Bound(c => c.Type).Title("Modified On").Width(50).ClientTemplate("#= customDate(data) #").Format(ViewBag.settingDateFormat);


            })




                    //.Editable(editable => editable.Mode(GridEditMode.InCell))
                    //.Filterable()
                    //.Sortable(sortable => sortable
                    // .AllowUnsort(true)
                    // .SortMode(GridSortMode.MultipleColumn))
                    .Pageable(
              page => page.Refresh(true)
             .PageSizes(new int[] { 100 })
              .PreviousNext(true))
            //   .PersistSelection(true)
            .Reorderable(reorder => reorder.Columns(true))

     .Navigatable()
                    .DataSource(dataSource => dataSource
                        .Ajax()

                        .ServerOperation(false)
                                .Model(model =>
                                {
                                    model.Id(p => p.SN);
                                    model.Field(p => p.SN).Editable(false);
                                    model.Field(p => p.StudentName).Editable(false);

                                })
                  .Read(read => read.Action("GetAll", "MarkSheetPrint").Data("ParamToMarksList"))// Action invoked when the user saves a new data item
                  .Events(e => e.Error("onError"))
                  .PageSize(100)

             )

.Events(ev => ev.DataBound("resetRowNumberMarksSheetGrid"))




)








