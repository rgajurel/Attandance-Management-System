
@using Kendo.Mvc.UI
@(Html.Kendo().Grid<DomainEntities.MarksEntry>()
    .Name("MarksEntryGrid")
            .Columns(columns =>
            {
            columns.Bound(c => c.SN).Title("S.N").Width(20);
            //columns.Bound(p => p.IsAdmin).ClientTemplate("<input type='checkbox' name='chkbx' class='chkbx' ></input>").Title("Check").Width(100);
            columns.Template(@<text></text>).ClientTemplate("<input type='checkbox' #= IsAdmin ? checked='checked':'' # class='chkbx' />").Title("Check").Width(40);

                columns.Bound(c => c.ClassID).Hidden();
                columns.Bound(c => c.ID).Hidden();
                columns.Bound(c => c.SubjectID).Hidden();
                columns.Bound(c => c.TermID).Hidden();
                columns.Bound(c => c.SessionID).Hidden();
                columns.Bound(c => c.Section).Hidden();
                columns.Bound(c => c.StudentName).Title("Student Name").Width(150);
                columns.Bound(c => c.FullMarksTheory).Title("Full(T)").Width(20);
                columns.Bound(c => c.PassMarksTheory).Title("Pass(T)").Width(20);
                columns.Bound(c => c.CreditPoint).Title("Credit").Width(20);
                columns.Bound(c => c.FullMarksPractical).Title("Full(P)").Width(20);
                columns.Bound(c => c.PassMarksPractical).Title("Pass(P)").Width(20);
                columns.Bound(c => c.ObtainedMarksTheory).Title("Obtained(T)").Width(20);
                columns.Bound(c => c.ObtainedMarksPractical).Title("Obtained(P)").Width(20);
                columns.Bound(c => c.ObtainedGradeTheory).Title("Grade(T)").Width(20);
                columns.Bound(c => c.ObtaindedGradePractical).Title("Grade(P)").Width(20);
                columns.Bound(c => c.FinalGrade).Title("Final Grade").Width(20);
                columns.Bound(c => c.GradePoint).Title("Grade Point").Width(20);
                //columns.Command(command =>
                //{
                //    command.Custom("Delete").Text(" ").Click("Delete");

                //}).Width(50).Title("Action");
                //columns.Bound(c => c.Type).Title("Modified On").Width(50).ClientTemplate("#= customDate(data) #").Format(ViewBag.settingDateFormat);


            })


            @*.ToolBar(toolbar =>
                             {
                             toolbar.Template(@<text>


                <div class="right-inner-addon" style="width:200px">

                    <input type="search"
                           class="form-control"
                           placeholder="Search By Name" id="FieldFilter" />

                </div>
                            </text>);
                             })*@
 //.Scrollable())
 //  .Selectable()
 .Navigatable()
 .Editable(editable => editable.Mode(GridEditMode.InCell))

                    .Sortable(sortable => sortable
                    .AllowUnsort(true)
                     .SortMode(GridSortMode.MultipleColumn))
                    .Pageable(
              page => page.Refresh(true)
             .PageSizes(new int[] { 100 })
              .PreviousNext(true))

            .Reorderable(reorder => reorder.Columns(true))


                    .DataSource(dataSource => dataSource
                        .Ajax()

                        .ServerOperation(false)
                                .Model(model =>
                                {
                                    model.Id(p => p.ID);
                                    model.Field(p => p.StudentName).Editable(false);
                                    model.Field(p => p.FullMarksTheory).Editable(false);
                                    model.Field(p => p.FullMarksPractical).Editable(false);
                                    model.Field(p => p.PassMarksTheory).Editable(false);
                                    model.Field(p => p.PassMarksPractical).Editable(false);
                                    model.Field(p => p.CreditPoint).Editable(false);
                                    model.Field("ObtainedMarksTheory", typeof(decimal)).Editable(true);
                                    model.Field("ObtainedMarksPractical", typeof(decimal)).Editable(true);
                                    model.Field(p => p.ObtainedGradeTheory).Editable(true);
                                    model.Field(p => p.ObtaindedGradePractical).Editable(true);
                                    model.Field(p => p.FinalGrade).Editable(true);
                                    model.Field(p => p.GradePoint).Editable(true);
                                })
                  .Read(read => read.Action("GetAll", "MarksEntry").Data("ParamToMarksList"))// Action invoked when the user saves a new data item
                    .Events(e => e.Error("onError"))
                  .PageSize(100)

             )

.Events(ev => ev.DataBound("resetRowNumberMarksEntryGrid"))

//.Events(ev=>ev.Save("Save"))


)








