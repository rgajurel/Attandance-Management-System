        <div class="col-sm-8">
            <div class="pulldown">
                <button  class="btn btn-danger" id="addTotalDays">Add Total Days </button>
                <button  class="btn" id="marksSaveRecords">Save Records</button>
            </div>

        </div>

    </div>
