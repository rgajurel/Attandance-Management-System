@{
    ViewBag.Title = "Quiz Question";
    Layout = "~/Views/Shared/AdminLayout.cshtml";

}
@model DomainEntities.QuizEntity
<div id="divQuizQuestionList">
    <div class="row">
        <div class="col-lg-12">
            <div class="pageHeaderBox11">
                <h1 class="page-header">Quiz Question</h1>
                <div class="pull-right">
                    @*@if (ViewBag.createAccess == true)
                        {*@
                    <button type="submit" class="btn btn-default btnCustom" id="btnCreateQuizQuestion">Create Quiz Question</button>
                    @*}*@
                </div>
            </div>
        </div>
        <!-- /.col-lg-12 -->
    </div>
    <div class="row">

        <div class="form-group">

            <div class="col-md-2">
                <label>Question</label>
                <input class="form-control" id="txtSearchKeyword" placeholder="Enter Search Keywords">
            </div>
            <div class="col-md-2">
                <label>Status</label>
                @Html.DropDownList("ddlSearchStatus", new SelectList(new List<SelectListItem> {
                 new SelectListItem { Text = "Active", Value = "Active" },
                 new SelectListItem { Text = "InActive", Value = "Inactive" }
}, "Value", "Text"), " All Status", new { @class = "form-control" })
            </div>
            <div class="col-md-2">
                <label>Question Type</label>
                @Html.DropDownList("ddlSearchQuestionType", Enumerable.Empty<SelectListItem>(), " All Question Type", new { @class = "form-control" })
            </div>
            <div class="col-md-2">
                <label>Difficulty</label>
                @Html.DropDownList("ddlSearchDifficultyLevel", Enumerable.Empty<SelectListItem>(), " All Difficulty Level", new { @class = "form-control" })
            </div>
            <div class="col-md-2">
                <label>Weightage</label>
                @Html.DropDownList("ddlSearchWeightage", Enumerable.Empty<SelectListItem>(), " All Weightage", new { @class = "form-control" })
            </div>
            <div class="col-md-2">
                <label>Mandatory</label>
                <select id="ddlSearchMandatory" class="form-control">
                    <option value="-1">All Question</option>
                    <option value="1">Mandatory</option>
                    <option value="0">Optional</option>
                </select>
            </div>

            <div class="col-md-2">
                <button type="submit" class="btn btn-default btnCustom" id="btnSearchQuizQuestion">Search</button>
                <button type="reset" class="btn btn-default btnCancle ResetInputField" id="btnResetQuizQuestion">Reset</button>
            </div>



        </div>
        <!-- /.col-lg-4 -->
    </div>
    <div class="changeStatusOption hide">
        <div class="col-lg-3">
            <label>Status</label>
            @Html.DropDownList("ddlChangeQuizStatus", new SelectList(new List<SelectListItem> {
                 new SelectListItem { Text = "Active", Value = "Active" },
                 new SelectListItem { Text = "InActive", Value = "Inactive" }
}, "Value", "Text"), new { @class = "form-control" })

        </div>
        <div class="col-lg-3 mg-tb">
            <button type="submit" class="btn btn-default btnCustom" id="btnSaveStatusForSelectedQuizQuestion">Save</button>
        </div>
    </div>
    <div class="row clearfix">
        <div class="col-lg-12">
            <div class="table-responsive-scroll">@Html.Partial("~/Areas/Admin/Views/QuizQuestion/QuizQuestion.cshtml")</div>
        </div>
    </div>
</div>

<div class="row popup hide" id="divQuizQuestionForm">
    <div class="col-lg-12">
        <div class="panel panel-default">
            <div class="panel-heading" id="formHeading">
                Add Quiz Question
            </div>
            <!-- /.panel-heading -->
            <div class="row panel-body">
                <!-- Nav tabs -->

                @using (Html.BeginForm("", "", FormMethod.Post, new { enctype = "multipart/form-data", id = "formQuizQuestion", name = "formQuizQuestion" }))
                {

                    @Html.AntiForgeryToken()
                    <input type="hidden" id="hfID" value="-1" />
                    <div class="col-lg-6 col-md-6">
                        <div class="form-group mdl-selectfield">
                            @Html.Label("lblQuestionType", "Question Type")<span class="txtRed"> *</span>
                            @Html.DropDownList("ddlQuestionType", Enumerable.Empty<SelectListItem>(), new { @class = "form-control" })
                        </div>


                    </div>
                    <div class="col-lg-6 col-md-6">
                        <div class="form-group">
                            @Html.Label("lblQuestion", "Question")<span class="txtRed"> *</span>
                            @Html.TextArea("txtQuizQuestion", null, new { @class = "form-control" })
                        </div>
                    </div>
                    <div class="col-lg-12 clearfix">

                        <div class="form-group">
                            <div class="checkbox">
                                <label>
                                    <input type="checkbox" id="chkMandatoryQuestion" /><strong>Mandatory</strong>
                                </label>
                            </div>
                        </div>

                        <div class="dynamicFormContainer">
                            <div class="form-group" id="divAnswerLabelContainer">
                                <label>Answer<span class="txtRed"> *</span></label>
                                <div class="btnCOntainer pull-right">
                                    <button class="AddMoreDynamic btn btn-default btn-xs btnCustom">Add</button>
                                </div>
                            </div>
                            <div class="quiz-answer">
                                <div class="row divSubClassHolder">
                                    <div class="col-lg-6 col-md-6">
                                        <div class="form-group">
                                            @Html.Hidden("hfAnswerPoolID", "-1", new { @class = "hfAnswerPoolID" })
                                            <input type="text" class="form-control clsNotTrueFalse" name="DynamictxtAnswer" />
                                            <select class="form-control clsTrueFalse" style="display:none" name="DynamicddlAnswer"><option value="true" selected="selected">True</option><option value="false">False</option></select>
                                        </div>
                                    </div>
                                    <div class="col-lg-4 col-md-4">
                                        <div class="form-group">
                                            <select class="form-control clsAnswerStatus"><option value="true">Correct</option><option value="false">Incorrect</option></select>
                                        </div>
                                    </div>
                                    <div class="col-lg-2 col-md-2 but-cancel">
                                        <button class="RemoveDynamicContent" style="display:none"><i class="fa fa-times-circle-o" aria-hidden="true"></i></button>
                                    </div>
                                </div>
                            </div>

                        </div>
                        <hr>
                    </div>

                    <div class="col-lg-6 col-md-6">
                        <div class="form-group mdl-selectfield">
                            @Html.Label("lblQuestionDifficulty", "Difficulty")<span class="txtRed"> *</span>
                            @Html.DropDownList("ddlQuestionDifficulty", Enumerable.Empty<SelectListItem>(), new { @class = "form-control" })
                        </div>
                        <div class="form-group">
                            @Html.Label("lblPointsToAnswer", "Score per answer")<span class="txtRed"> *</span>
                            @Html.TextBox("txtPointsForEachAnswer", null, new { @class = "form-control" })
                        </div>
                        @*<div class="form-group">
                                @Html.Label("lblSortOrder", "Sort Order")
                                @Html.TextBox("txtSortOrder", null, new { @class = "form-control" })
                            </div>*@
                        <div class="form-group mdl-selectfield">
                            @Html.Label("lblQuestionStatus", "Status")<span class="txtRed"> *</span>
                            @Html.DropDownList("ddlStatus", new SelectList(new List<SelectListItem> {
                 new SelectListItem { Text = "Active", Value = "Active" },
                 new SelectListItem { Text = "InActive", Value = "Inactive" }
}, "Value", "Text"), new { @class = "form-control" })
                        </div>
                    </div>

                    <div class="col-lg-6 col-md-6">
                        <form role="form">
                            <div class="form-group mdl-selectfield">
                                @Html.Label("lblQuestionWeightage", "Weightage")<span class="txtRed"> *</span>
                                @Html.DropDownList("ddlQuestionWeightage", Enumerable.Empty<SelectListItem>(), new { @class = "form-control" })
                            </div>

                            <div class="form-group">
                                @Html.Label("lblNoOfAnswer", "No of Answer")<span class="txtRed"> *</span>
                                @Html.TextBox("txtNoOfAnswer", "", new { @class = "form-control", @readonly = "readonly" })
                            </div>
                            <div class="form-group">
                                @Html.Label("lblQuestionCompletionTime", "Completion Time(In Minutes)")<span class="txtRed"> *</span>
                                @Html.TextBox("txtQuestionCompletionTime", null, new { @class = "form-control" })
                            </div>

                        </form>
                    </div>
                    <div class="col-lg-12 clearfix">
                        <button type="submit" class="btn btn-default btnCustom" value="Create" id="btnSave">Submit</button>
                        <button type="reset" class="btn btn-default btnCancle" id="btnCancel">Cancel</button>
                    </div>
                }
            </div>
        </div>
        <!-- /.panel -->
    </div>
    <!-- /.col-lg-6 -->
</div>

<div class="modal fade" id="QuestionBatchUpdateModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
    <div class="modal-dialog" role="document">
        <div class="modal-content modal-dashboard">
            <div class="modal-header">
                <p>Are you sure?</p>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-lg-12 listing">
                        <label>Quiz</label>
                        <ol class="UpdateStatusListingBody">
                            <li>
                                <span>The Quiz Name (eg Sandeep) is unfinished.</span>
                            </li>
                        </ol>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal" id="btnCancelUpdate">No</button>
                <button type="button" class="btn btn-primary" data-dismiss="modal" id="btnConfirmUpdate">Yes</button>
            </div>
        </div>
    </div>
</div>

@*@section JS{*@
<script src="~/Content/JS/BackEnd/QuizQuestion.js"></script>
<script src="~/Scripts/jquery.validate.min.js"></script>
<script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>
<script src="~/Scripts/jquery.unobtrusive-ajax.min.js"></script>
<script src="~/Scripts/additional-methods.js"></script>
<script>
    var CustomDateFormat = '@ViewBag.settingDateFormat';
</script>
@*}*@