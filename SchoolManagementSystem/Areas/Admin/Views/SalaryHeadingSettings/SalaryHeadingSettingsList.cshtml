




@using Kendo.Mvc.UI
@(Html.Kendo().Grid<DomainEntities.SalaryHeadingSettings>()
    .Name("SalaryHeadingSettingsGrid")
            .Columns(columns =>
            {

                // columns.Template(t => { }).Title("Row No").ClientTemplate("#= renderNumber(data) #").Hidden();
                //columns.Template(t => { }).Title("S.N").ClientTemplate("#= renderRecordNumber(data) #").Width(50);



                columns.Bound(c => c.HeadName).Title(" Head Name").Width(100);
                columns.Bound(c => c.JobTypeID).Hidden();
                //columns.Bound(c => c.IsAdd).Title("Is Add").Width(20);
                columns.Bound(c => c.IsSaving).Title("Is Saving").Width(20);
                columns.Bound(c => c.IsTax).Title("Is Tax").Width(20);
                columns.Bound(c => c.IsSalaryCalculatePoint).Title("Is Sal Point").Width(20);
                columns.Bound(c => c.SortOrder).Title("Sort Order").Width(20);

                columns.Command(command =>
                {
                    command.Custom("Delete").Text(" ").Click("Delete");

                }).Width(50).Title("Action");



                //columns.Bound(c => c.Type).Title("Modified On").Width(50).ClientTemplate("#= customDate(data) #").Format(ViewBag.settingDateFormat);


            })
         .ToolBar(toolBar =>
         {
             toolBar.Create();

         })

                   .Editable(editable => editable.Mode(GridEditMode.InCell))


                    //.Filterable()
                    //.Sortable(sortable => sortable
                    // .AllowUnsort(true)
                    // .SortMode(GridSortMode.MultipleColumn))
                    .Pageable(
              page => page.Refresh(true)
             .PageSizes(new int[] { 10, 20, 40, 60, 80, 100 })
              .PreviousNext(true))

            .Reorderable(reorder => reorder.Columns(true))
             .Navigatable()
                    .DataSource(dataSource => dataSource
                        .Ajax()
                        .ServerOperation(false)
                                .Model(model =>
                                {
                                    model.Id(p => p.SN);
                                    model.Field(p => p.SN).Editable(false);
                                    model.Field(p => p.HeadName).Editable(true);
                                    model.Field(p => p.IsTax).Editable(true);
                                    model.Field(p => p.IsSaving).Editable(true);
                                    model.Field(p => p.IsAdd).Editable(true);
                                    model.Field(p => p.IsSalaryCalculatePoint).Editable(true);
                                    model.Field("SortOrder", typeof(int)).Editable(true);

                                })
                   .Read(read => read.Action("GetAll", "SalaryHeadingSettings").Data("ParamToSettingsHeadList"))// Action invoked when the user saves a new data item
                  .PageSize(20)
             )
.Events(ev => ev.DataBound("resetRowNumber"))

)








