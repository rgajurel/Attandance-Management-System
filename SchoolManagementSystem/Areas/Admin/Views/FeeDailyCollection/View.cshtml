@model DomainEntities.FeeDailyCollection
<link href="~/Content/vendor/multiselectdropdown/css/dropdownliststyle.css" rel="stylesheet" type="text/css" />
<script src="~/Scripts/jquery.validate.min.js"></script>
<script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>
<script src="~/Content/JS/BackEnd/FeeDailyCollection.js"></script>
@{

        <script>
            window.onload = function () {
                ShowMessage("@TempData["success"]");
            };
        </script>

}
        
    
<div style="" id="studentsForm">
    <div class="page-header col-lg-12">
        <div class="breadcrumb-line">
            <ul class="breadcrumb">
                <li>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<i class="fa fa-home position-left"></i>Home</li>
                <li>Report</li>
                <li class="active">Daily Collection</li>
            </ul>
        </div>
    </div>
    <br />
    <div class="content" style="margin-top:35px">
        <div class="row">
            <div class="col-sm-12">
                <div class="panel panel-default">
                    <div class="panel-heading">
                        <h4 class="panel-title">Daily Collection Report</h4>
                    </div>
                    <div class="panel-body">
                        <div class="row">
                            @using (Html.BeginForm("ExportData", "FeeDailyCollection", FormMethod.Post, new { enctype = "multipart/form-data", id = "formDailyCollection", name = "formDailyCollection", onSubmit = "return validateDate();" }))
                            {
                                @Html.AntiForgeryToken()
                                <div class="form-group col-sm-2 success">
                                    @Html.LabelFor(model => model.DateFrom)<span style="color:red">*</span>
                                    @Html.TextBoxFor(model => model.DateFrom, new { @class = "form-control", required = "required", @type = "date" })
                                    @Html.ValidationMessageFor(model => model.DateFrom, String.Empty, new { @class = "text-danger" })
                                </div>
                                <div class="form-group col-sm-2 success">
                                    @Html.LabelFor(model => model.DateTo)<span style="color:red">*</span>
                                    @Html.TextBoxFor(model => model.DateTo, new { @class = "form-control", required = "required", @type = "date" })
                                    @Html.ValidationMessageFor(model => model.DateTo, String.Empty, new { @class = "text-danger" })
                                </div>
                                <div class="form-group col-sm-1 success">
                                    @Html.LabelFor(model => model.Overall)<span style="color:red">*</span>
                                    @Html.CheckBoxFor(model => model.Overall, new { @class = "form-control", @checked = "checked" })
                                </div>

                                <div id="session" class="form-group col-sm-2 success">
                                    @Html.LabelFor(model => model.Session)<span style="color:red">*</span>
                                    @Html.DropDownListFor(model => model.Session, (SelectList)ViewBag.sessionList, new { @class = "form-control", required = "required" })
                                    @Html.ValidationMessageFor(model => model.Session, String.Empty, new { @class = "text-danger" })
                                </div>
                                <div id="faculty" class="form-group col-sm-2 success">
                                    @Html.LabelFor(model => model.Faculty)<span style="color:red">*</span>
                                    @Html.DropDownListFor(model => model.Faculty, (SelectList)ViewBag.facultyList, new { @class = "form-control", required = "required" })
                                    @Html.ValidationMessageFor(model => model.Faculty, String.Empty, new { @class = "text-danger" })
                                </div>
                                <div id="class" class="form-group col-sm-2 success">
                                    @Html.LabelFor(model => model.Class)<span style="color:red">*</span>
                                    @Html.DropDownListFor(model => model.Class, Enumerable.Empty<SelectListItem>(), "Select", new { @class = "form-control", required = "required" })
                                    @Html.ValidationMessageFor(model => model.Class, String.Empty, new { @class = "text-danger" })
                                </div>
                                <div id="section" class="form-group col-sm-2 success">
                                    @Html.LabelFor(model => model.Section)<span style="color:red">*</span>
                                    @Html.DropDownListFor(model => model.Section, Enumerable.Empty<SelectListItem>(), new { @class = "form-control", required = "required" })
                                    @Html.ValidationMessageFor(model => model.Section, String.Empty, new { @class = "text-danger" })
                                </div>
                                <div class="col-sm-2 form-group">
                                    <input type="submit" style="margin-top:23px" class="btn btn-info" value="View Report" />
                                </div>
                            }
                        </div>

                    </div>
                </div>
            </div>
        </div>
        <hr />

    </div>
</div>
