


@model DomainEntities.TermMaster

<script src="~/Scripts/jquery.validate.min.js"></script>
<script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>

<script src="~/Content/JS/BackEnd/TermMaster.js"></script>

<div class="row">
    <div class="col-md-12">
        <ol class="breadcrumb">
            <li><i class="fa fa-home"></i><a href="/Admin/SchoolInformation">Exam</a></li>
            <li><a href="/Admin/OrganisationType">Term Master</a></li>
            <li class="pull-right"><button class="btn btn-danger create" type="submit">Create New</button></li>
        </ol>
    </div>
</div>


<div style="display:none" id="hide">
    <div class="content">
        <div class="row">
            <div class="col-sm-12">
                <div class="panel panel-default">
                    <div class="panel-heading">
                        <h4 class="panel-title">Term Master</h4>
                    </div>
                    <div class="panel-body">
                        <div class="col-sm-12">
  @using (Html.BeginForm("", "", FormMethod.Post, new { enctype = "multipart/form-data", id = "formTermMaster", autocomplete = "off", name = "formTermMaster", onSubmit = "return false;" }))
  

      {
                                @Html.AntiForgeryToken()
                                <div class="row">

                                    <div class="col-md-3">
                                        @Html.HiddenFor(model => model.ID)
                                        @Html.LabelFor(model => model.TermName)<span style="color:red">*</span>
                                        @Html.TextBoxFor(model => model.TermName, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(model => model.TermName, String.Empty, new { @class = "text-danger" })
                                    </div>
                                    <div class="col-md-3">
                                        @Html.LabelFor(model => model.TermPercentage)<span style="color:red">*</span>
                                        @Html.TextBoxFor(model => model.TermPercentage, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(model => model.TermPercentage, String.Empty, new { @class = "text-danger" })
                                    </div>
                                    <div class="col-md-2">
                                        <label style="margin-top:28px">Is Final Term</label><span style="color:red">*</span>
                                        @Html.CheckBoxFor(model => model.IsFinalTerm)
                                    </div>
                                    <div class="col-md-3">
                                        <div class="pulldown">
                                            <input class="btn btn-danger" name="Save" id="Save" value="Save" type="submit">
                                            <button type="button" class="btn cancel" name="Cancel">Cancel</button>
                                        </div>
                                    </div>
                                </div>

                              


                            }

                        </div>

                    </div>

                </div>
            </div>

        </div>

    </div>
</div>


 






<div class="row" id="show">
    <div class="col-md-12">
       @Html.Partial("~/Areas/Admin/Views/TermMasterDynamic/TermMasterDynamicList.cshtml")
    </div>
</div>  








