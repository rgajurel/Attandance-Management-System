<style>
    .content-wrapper {
        margin: 10px 0 20px 0;
        box-shadow: 0 1px 13px rgba(0,0,0,0.3);
    }

    .report-details {
        background-color: #fff;
        border: 1px solid transparent;
        border-radius: 4px;
        -webkit-box-shadow: 0 1px 1px rgba(0,0,0,.05);
        box-shadow: 0 1px 1px rgba(0,0,0,.05);
        background: #f0f0f0;
    }

    .detail-contain p {
        color: #c9064c;
    }

    .detail-contain label {
        color: #696464;
    }

    .report-group {
        background: #fff;
        padding: 20px;
    }
    /*.report-group div {
        padding: 0px;
    }*/
    tr.score-point {
        background: #ddefd7;
    }

    .success {
        background: #f1fff1;
        border: 1px solid green;
        padding: 10px;
        margin-bottom: 15px;
    }

    form h4 span.success {
        padding: 3px;
        float: right;
        font-size: 12px;
    }

    .error-msg {
        background: #f5d4d4;
        border: 1px solid red;
        padding: 10px;
        margin-bottom: 15px;
    }

        .error-msg label i {
            color: red;
        }

        .error-msg p {
            margin: 0px;
        }
</style>