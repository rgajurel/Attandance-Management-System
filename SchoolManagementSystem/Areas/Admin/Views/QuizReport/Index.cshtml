            </div>
            <div class="col-md-2">
                <label>All Status</label>
                @Html.DropDownList("ddlSearchStatus", new SelectList(new List<SelectListItem> {
                 new SelectListItem { Text = "Active", Value = "1" },
                 new SelectListItem { Text = "InActive", Value = "0" }
}, "Value", "Text"), " All Status", new { @class = "form-control" })
            </div>
            <div class="col-md-2">
                <label>Started From</label>
                @(Html.Kendo().DatePicker().Name("txtSearchQuizStartedFrom").Format(ViewBag.settingDateFormat).HtmlAttributes(new { @class = "datepicker datepicker-readonly", @type = "text", @placeholder = "Started Date From" }))
            </div>
            <div class="col-md-2">
                <label>Started To</label>
                @(Html.Kendo().DatePicker().Name("txtSearchQuizStartedTo").Format(ViewBag.settingDateFormat).HtmlAttributes(new { @class = "datepicker datepicker-readonly", @type = "text", @placeholder = "Started Date To" }))
