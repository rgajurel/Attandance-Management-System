
@model DomainEntities.Language
<script src="~/Scripts/jquery.validate.min.js"></script>
<script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>
<script src="~/Content/JS/BackEnd/Language.js"></script>
<div class="row">
    <div class="col-md-12">
        <ol class="breadcrumb">
            <li><i class="fa fa-home"></i><a href="/Admin/SchoolInformation">Settings</a></li>
            <li><a href="/Admin/Language">Language</a></li>
            <li class="pull-right"><button class="btn btn-danger create" type="submit">Create New</button></li>
        </ol>
    </div>
</div>   



<div style="display:none" id="hide">
    <div class="content">
        <div class="row">
            <div class="col-sm-12">
                <div class="panel panel-default">
                    <div class="panel-heading">
                        <h4 class="panel-title">Language</h4>
                    </div>
                    <div class="panel-body">
                        <div class="col-lg-12">
                           @using (Html.BeginForm("", "", FormMethod.Post, new { enctype = "multipart/form-data", id = "formLanguage",autocomplete="off", name = "formDepartment", onSubmit = "return false;" }))
                           {
                                @Html.AntiForgeryToken()
                                <div class="row">
                                    <div class="col-md-3">
                                        @Html.HiddenFor(model => model.ID)
                                        @Html.LabelFor(model => model.Name)<span style="color:red">*</span>
                                        @Html.TextBoxFor(model => model.Name, new { @class = "form-control"})
                                        @Html.ValidationMessageFor(model => model.Name, String.Empty, new { @class = "text-danger" })
                                    </div>
                                    <div class="col-md-3">
                                        @Html.LabelFor(model => model.Code)<span style="color:red">*</span>
                                        @Html.TextBoxFor(model => model.Code, new { @class = "form-control"})
                                        @Html.ValidationMessageFor(model => model.Code, String.Empty, new { @class = "text-danger" })
                                    </div>
                                    <div class="col-md-3">

                                        @Html.LabelFor(model => model.Status)<span style="color:red">*</span>
                                        @Html.DropDownListFor(model => model.Status,
                                        new SelectList(new List<SelectListItem>
                                            {
                                            new SelectListItem { Text = "Active", Value = "1" },
                                            new SelectListItem { Text = "InActive", Value = "0" }
                                            }, "Value", "Text"), new { @class = "form-control" })
                                            @Html.ValidationMessageFor(model => model.Status, String.Empty, new { @class = "text-danger" })
                                    </div>

                                    <div class="col-sm-3">
                                        <label>Attach File</label>
                                        @Html.TextBoxFor(model => model.ImageFile, null, new { type = "file", @class = "input-file" })
                                        @Html.ValidationMessageFor(model => model.ImageFile, String.Empty, new { @class = "text-danger" })

                                    </div>
                                    
                                </div>
                            <div class="row">
                                <div class="col-md-4" style="margin-top:10px">                                   
                                        <input class="btn btn-danger" name="Save" id="Save" value="Save" type="submit">
                                        <button type="button" class="btn cancel" name="Cancel">Cancel</button>

                                    
                                </div>
                            </div>
                            }
                        </div>

                    </div>

                </div>
            </div>

        </div>

    </div>
</div> 
     

<div class="row" id="show">
    <div class="col-md-12">
       @Html.Partial("~/Areas/Admin/Views/Language/LanguageList.cshtml")
    </div>
</div>  