

<script src="~/Scripts/jquery.validate.min.js"></script>
<script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>
<script src="~/Content/JS/BackEnd/SavingsReport.js"></script>
<script src="~/Scripts/jQuery.print.js"></script>

@model DomainEntities.SavingsReport
@using (Html.BeginForm("", "", FormMethod.Post, new { enctype = "multipart/form-data", autocomplete = "off", id = "formSavingsReport", name = "formSavingsReport", onSubmit = "return false;" }))
{
    <div class="x_panel">
        <div class="col-md-3">
          
            @Html.LabelFor(model => model.OrganisationID)<span style="color:red">*</span>
            @Html.DropDownListFor(model => model.OrganisationID, Enumerable.Empty<SelectListItem>(), "--Organisation--", new { @class = "form-control", required = "required" })
            @Html.ValidationMessageFor(model => model.OrganisationID, String.Empty, new { @class = "text-danger" })
        </div>
        <div class="col-md-3">
            @Html.LabelFor(model => model.EmployeeID)<span style="color:red">*</span>
            @Html.DropDownListFor(model => model.EmployeeID, Enumerable.Empty<SelectListItem>(), "--Select--", new { @class = "form-control" })
            @Html.ValidationMessageFor(model => model.EmployeeID, String.Empty, new { @class = "text-danger" })
        </div>
        <div class="col-md-3">
            @Html.LabelFor(model => model.SavingsTypeID)<span style="color:red">*</span>
            @Html.DropDownListFor(model => model.SavingsTypeID, (SelectList)ViewBag.allSavingType, "--Select--", new { @class = "form-control", required = "required" })
            @Html.ValidationMessageFor(model => model.SavingsTypeID, String.Empty, new { @class = "text-danger" })
        </div>


        <div class="col-md-3">
            <button style="margin-top:26px" class="btn btn-danger" id="savingsReport">Generate</button>
        </div>
    </div>

}

<div id="savingsResults">

</div>

