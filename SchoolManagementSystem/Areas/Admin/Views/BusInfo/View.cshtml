

@model DomainEntities.BusInfo
<script src="~/Scripts/jquery.validate.min.js"></script>
<script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>
<script src="~/Content/JS/BackEnd/BusInfo.js"></script>
<div class="page-header">
    <div class="breadcrumb-line">
        <ul class="breadcrumb">
            <li>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<i class="fa fa-home position-left"></i>Home</li>
            <li>Organisation</li>
            <li class="active">Bus Details</li>
        </ul>
    </div>
</div>
<div class="row">
    <div class="content">
        <h6 class="content-group text-semibold"></h6>
        <div class="row">
            <div class="col-md-12">
                <div class="panel panel-flat">
                    <div class="panel-heading">                       
                        <div class="panel-body">
                            <div class="row">
                                <div class="col-lg-12">
                                    <div class="panel panel-flat">                                       
                                        <div class="panel-body">
                                            @using (Html.BeginForm("", "", FormMethod.Post, new { enctype = "multipart/form-data", id = "formBusInfo", name = "formBusInfo", onSubmit = "return false;" }))
                                            {
                                                @Html.AntiForgeryToken()
                                                <div class="form-group">
                                                    <div class="row">
                                                        <div class="col-md-4">
                                                            @Html.HiddenFor(model => model.ID)
                                                            @Html.LabelFor(model => model.BusNo)<span style="color:red">*</span>
                                                            @Html.TextBoxFor(model => model.BusNo, new { @class = "form-control" })
                                                            @Html.ValidationMessageFor(model => model.BusNo, String.Empty, new { @class = "text-danger" })
                                                        </div>
                                                        <div class="col-md-4">

                                                            @Html.LabelFor(model => model.DriverName)<span style="color:red">*</span>
                                                            @Html.TextBoxFor(model => model.DriverName, new { @class = "form-control" })
                                                            @Html.ValidationMessageFor(model => model.DriverName, String.Empty, new { @class = "text-danger" })
                                                        </div>
                                                        <div class="col-md-4">
                                                            @Html.LabelFor(model => model.DriverPhoneNo)<span style="color:red">*</span>
                                                            @Html.TextBoxFor(model => model.DriverPhoneNo, new { @class = "form-control" })
                                                            @Html.ValidationMessageFor(model => model.DriverPhoneNo, String.Empty, new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="form-group">
                                                    <div class="row">                                                       
                                                        <div class="col-md-4">
                                                            @Html.LabelFor(model => model.SupporterName)
                                                            @Html.TextBoxFor(model => model.SupporterName, new { @class = "form-control" })
                                                            @Html.ValidationMessageFor(model => model.SupporterName, String.Empty, new { @class = "text-danger" })
                                                        </div>
                                                        <div class="col-md-4">
                                                            @Html.LabelFor(model => model.SupporterPhoneNo)
                                                            @Html.TextBoxFor(model => model.SupporterPhoneNo, new { @class = "form-control" })
                                                            @Html.ValidationMessageFor(model => model.SupporterPhoneNo, String.Empty, new { @class = "text-danger" })
                                                        </div>

                                                        <div class="col-md-4" style="margin-top:23px">
                                                            <input class="btn btn-info" name="busInfoSubmit" id="busInfoSubmit" value="Save" type="submit" />
                                                            <input class="btn" name="busInfoCancel" id="busInfoCancel" value="Cancel" type="reset">
                                                        </div>
                                                    </div>
                                                </div>

                                              
                                            }
                                        </div>
                                    </div>
                                </div>
                               
                            </div>
                            <a class="heading-elements-toggle"><i class="icon-menu"></i></a>
                        </div>
                        <a class="heading-elements-toggle"><i class="icon-menu"></i></a>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-12">
        <div class="form-group">
            <div id="schoolTypeList">@Html.Partial("~/Areas/Admin/Views/BusInfo/BusInfoList.cshtml")</div>
        </div>
    </div>
</div>