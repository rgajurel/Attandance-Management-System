
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/AdminLayout.cshtml";
}

@model DomainEntities.StudentsAssignments

<script src="~/Scripts/jquery.validate.min.js"></script>
<script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>
<script src="~/Scripts/Client Scripts/mvcfoolproof.unobtrusive.min.js"></script>

@*<script src="~/Scripts/jquery.table2excel.js"></script>*@
<script src="~/Content/JS/BackEnd/StudentsAssignments.js"></script>
<div class="page-header">
        <div class="breadcrumb-line">
            <ul class="breadcrumb">
                <li>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<i class="fa fa-home position-left"></i>Home</li>
                <li>Exam</li>
                <li class="active">Students Assignments</li>
            </ul>
            <ul class="breadcrumb-elements">
                <li><input class="btn btn-primary" name="Create" id="Create" value="Create" type="submit"></li>
            </ul>
        </div>
    </div>

<div id="assignmentsForm" style="display:none">
    @using (Html.BeginForm("", "", FormMethod.Post, new { enctype = "multipart/form-data", id = "formStudentsAssignments", name = "formStudentsAssignments", onSubmit = "return false;" }))
    {
        <div class="row">
            <div class="col-sm-2">
                @Html.AntiForgeryToken();
                @Html.HiddenFor(model=>model.ID)
                @Html.LabelFor(model => model.SessionID)<span style="color:red">*</span>
                @Html.DropDownListFor(model => model.SessionID, (SelectList)ViewBag.sessionList, "--Select--", new { @class = "form-control", required = "required" })
                @Html.ValidationMessageFor(model => model.SessionID, String.Empty, new { @class = "text-danger" })
            </div>

            <div class="col-sm-2">

                @Html.LabelFor(model => model.ClassID)<span style="color:red">*</span>
                @Html.DropDownListFor(model => model.ClassID, (SelectList)ViewBag.classList, "--Select--", new { @class = "form-control", required = "required" })
                @Html.ValidationMessageFor(model => model.ClassID, String.Empty, new { @class = "text-danger" })
            </div>

            <div class="col-sm-3">

                @Html.LabelFor(model => model.FacultyID)<span style="color:red">*</span>
                @Html.DropDownListFor(model => model.FacultyID, Enumerable.Empty<SelectListItem>(), "--Select--", new { @class = "form-control", required = "required" })
                @Html.ValidationMessageFor(model => model.FacultyID, String.Empty, new { @class = "text-danger" })
            </div>

            <div class="col-sm-2">

                @Html.LabelFor(model => model.Section)<span style="color:red">*</span>
                @Html.DropDownListFor(model => model.Section, Enumerable.Empty<SelectListItem>(), "--Select--", new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.Section, String.Empty, new { @class = "text-danger" })
            </div>
            <div class="col-sm-3">

                @Html.LabelFor(model => model.SubjectID)<span style="color:red">*</span>
                @Html.DropDownListFor(model => model.SubjectID, Enumerable.Empty<SelectListItem>(), "--Select--", new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.SubjectID, String.Empty, new { @class = "text-danger" })
            </div>


        </div>
        <div class="row" style="margin-top:10px">


            <div class="col-sm-2">
                <label>Attach File</label>
               @Html.TextBoxFor(model => model.imageFile, null, new { type = "file", @class = "input-file" })
                @Html.ValidationMessageFor(model => model.imageFile, String.Empty, new { @class = "text-danger" })

            </div>
            <div class="col-md-2">
                @Html.LabelFor(model => model.NotificationType)<span style="color:red">*</span>
                @Html.DropDownListFor(model => model.NotificationType, (SelectList)ViewBag.allNotificationTypes,"--Select--", new { @class = "form-control", required = "required" })
                @Html.ValidationMessageFor(model => model.NotificationType, String.Empty, new { @class = "text-danger" })
            </div>

            <div class="col-md-2">
                @Html.LabelFor(model => model.GroupID)<span style="color:red">*</span>
                @Html.DropDownListFor(model => model.GroupID, (SelectList)ViewBag.allUserGroup,"--Select--", new { @class = "form-control", required = "required" })
                @Html.ValidationMessageFor(model => model.GroupID, String.Empty, new { @class = "text-danger" })
            </div>

            <div class="col-md-2">
                @Html.LabelFor(model => model.NepaliDeadline)
                @Html.TextBoxFor(model => model.NepaliDeadline, new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.NepaliDeadline, String.Empty, new { @class = "text-danger" })
            </div>
            <div class="col-md-2">
                @Html.LabelFor(model => model.Deadline)
                @Html.TextBoxFor(model => model.Deadline, new { @class = "form-control", @disabled = "disabled" })
                @Html.ValidationMessageFor(model => model.Deadline, String.Empty, new { @class = "text-danger" })

            </div>

            
            <div class="col-sm-2">
                <button style="margin-top:23px" class="btn btn-primary" id="studentsAssignments">Submit</button>
                <button style="margin-top:23px" class="btn refresh" onclick="location.href='@Url.Action("Index", "StudentsAssignments")';return false;">Refresh</button>

            </div>

        </div>


    }
</div>
<div class="row" style="margin-top:10px" id="assignmentsList">

   <div>@Html.Partial("~/Areas/Admin/Views/StudentsAssignments/StudentsAssignmentsList.cshtml")</div>

</div>


