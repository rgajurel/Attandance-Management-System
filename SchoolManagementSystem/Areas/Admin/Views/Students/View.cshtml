                                        @Html.TextBoxFor(model => model.Students.RollNo, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(model => model.Students.RollNo, String.Empty, new { @class = "text-danger", id = "duplicatemessage" })
                                    </div>
                                </div>

