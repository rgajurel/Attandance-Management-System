                                        @Html.DropDownListFor(model => model.Students.HouseID, (SelectList)ViewBag.houseList, "--Select--", new { @class = "form-control", required = "required" })
                                        @Html.ValidationMessageFor(model => model.Students.HouseID, String.Empty, new { @class = "text-danger" })
                                    </div>

