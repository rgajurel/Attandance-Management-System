                                    <div class="col-md-3">
                                        @Html.LabelFor(model => model.Students.ClassID)<span style="color:red">*</span>
                                        @Html.DropDownListFor(model => model.Students.ClassID, (SelectList)ViewBag.classList, "--Select--", new { @class = "form-control", required = "required" })
                                        @Html.ValidationMessageFor(model => model.Students.ClassID, String.Empty, new { @class = "text-danger" })
                                    </div>

                                    <div class="col-md-3">
                                        @Html.LabelFor(model => model.Students.FacultyID)<span style="color:red">*</span>
                                        @Html.DropDownListFor(model => model.Students.FacultyID, Enumerable.Empty<SelectListItem>(), "--Select--", new { @class = "form-control", required = "required" })
                                        @Html.ValidationMessageFor(model => model.Students.FacultyID, String.Empty, new { @class = "text-danger" })
                                    </div>

                                    <div class="col-md-3">
                                        @Html.LabelFor(model => model.Students.Section)<span style="color:red">*</span>
                                        @Html.DropDownListFor(model => model.Students.Section, Enumerable.Empty<SelectListItem>(), "--Select--", new { @class = "form-control" })
                                        @Html.ValidationMessageFor(model => model.Students.Section, String.Empty, new { @class = "text-danger" })
                                    </div>

                                    <div class="col-md-3">
