                                        @Html.LabelFor(model => model.Students.ReligionID)<span style="color:red">*</span>
                                        @Html.DropDownListFor(model => model.Students.ReligionID, (SelectList)ViewBag.religionList, "--Select--", new { @class = "form-control" })
                                        @Html.ValidationMessageFor(model => model.Students.ReligionID, String.Empty, new { @class = "text-danger" })
                                    </div>
                                    <div class="col-md-3">

                                        @Html.LabelFor(model => model.Students.CasteID)<span style="color:red">*</span>
                                        @Html.DropDownListFor(model => model.Students.CasteID, (SelectList)ViewBag.casteList, "--Select--", new { @class = "form-control" })
                                        @Html.ValidationMessageFor(model => model.Students.CasteID, String.Empty, new { @class = "text-danger" })
                                    </div>

                                </div>
                                <div class="row">
                                   
                                    <div class="col-md-3">
                                        @Html.LabelFor(model => model.Students.CitizenShipNumber)
                                        @Html.TextBoxFor(model => model.Students.CitizenShipNumber, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(model => model.Students.CitizenShipNumber, String.Empty, new { @class = "text-danger" })
                                    </div>

                                    <div class="col-md-3">
                                        @Html.LabelFor(model => model.Students.TemporaryAddress)<span style="color:red">*</span>
                                        @Html.TextBoxFor(model => model.Students.TemporaryAddress, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(model => model.Students.TemporaryAddress, String.Empty, new { @class = "text-danger" })
                                    </div>

                                    <div class="col-md-3">
                                        @Html.LabelFor(model => model.Students.PermanentAddress)<span style="color:red">*</span>
                                        @Html.TextBoxFor(model => model.Students.PermanentAddress, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(model => model.Students.PermanentAddress, String.Empty, new { @class = "text-danger" })
                                    </div>
                                </div>

                                <div class="row">
                                    <p><b>PREVIOUS QUALIFICATION DETAILS:-</b></p><hr>
                                    <div class="col-md-3">
                                        @Html.LabelFor(model => model.Students.LastSchoolAttended)
                                        @Html.TextBoxFor(model => model.Students.LastSchoolAttended, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(model => model.Students.LastSchoolAttended, String.Empty, new { @class = "text-danger" })
                                    </div>
                                    <div class="col-md-3">
                                        @Html.LabelFor(model => model.Students.Result)
                                        @Html.DropDownListFor(model => model.Students.Result,
new SelectList(new List<SelectListItem> {
                 new SelectListItem { Text = "Pass", Value = "Pass" },
                 new SelectListItem { Text = "Failed", Value = "Failed" }
}, "Value", "Text"), new { @class = "form-control" })

                                        @Html.ValidationMessageFor(model => model.Students.Result, String.Empty, new { @class = "text-danger" })
                                    </div>
                                    <div class="col-md-3">
                                        @Html.LabelFor(model => model.Students.DocumetsSubmittedID)                                        
                                        @Html.DropDownListFor(model => model.Students.DocumetsSubmittedID, (SelectList)ViewBag.documentsList, new { @class = "form-control", @multiple = "multiple" })

                                    </div>

                                </div>


                                <div class="row">
                                    <p><b>PARENTS DETAILS:-</b></p><hr>
                                    <div class="col-md-3">
                                        @Html.LabelFor(model => model.Students.FatherName)<span style="color:red">*</span>
                                        @Html.TextBoxFor(model => model.Students.FatherName, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(model => model.Students.FatherName, String.Empty, new { @class = "text-danger" })
                                    </div>
                                    <div class="col-md-3">
                                        @Html.LabelFor(model => model.Students.FatherMobileNo)<span style="color:red">*</span>
                                        @Html.TextBoxFor(model => model.Students.FatherMobileNo, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(model => model.Students.FatherMobileNo, String.Empty, new { @class = "text-danger" })
                                    </div>
                                    <div class="col-md-3">
                                        @Html.LabelFor(model => model.Students.FatherEmail)
                                        @Html.TextBoxFor(model => model.Students.FatherEmail, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(model => model.Students.FatherEmail, String.Empty, new { @class = "text-danger" })
                                    </div>
                                    <div class="col-md-3">
                                        @Html.LabelFor(model => model.Students.MotherName)<span style="color:red">*</span>
                                        @Html.TextBoxFor(model => model.Students.MotherName, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(model => model.Students.MotherName, String.Empty, new { @class = "text-danger" })
                                        @*@Html.LabelFor(model => model.Fatherjob)
                                            @Html.TextBoxFor(model => model.Fatherjob, new { @class = "form-control" })
                                            @Html.ValidationMessageFor(model => model.Fatherjob, String.Empty, new { @class = "text-danger" })*@
                                    </div>
                                </div>
                                @* <div class="row">
                                        <div class="form-group col-sm-3 success">
                                            @Html.LabelFor(model => model.MotherName)<span style="color:red">*</span>
                                            @Html.TextBoxFor(model => model.MotherName, new { @class = "form-control" })
                                            @Html.ValidationMessageFor(model => model.MotherName, String.Empty, new { @class = "text-danger" })
                                        </div>
                                        <div class="form_group col-sm-3 error">
                                            @Html.LabelFor(model => model.MotherMobileNo)<span style="color:red">*</span>
                                            @Html.TextBoxFor(model => model.MotherMobileNo, new { @class = "form-control" })
                                            @Html.ValidationMessageFor(model => model.MotherMobileNo, String.Empty, new { @class = "text-danger" })
                                        </div>
                                        <div class="form-group col-sm-3 success">
                                            @Html.LabelFor(model => model.MotherEmail)
                                            @Html.TextBoxFor(model => model.MotherEmail, new { @class = "form-control" })
                                            @Html.ValidationMessageFor(model => model.MotherEmail, String.Empty, new { @class = "text-danger" })
                                        </div>
                                        <div class="form_group col-sm-3 error">
                                            @Html.LabelFor(model => model.MotherJob)
                                            @Html.TextBoxFor(model => model.MotherJob, new { @class = "form-control" })
                                            @Html.ValidationMessageFor(model => model.MotherJob, String.Empty, new { @class = "text-danger" })
                                        </div>
                                    </div>*@

                                <div class="row">
                                    <div class="col-md-3" style="margin-top:10px">
                                        <input class="btn btn-danger" name="employeeSubmit" id="Save" value="Save" type="submit">
                                        <button type="button" class="btn cancel" name="Cancel">Cancel</button>

                                    </div>
                                </div>

                            }
                        </div>

                    </div>

                </div>
            </div>
        </div>
    </div>
</div>


    <div class="row" id="show">
        <div class="col-md-12">
            @Html.Partial("~/Areas/Admin/Views/Students/StudentsList.cshtml")
        </div>
    </div>


<div class="modal fade" id="customPopupDialog" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                @*<button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>*@
                <h4 class="modal-title " id="customPopupTitle">Upload Excel File</h4>
            </div>
            <div>
                <button class="btn btn-danger"><a style="color:white" href="~/Content/DownloadFile/StudentsUpload.xlsx" download>Download Sample Excel</a></button>
            </div>
           
@using (Html.BeginForm("", "", FormMethod.Post, new { enctype = "multipart/form-data", id = "formBatchUpload", name = "formBatchUpload", autocomplete = "off", onSubmit = "return false;" }))
{                 <div class="modal-body message">
                         <div class="row">
                    <div class="col-lg-4">
                        <label>Academic Year</label>
                        @Html.DropDownListFor(model => model.BulkStudentsSearch.BulkYearID, (SelectList)ViewBag.sessionList,"--Select--", new { @class = "form-control", required = "required" })
                        @Html.ValidationMessageFor(model => model.BulkStudentsSearch.BulkYearID, String.Empty, new { @class = "text-danger" })
                    </div>
                    <div class="col-lg-4">
                        <label>Class</label>
                        @Html.DropDownListFor(model => model.BulkStudentsSearch.BulkClassID, (SelectList)ViewBag.classList, "--Select--", new { @class = "form-control", required = "required" })
                        @Html.ValidationMessageFor(model => model.BulkStudentsSearch.BulkClassID, String.Empty, new { @class = "text-danger" })
                    </div>
                    <div class="col-lg-4">
                        <label>Faculty</label>

                        @Html.DropDownListFor(model => model.BulkStudentsSearch.BulkFacultyID, Enumerable.Empty<SelectListItem>(), "--Select--", new { @class = "form-control", required = "required" })
                        @Html.ValidationMessageFor(model => model.BulkStudentsSearch.BulkFacultyID, String.Empty, new { @class = "text-danger" })
                    </div>

                </div>
                <div class="row">
                    <div class="col-lg-4">
                        <label>Section</label>
                        @Html.DropDownListFor(model => model.BulkStudentsSearch.BulkSection, Enumerable.Empty<SelectListItem>(), "--Select--", new { @class = "form-control" })
                        @Html.ValidationMessageFor(model => model.BulkStudentsSearch.BulkSection, String.Empty, new { @class = "text-danger" })
                    </div>
                    <div style="margin-top:5px" class="col-lg-4">
