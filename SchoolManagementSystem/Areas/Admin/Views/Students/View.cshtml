                                    <div class="col-md-3">
                                        @Html.LabelFor(model => model.Students.Batch)<span style="color:red">*</span>
                                        @Html.TextBoxFor(model => model.Students.Batch, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(model => model.Students.Batch, String.Empty, new { @class = "text-danger" })
                                    </div>
                                    <div class="col-md-3">
