@model DomainEntities.BulkUploadStudents

<script src="~/Content/vendor/multiselectdropdown/js/jquery.sumoselect.js"
        type="text/javascript"></script>
<link href="~/Content/vendor/multiselectdropdown/css/dropdownliststyle.css"
      rel="stylesheet" type="text/css" />
<script src="~/Scripts/jquery.validate.min.js"></script>
<script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>
<script src="~/Content/JS/BackEnd/Students.js"></script>
<script src="~/Scripts/xlsx.core.min.js"></script>
@using Kendo.Mvc.UI
<div class="row">
    <div class="col-md-12">
        <ol class="breadcrumb">
            <li><i class="fa fa-home"></i><a href="/Admin/SchoolInformation">Students</a></li>
            <li><a href="/Admin/OrganisationType">Students Admission</a></li>
            <li class="pull-right"><button class="btn btn-danger create" type="submit">Create New</button></li>
            <li class="pull-right"><button class="btn btn-danger cancel" type="submit">Cancel</button></li>
            <li class="pull-right"><button class="btn btn-danger upload" type="submit">Upload Excel</button></li>           

</ol>
    </div>
</div>

<div style="display:none" id="hide">
    <div class="content">
        <div class="row">
            <div class="col-sm-12">
                <div class="panel panel-default">
                    <div class="panel-heading">
                        <h4 class="panel-title">Students Profile</h4>
                    </div>
                    @Html.ValidationSummary()
                    <div class="panel-body">
                        <div class="col-sm-12">
                            @using (Html.BeginForm("", "", FormMethod.Post, new { enctype = "multipart/form-data", id = "formStudents", name = "formStudents",autocomplete="off", onSubmit = "return false;" }))
                            {
                                @Html.AntiForgeryToken()
                                <div class="row">
                                  
                                    @Html.HiddenFor(model => model.Students.ID)

                                    <div class="col-md-3">
                                        @Html.LabelFor(model => model.Students.AcademicYear)<span style="color:red">*</span>
                                        @Html.DropDownListFor(model => model.Students.AcademicYear, (SelectList)ViewBag.sessionList,"--Select--", new { @class = "form-control", required = "required" })
                                        @Html.ValidationMessageFor(model => model.Students.AcademicYear, String.Empty, new { @class = "text-danger" })
                                    </div>
                                    <div class="col-md-3">

                                        @Html.LabelFor(model => model.Students.RegistrationNo)<span style="color:red">*</span>
                                        @Html.TextBoxFor(model => model.Students.RegistrationNo, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(model => model.Students.RegistrationNo, String.Empty, new { @class = "text-danger" })

                                    </div>

                                    <div class="col-md-3">
                                        @Html.LabelFor(model => model.Students.UserID)
                                        @Html.TextBoxFor(model => model.Students.UserID, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(model => model.Students.UserID, String.Empty, new { @class = "text-danger" })
                                    </div>
                                                                       
