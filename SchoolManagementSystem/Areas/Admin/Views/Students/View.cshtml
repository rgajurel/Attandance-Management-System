                        @Html.TextBoxFor(model => model.BulkStudentsSearch.BulkImage, null, new { type = "file", @class = "input-file" })
                        @Html.ValidationMessageFor(model => model.BulkStudentsSearch.BulkImage, String.Empty, new { @class = "text-danger" })
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger" id="ok">Save</button>
                <button type="button" class="btn" data-dismiss="modal">Close</button>
