

@model DomainEntities.DailyAttandanceListViewModel

<div class="x_panel">
    @if (Model.DailyAttandanceList.Count() > 0)
    {
        if (!Model.IsExport)
        {
            <a class="btn btn-danger"
               href="@Url.Action("DailyAttandanceReportDownload", "DailyAttandanceReport")">Export to excel</a>
        }
    }
    <table class="table table-bordered" border="1px solid black">
        <thead>           
            <tr><th>Year</th><th> @Model.Year</th></tr>
            <tr><th>Month</th><th> @Model.Month</th></tr>
            <tr><th>Date</th><th> @Model.Date</th></tr>
            <tr>
                <th>Name</th>
                <th>Designation</th>
                <th>Entry Time</th>
                <th>Actual Entry Time</th>
                <th>Exit Time</th>
                <th>Actual Exit Time</th>
                <th>Working Hours</th>
                <th>Actual Working Hours</th>
                <th>Extra Working Hours</th>
                <th>Late Entry</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.DailyAttandanceList.Count() == 0)
            {
                <tr>
                    <td colspan="10">No Records Availiable</td>
                </tr>
            }
            else
            {              

                foreach (var data in Model.DailyAttandanceList)
                {
                    <tr>
                        <td>@data.Employee</td>
                        <td>@data.Designation</td>                    
                        <td>@data.EntryTime</td>
                        <td>@data.ActualEntryTime</td>
                        <td>@data.ExitTime</td>
                        <td>@data.ActualExitTime</td>
                        <td>@data.WorkingHours</td>
                        <td>@data.ActualWorkingHours</td>
                        <td>@data.OverTime</td>
                        @if (data.IsLateEntry)
                        {
                            <td style="background-color:red;color:white">Late Entry</td>
                        }
                        else
                        {
                            <td style="background-color:skyblue;color:white">On Time</td>
                        }
                        

                    </tr>
                }
               
            }



        </tbody>
    </table>
</div>