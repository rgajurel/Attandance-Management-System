

<script src="~/Scripts/jquery.validate.min.js"></script>
<script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>
<script src="~/Content/JS/BackEnd/MonthlySummaryReport.js"></script>

@using Kendo.Mvc.UI
@model DomainEntities.MonthlyAttandanceSummaryReport
@using (Html.BeginForm("", "", FormMethod.Post, new { enctype = "multipart/form-data", autocomplete = "off", id = "formMonthlySummaryReport", name = "formMonthlySummaryReport", onSubmit = "return false;" }))
{
    @Html.AntiForgeryToken()
    <div class="x_panel">
        <div class="col-md-2">
            @Html.LabelFor(model => model.OrganisationID)<span style="color:red">*</span>
            @Html.DropDownListFor(model => model.OrganisationID, Enumerable.Empty<SelectListItem>(), "--Organisation--", new { @class = "form-control", required = "required" })
            @Html.ValidationMessageFor(model => model.OrganisationID, String.Empty, new { @class = "text-danger" })
        </div>
                <div class="col-md-2">
            <label>Employee</label><span style="color:red">*</span>
            @Html.DropDownListFor(model => model.EmployeeID, Enumerable.Empty<SelectListItem>(), "--Select--", new { @class = "form-control" })
            @Html.ValidationMessageFor(model => model.EmployeeID, String.Empty, new { @class = "text-danger" })
        </div>
        <div class="col-md-2">
            @Html.LabelFor(model => model.Year)<span style="color:red">*</span>
            @Html.DropDownListFor(model => model.Year, (SelectList)ViewBag.sessionList, "--Select--", new { @class = "form-control", required = "required" })
            @Html.ValidationMessageFor(model => model.Year, String.Empty, new { @class = "text-danger" })
        </div>

        <div class="col-md-2">
            @Html.LabelFor(model => model.Month)<span style="color:red">*</span>
            @Html.DropDownListFor(model => model.Month, (SelectList)ViewBag.monthList, "--Select--", new { @class = "form-control", required = "required" })
            @Html.ValidationMessageFor(model => model.Month, String.Empty, new { @class = "text-danger" })
        </div>     

        <div class="col-md-4">
            <button style="margin-top:26px" class="btn btn-danger" id="monthlySummaryReportGenerate">Generate</button>
            <button style="display:none" class="btn btn-danger" id="Print">Print</button>
        </div>
    </div>

}

