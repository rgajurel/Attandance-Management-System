
@model IEnumerable<DomainEntities.ParentsChild>
@{
    try
    {
        if (Session["parentEmail"].ToString() == "")
        {
            Response.Redirect("~/Areas/Client/Views/Home/Index.cshtml");
        }
    }
    catch
    {
        Response.Redirect("~/Areas/Client/Views/Home/Index.cshtml");
    }
}

