
<div class="row">
    <div class="col-md-12">
        <div class="panel panel-flat">

            <div class="row">
                    <div class="col-lg-6" style="float:left">                     
                                   
                                        <div class="form-group">
                                            <input placeholder="Search Name ..." class="form-control ui-autocomplete-input" id="FieldFilter"  type="text">
                                                                   </div>                                  
                       
                    </div>
                </div>

            @using Kendo.Mvc.UI
            @(Html.Kendo().Grid<DomainEntities.AccumulativeLeave>()
    .Name("AccumulativeLeaveList")

            .Columns(columns =>
            {
                // columns.Template(t => { }).Title("Row No").ClientTemplate("#= renderNumber(data) #").Hidden();
                //columns.Template(t => { }).Title("S.N").ClientTemplate("#= renderRecordNumber(data) #").Width(50);
                columns.Bound(c => c.ID).Hidden();
                columns.Bound(c => c.SN).Title("S.N").Width(20);
                columns.Bound(c => c.Name).Title("Name").Width(150);
                columns.Bound(c => c.OrganisationName).Title("Organisation").Width(150);
                columns.Bound(c => c.UserID).Title("UserID").Width(150);
                columns.Bound(c => c.LeaveType).Title("LeaveType").Width(150);
                columns.Bound(c => c.Days).Title("Days").Width(150);

                //columns.Bound(c => c.Type).Title("Modified On").Width(50).ClientTemplate("#= customDate(data) #").Format(ViewBag.settingDateFormat);

                columns.Command(command =>
                {
                    command.Custom("Edit").Text(" ").Click("Edit");
                    command.Custom("Delete").Text(" ").Click("Delete");

                }).Width(50).Title("Action");

            })

            
                    .Pageable(
              page => page.Refresh(true)
             .PageSizes(new int[] { 10, 20, 40, 60, 80, 100 })
              .PreviousNext(true))

            .Reorderable(reorder => reorder.Columns(true))
                    .DataSource(dataSource => dataSource
                        .Ajax()
                        .ServerOperation(false)
                                .Model(model =>
                                {
                                    model.Id(p => p.ID);                                   

                                })
                  .Read(read => read.Action("GetAll", "AccumulativeLeave"))// Action invoked when the user saves a new data item
                  .PageSize(10)
             )
.Events(ev => ev.DataBound("resetRowNumber"))

            )
        </div>








    </div>
</div>
</div>