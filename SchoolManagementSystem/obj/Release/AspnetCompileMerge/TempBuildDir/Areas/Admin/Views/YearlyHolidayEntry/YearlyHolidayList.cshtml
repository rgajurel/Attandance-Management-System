


@using Kendo.Mvc.UI
@(Html.Kendo().Grid<DomainEntities.YearlyHolidaysEntry>()
    .Name("YearlyHolidayGrid")
            .Columns(columns =>
            {
                columns.Bound(c => c.ID).Hidden();
                columns.Bound(c => c.SN).Title("S.N").Width(20);
                columns.Bound(c => c.OrganisationName).Title("Organisation").Width(150);
                columns.Bound(c => c.Title).Title("Holiday Name").Width(150);     
                columns.Bound(c => c.Date).Title("Date").Width(150).Format("{0:MM-dd-yyyy}");         

                columns.Command(command =>
                {
                    command.Custom("Edit").Text(" ").Click("Edit");
                    command.Custom("Delete").Text(" ").Click("Delete");

                }).Width(50).Title("Action");

            })


                     .ToolBar(toolbar =>
                     {
                         toolbar.Template(@<text>


        <div class="right-inner-addon" style="width:200px">

            <input type="search"
                   class="form-control"
                   placeholder="Search By Holiday Name" id="FieldFilter" />

        </div>
                    </text>);
                     })
                   
                    .Pageable(
              page => page.Refresh(true)
             .PageSizes(new int[] { 10, 20, 40, 60, 80, 100 })
              .PreviousNext(true))

            .Reorderable(reorder => reorder.Columns(true))
                    .DataSource(dataSource => dataSource
                        .Ajax()
                        .ServerOperation(false)
                                .Model(model =>
                                {
                                    model.Id(p => p.ID);
                                    model.Field(p => p.Title).Editable(false);

                                })
                  .Read(read => read.Action("GetAll", "YearlyHolidayEntry"))// Action invoked when the user saves a new data item
                  .PageSize(10)
             )
.Events(ev => ev.DataBound("resetRowNumber"))

)








