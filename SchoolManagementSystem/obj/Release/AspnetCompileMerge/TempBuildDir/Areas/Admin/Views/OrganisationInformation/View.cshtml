@model DomainEntities.SchoolInformation
<script src="~/Content/JS/BackEnd/SchoolInformation.js"></script>
<script src="~/Scripts/jquery.validate.min.js"></script>
<script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>
<div class="row">
    <div class="col-md-12">
        <ol class="breadcrumb">
            <li><i class="fa fa-home"></i><a href="/Admin/SchoolInformation">Organisation</a></li>
            <li><a href="/Admin/OrganisationInformation">Organisation Information</a></li>
            <li class="pull-right"><button class="btn btn-danger create" type="submit">Create New</button></li>
        </ol>
    </div>
</div>
<div id="hide" style="display:none">
    <div class="content">
        <div class="row">
            <div class="col-sm-12">
                <div class="panel panel-default">
                    <div class="panel-heading">
                        <h4 class="panel-title">Organisation Type</h4>
                    </div>
                    <div class="panel-body">
                        <div class="col-md-12">
                            <div class="col-lg-9">

                                @using (Html.BeginForm("", "", FormMethod.Post, new { enctype = "multipart/form-data", id = "formSchoolDetails", name = "formSchoolDetails", autocomplete = "off", onSubmit = "return false;" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <div class="form-group">
                                        <div class="row">
                                            <div class="col-md-4">
                                                @Html.HiddenFor(model => model.ID)
                                                @Html.LabelFor(model => model.Name)<span style="color:red">*</span>
                                                @Html.TextBoxFor(model => model.Name, new { @class = "form-control" })
                                                @Html.ValidationMessageFor(model => model.Name, String.Empty, new { @class = "text-danger" })
                                            </div>
                                            <div class="col-md-4">

                                                @Html.LabelFor(model => model.Address)<span style="color:red">*</span>
                                                @Html.TextBoxFor(model => model.Address, new { @class = "form-control" })
                                                @Html.ValidationMessageFor(model => model.Address, String.Empty, new { @class = "text-danger" })
                                            </div>
                                            <div class="col-md-4">
                                                @Html.LabelFor(model => model.Email)<span style="color:red">*</span>
                                                @Html.TextBoxFor(model => model.Email, new { @class = "form-control" })
                                                @Html.ValidationMessageFor(model => model.Email, String.Empty, new { @class = "text-danger" })
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <div class="row">
                                            <div class="col-md-4">
                                                @Html.LabelFor(model => model.Mobile)<span style="color:red">*</span>
                                                @Html.TextBoxFor(model => model.Mobile, new { @class = "form-control" })
                                                @Html.ValidationMessageFor(model => model.Mobile, String.Empty, new { @class = "text-danger" })
                                            </div>
                                            <div class="col-md-4">
                                                @Html.LabelFor(model => model.Fax)
                                                @Html.TextBoxFor(model => model.Fax, new { @class = "form-control" })
                                                @Html.ValidationMessageFor(model => model.Fax, String.Empty, new { @class = "text-danger" })
                                            </div>
                                            <div class="col-md-4">
                                                @Html.LabelFor(model => model.ContactPerson)<span style="color:red">*</span>
                                                @Html.TextBoxFor(model => model.ContactPerson, new { @class = "form-control" })
                                                @Html.ValidationMessageFor(model => model.ContactPerson, String.Empty, new { @class = "text-danger" })
                                            </div>
                                        </div>
                                    </div>

                                    <div class="form-group">
                                        <div class="row">
                                            <div class="col-md-4">
                                                @Html.LabelFor(model => model.Phone)<span style="color:red">*</span>
                                                @Html.TextBoxFor(model => model.Phone, new { @class = "form-control" })
                                                @Html.ValidationMessageFor(model => model.Phone, String.Empty, new { @class = "text-danger" })
                                            </div>
                                            <div class="col-md-4">
                                                @Html.LabelFor(model => model.RegistrationNo)<span style="color:red">*</span>
                                                @Html.TextBoxFor(model => model.RegistrationNo, new { @class = "form-control" })
                                                @Html.ValidationMessageFor(model => model.RegistrationNo, String.Empty, new { @class = "text-danger" })
                                            </div>
                                            <div class="col-md-4">
                                                @Html.LabelFor(model => model.EstablishedYear)<span style="color:red">*</span>
                                                @Html.TextBoxFor(model => model.EstablishedYear, new { @class = "form-control" })
                                                @Html.ValidationMessageFor(model => model.EstablishedYear, String.Empty, new { @class = "text-danger" })
                                            </div>
                                        </div>
                                    </div>


                                    <div class="form-group">
                                        <div class="row">
                                            <div class="col-md-4">
                                                @Html.LabelFor(model => model.SchoolTypeID)<span style="color:red">*</span>
                                                @Html.DropDownListFor(model => model.SchoolTypeID, (SelectList)ViewBag.schoolTypeList, "--Select--", new { @class = "form-control", required = "required" })
                                                @Html.ValidationMessageFor(model => model.SchoolTypeID, String.Empty, new { @class = "text-danger" })
                                            </div>
                                            <div class="col-md-4">
                                                @Html.LabelFor(model => model.IsMainBranch)<span style="color:red">*</span>
                                                @Html.DropDownListFor(model => model.IsMainBranch,
                                        new SelectList(new List<SelectListItem> {
                                              new SelectListItem { Text = "Yes", Value = "1" },
                                             new SelectListItem { Text = "No", Value = "0" }


                                        }, "Value", "Text"), "--Select--", new { @class = "form-control" })

                                                @Html.ValidationMessageFor(model => model.IsMainBranch, String.Empty, new { @class = "text-danger" })
                                            </div>
                                            <div class="col-md-4">
                                                <label for="reg_input_logo">Upload Logo</label>
                                                <input type="file" id="inputFile" name="inputFile" />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="text-right pull-left">
                                        <input class="btn btn-danger" name="schoolInformationSubmit" id="schoolInformationSubmit" value="Save" type="submit" />
                                        <button type="button" class="btn cancel" name="Cancel">Cancel</button>
                                    </div>
                                }
                            </div>
                            
                            <div class="col-lg-3">
                                <div class="thumbnail">
                                    <div class="thumb thumb-slide">
                                        <img src="~/Content/Images/School/School.png" id="imageupload" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            </div>
    </div>
    </div>


<div class="row" id="show">
    <div class="col-md-12">
        @Html.Partial("~/Areas/Admin/Views/OrganisationInformation/SchoolInformationList.cshtml")
    </div>
</div>



