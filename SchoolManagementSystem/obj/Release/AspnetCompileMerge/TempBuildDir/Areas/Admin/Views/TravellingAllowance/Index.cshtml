
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/AdminLayout.cshtml";
}

@model DomainEntities.TravellingAllowance
<script src="~/Scripts/jquery.validate.min.js"></script>
<script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>
<script src="~/Content/JS/BackEnd/TravellingAllowance.js"></script>
<div class="page-header">
    <div class="breadcrumb-line">
        <ul class="breadcrumb">
            <li>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<i class="fa fa-home position-left"></i>Home</li>
            <li>HR/Payroll</li>
            <li class="active">Travelling Allowance</li>
        </ul>
        <ul class="breadcrumb-elements">
            <li><input class="btn btn-primary" name="Show" id="Show" value="Create" type="submit"></li>
        </ul>
    </div>
</div>
<div class="row" id="create" style="display:none">
    <div class="content">
        <div class="row">
            <div class="col-md-12">
                <div class="panel panel-flat">
                    <div class="panel-heading">
                        <div class="panel-body">
                            <div class="row">
                                <div class="col-lg-12">
                                    <div class="panel panel-flat">
                                        <div class="panel-body">
                                            @using (Html.BeginForm("", "", FormMethod.Post, new { enctype = "multipart/form-data", id = "formTravellingAllownce", name = "formTravellingAllownce", onSubmit = "return false;" }))
                                            {
                                                @Html.AntiForgeryToken()
                                                <div class="row">
                                                    <div class="form-group">

                                                        <div class="col-md-3">
                                                            @Html.HiddenFor(model => model.ID)
                                                            @Html.LabelFor(model => model.OrganisationID)<span style="color:red">*</span>
                                                            @Html.DropDownListFor(model => model.OrganisationID, Enumerable.Empty<SelectListItem>(), "--Organisation--", new { @class = "form-control", required = "required" })
                                                            @Html.ValidationMessageFor(model => model.OrganisationID, String.Empty, new { @class = "text-danger" })
                                                        </div>
                                                        <div class="col-md-3">
                                                            @Html.LabelFor(model => model.EmployeeID)<span style="color:red">*</span>
                                                            @Html.DropDownListFor(model => model.EmployeeID, Enumerable.Empty<SelectListItem>(), "--Select--", new { @class = "form-control" })
                                                            @Html.ValidationMessageFor(model => model.EmployeeID, String.Empty, new { @class = "text-danger" })
                                                        </div>
                                                        <div class="col-md-3">
                                                            @Html.LabelFor(model => model.Year)<span style="color:red">*</span>
                                                            @Html.DropDownListFor(model => model.Year, (SelectList)ViewBag.sessionList, new { @class = "form-control" })
                                                            @Html.ValidationMessageFor(model => model.Year, String.Empty, new { @class = "text-danger" })
                                                        </div>
                                                        <div class="col-md-3">
                                                            @Html.LabelFor(model => model.Month)<span style="color:red">*</span>
                                                            @Html.DropDownListFor(model => model.Month, ViewBag.monthList as SelectList, new { @class = "form-control" })
                                                            @Html.ValidationMessageFor(model => model.Month, String.Empty, new { @class = "text-danger" })
                                                        </div>

                                                    </div>
                                                </div>

                                                <div class="row">
                                                    <div class="form-group">


                                                        <div class="col-md-3">
                                                            @Html.LabelFor(model => model.NepaliDateFrom)<span style="color:red">*</span>
                                                            @Html.TextBoxFor(model => model.NepaliDateFrom, new { @class = "form-control" })
                                                            @Html.ValidationMessageFor(model => model.NepaliDateFrom, String.Empty, new { @class = "text-danger" })
                                                        </div>
                                                        <div class="col-md-3">
                                                            @Html.LabelFor(model => model.NepaliDateTo)<span style="color:red">*</span>
                                                            @Html.TextBoxFor(model => model.NepaliDateTo, new { @class = "form-control" })
                                                            @Html.ValidationMessageFor(model => model.NepaliDateTo, String.Empty, new { @class = "text-danger" })
                                                        </div>
                                                       
                                                        <div class="col-md-3">
                                                            @Html.LabelFor(model => model.Amount)<span style="color:red">*</span>
                                                            @Html.TextBoxFor(model => model.Amount, new { @class = "form-control" })
                                                            @Html.ValidationMessageFor(model => model.Amount, String.Empty, new { @class = "text-danger" })
                                                        </div>

                                                        <div class="col-md-3">
                                                            @Html.LabelFor(model => model.Status)<span style="color:red">*</span>
                                                            @Html.DropDownListFor(model => model.Status,
                                        new SelectList(new List<SelectListItem> {
                                        new SelectListItem { Text = "Paid", Value = "0" },
                                        new SelectListItem { Text = "Not Paid", Value = "1" }
                                        }, "Value", "Text"), new { @class = "form-control" })
                                                            @Html.ValidationMessageFor(model => model.Status, String.Empty, new { @class = "text-danger" })
                                                        </div>

                                                    </div>
                                                </div>

                                                <div class="row">
                                                    <div class="form-group">
                                                        <div class="col-md-12">
                                                            @Html.LabelFor(model => model.Description)<span style="color:red">*</span>
                                                            @Html.TextAreaFor(model => model.Description, new { @class = "form-control" })
                                                            @Html.ValidationMessageFor(model => model.Description, String.Empty, new { @class = "text-danger" })
                                                        </div>
                                                        <div class="col-md-3" style="display:none">
                                                            @Html.LabelFor(model => model.DateFrom)<span style="color:red">*</span>
                                                            @Html.TextBoxFor(model => model.DateFrom, new { @class = "form-control" })
                                                            @Html.ValidationMessageFor(model => model.DateFrom, String.Empty, new { @class = "text-danger" })
                                                        </div>

                                                        <div class="col-md-3" style="display:none">
                                                            @Html.LabelFor(model => model.DateTo)<span style="color:red">*</span>
                                                            @Html.TextBoxFor(model => model.DateTo, new { @class = "form-control" })
                                                            @Html.ValidationMessageFor(model => model.DateTo, String.Empty, new { @class = "text-danger" })
                                                        </div>



                                                        <div class="col-md-4" style="margin-top:23px">
                                                            <input class="btn btn-info" name="takeLeaveSubmit" id="takeLeaveSubmit" value="Save" type="submit" />
                                                            <input class="btn" name="takeLeaveCancel" id="takeLeaveCancel" value="Cancel" type="reset">
                                                            @*<input class="btn" name="accumulativeLeavesSearch" id="accumulativeLeavesSearch" value="Search" type="reset">*@
                                                        </div>

                                                    </div>
                                                </div>

                                            }
                                        </div>
                                    </div>
                                </div>

                            </div>

                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

