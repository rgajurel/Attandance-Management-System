

@using Kendo.Mvc.UI
@(Html.Kendo().Grid<DomainEntities.EmployeeDailyAttandance>()
    .Name("EmployeeDailyAttadanceListGrid")
            .Columns(columns =>
            {
                columns.Bound(c => c.SN).Title("S.N").Width(10);
                //columns.Bound(p => p.IsAdmin).ClientTemplate("<input type='checkbox' name='chkbx' class='chkbx' ></input>").Title("Check").Width(100);


                columns.Bound(c => c.OrganisationID).Hidden();
                columns.Bound(c => c.ID).Hidden();
                columns.Bound(c => c.EmployeeID).Hidden();
                columns.Bound(c => c.Days).Hidden();
                columns.Bound(c => c.UserID).Hidden();
                columns.Bound(c => c.LeaveDaysID).Width(50).Hidden();
                columns.Bound(c => c.DateTo).Hidden().Format("{0:MM-dd-yyyy}").Width(50);
                columns.Bound(c => c.NepaliDateTo).Hidden();
                columns.Bound(c => c.Organisation).Title("Organisation").Width(100);
                columns.Bound(c => c.Employee).Title("Employee").Width(100);
                //columns.Bound(c => c.EntryimeString).Title("EntryTime").Width(100);
                //columns.Bound(c => c.ExitimeString).Title("ExitTime").Width(100);
                columns.Bound(c => c.DateFrom).Title(" English Date").Format("{0:MM-dd-yyyy}").Width(50);
                columns.Bound(c => c.NepaliDateFrom).Title("Nepali Date").Width(50).Format("{0:MM-dd-yyyy}"); ;
                columns.Bound(c => c.IsAttend).ClientTemplate("<input type='checkbox' name='chkbx' class='chkbx' ></input>").Title("<input type='checkbox' class='chkSelectAll' onclick='checkAll(this)'>All</>").Width(20);


            })



                    //.Editable(editable => editable.Mode(GridEditMode.InCell))

                    .Pageable(
              page => page.Refresh(true)
             .PageSizes(new int[] { 100 })
              .PreviousNext(true))
                    //   .PersistSelection(true)
                    // .Reorderable(reorder => reorder.Columns(true))

                    //.Navigatable()
                    .DataSource(dataSource => dataSource
                        .Ajax()

                        .ServerOperation(false)
                                .Model(model =>
                                {
                                    model.Id(p => p.SN);
                                    model.Field(p => p.SN).Editable(false);
                                    model.Field(p => p.Employee).Editable(false);

                                })
                  .Read(read => read.Action("GetAll", "EmployeeDailyAttandance").Data("ParamDailyToAttandanceList"))// Action invoked when the user saves a new data item
                   .Events(e => e.Error("onError"))
                  .PageSize(100)

             )

.Events(ev => ev.DataBound("resetRowNumberEmployeeAttandance"))



)








