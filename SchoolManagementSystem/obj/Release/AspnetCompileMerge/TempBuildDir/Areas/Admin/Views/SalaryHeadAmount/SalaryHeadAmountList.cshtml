
@using Kendo.Mvc.UI
@(Html.Kendo().Grid<DomainEntities.SalaryHeadAmount>()
    .Name("SalaryHeadAmountList")
            .Columns(columns =>
            {

                // columns.Template(t => { }).Title("Row No").ClientTemplate("#= renderNumber(data) #").Hidden();
                //columns.Template(t => { }).Title("S.N").ClientTemplate("#= renderRecordNumber(data) #").Width(50);

                columns.Bound(c => c.ID).Hidden();
                columns.Bound(c => c.EmployeeID).Hidden();
                columns.Bound(c => c.OrganisationID).Hidden();
                columns.Bound(c => c.SN).Width(20);
                columns.Bound(c => c.EmployeeName).Title("Employee Name").Width(150);
                columns.Bound(c => c.OrganisationName).Title("Organisation Name").Width(150);
                columns.Bound(c => c.Amount).Width(150).Title("Amount");
            })

                   .Editable(editable => editable.Mode(GridEditMode.InCell))


                    .Pageable(
              page => page.Refresh(true)
             .PageSizes(new int[] { 10, 20, 40, 60, 80, 100 })
              .PreviousNext(true))

            .Reorderable(reorder => reorder.Columns(true))
             .Navigatable()
                    .DataSource(dataSource => dataSource
                        .Ajax()
                        .ServerOperation(false)
                                .Model(model =>
                                {
                                    model.Id(p => p.SN);
                                    model.Field(p => p.Amount).Editable(true);
                                    model.Field(p => p.EmployeeName).Editable(false);
                                    model.Field(p => p.OrganisationName).Editable(false);
                                })
                   .Read(read => read.Action("GetAll", "SalaryHeadAmount").Data("ParamToSalaryHeadAmount"))// Action invoked when the user saves a new data item
                  .PageSize(10)
             )
.Events(ev => ev.DataBound("resetRowNumberSalaryHeadAmount"))

)








