@model DomainEntities.ForgotPassword
<script src="~/Scripts/jquery.validate.min.js"></script>
<script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>
<script src="~/Scripts/Client Scripts/mvcfoolproof.unobtrusive.min.js"></script>
<script type="text/javascript">
    $(document).ready(function () {
        $(".modal").on("hidden.bs.modal", function () {
            $("#errorMessageForgot").html("");
            $('#formForgotPassword')[0].reset();

        });


        $("#forgotPassword").click(function (e) {
            if (!$('form#formForgotPassword').data('unobtrusiveValidation').validate()) {
            e.preventDefault();
            return false;
        }
        else {

            $.ajax({
                url: '@Url.Action("ForgotPassword", "ForgotPassword")',
                type: 'POST',
                dataType: 'json',
                data: {
                    email: $("#email").val(),
                    studentName: $("#studentName").val()
                },
                success: function (data) {
                    $("#errorMessageForgot").html(data.responseText);
                    $('#formForgotPassword')[0].reset();
                }
            });
        }
        });
    });

</script>

@using (Html.BeginForm("", "", FormMethod.Post, new { enctype = "multipart/form-data", id = "formForgotPassword", name = "formForgotPassword", onSubmit = "return false;" }))
{
    @Html.AntiForgeryToken()
    <div class="modal fade" id="myModal" role="dialog">
        <div class="modal-dialog">

            <!-- Modal content-->
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                    <h4 class="modal-title">Forgot Password</h4>
                </div>

                <div class="modal-body">
                    <span style="font-size:11px; float:right; color:blue">Note* Verify your Email and atleast one Student Name to reset.</span> <br />
                            <div class="form-group success">
                                @Html.LabelFor(model => model.email)<span style="color:red">*</span>
                                @Html.TextBoxFor(model => model.email, new { @class = "form-control",@placeholder="Enter Email" })
                                @Html.ValidationMessageFor(model => model.email, String.Empty, new { @class = "text-danger" })
                            </div>

                            <div class="form-group  success">
                                @Html.LabelFor(model => model.studentName)<span style="color:red">*</span>
                                @Html.TextBoxFor(model => model.studentName, new { @class = "form-control",@placeholder = "Enter One Student Name" })
                                @Html.ValidationMessageFor(model => model.studentName, String.Empty, new { @class = "text-danger" })
                            </div>
                       
                </div>
                <div class="modal-footer">
                    <span id="errorMessageForgot" style="float:left;color:red"></span>
                    <input class="btn btn-primary" name="forgotPassword" id="forgotPassword" value="Verify & Reset" type="submit"/>
                    <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
                 </div>
            </div>

        </div>
    </div>
}
