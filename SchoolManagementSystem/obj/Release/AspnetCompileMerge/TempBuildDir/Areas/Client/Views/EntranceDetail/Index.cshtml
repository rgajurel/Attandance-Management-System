
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/AdminLayout.cshtml";
}
@using Kendo.Mvc.UI
<link rel="stylesheet" type="text/css" href="https://cdnjs.cloudflare.com/ajax/libs/MaterialDesign-Webfont/2.0.46/css/materialdesignicons.css">
<link href="~/Content/dist/css/customClient.css" rel="stylesheet" />
<script src="~/Scripts/jquery.plugin.js"></script>
<script src="~/Scripts/jquery.countdown.js"></script>
<script src="~/Content/JS/frontend/EntranceDetail.js"></script>
<link href="~/Content/vendor/kendo/css/kendo.common.min.css" rel="stylesheet">
<link href="~/Content/vendor/kendo/css/kendo.silver.min.css" rel="stylesheet">
<script src="~/Content/vendor/kendo/js/kendo.all.min.js"></script>

<div class="QuizTimerSection" style="display:none">
    <div class="row">
        <div class="col-lg-10 col-md-10 col-sm-10 col-xs-10">
            <div class="quiz-time">
                <i class="mdi mdi-timer"></i>
                <a href="#" class="close-button close-button-question QuizClose">✖</a>
                <h5><span></span><span></span></h5>
            </div>
        </div>
    </div>
</div>
<div id="previousEntry">

</div>
@using (Html.BeginForm(null, null, FormMethod.Post, new { @class = "quiz-play-form" }))
{
    @Html.AntiForgeryToken()
    <div class="row page-header-wrapper">
        <div class="col-lg-12">
            <div class="page-header-box">
                <div class="page-header-icon">
                    <span>
                        <i class="mdi mdi-lightbulb-outline"></i>
                    </span>
                </div>

                <h1 class="page-header">@ViewBag.QuizTitle<br><span>Start Entrance</span></h1>
            </div>

        </div>


    </div>


    <div class="row panel-content-body">
        <div class="col-lg-12">
            <div class="cart-wrap">

                <div class="cart-body cart-body-detail">
                    <div class="quiz-play-button">
                        <img src="@ViewBag.QuizImage" onError="this.onerror=null;this.src='/Content/dist/images/NoImageFound.jpg';">

                        <span class="SurveyStartIcon">
                            @if (ViewBag.IsQuizCompleted)
                            {
                                <a data-original-title="Start Quiz" data-placement="bottom" data-toggle="tooltip" href="#" class="QuizReport" data-val="@ViewBag.QuizEncryptData">
                                    <span> <i class="mdi mdi-play-circle-outline play-icon"></i></span>
                                </a>
                            }
                            else
                            {
                                <a data-original-title="Start Quiz" data-placement="bottom" data-toggle="tooltip" href="#" class="QuizPlay" data-val="@ViewBag.QuizEncryptData">
                                    <span> <i class="mdi mdi-play-circle-outline play-icon"></i></span>
                                </a>
                            }
                        </span>
                    </div>
                    <ul class="pull-left mt-md">
                        <li>
                            @Html.Raw(@ViewBag.UserProgress)
                        </li>
                    </ul>
                    <ul class="pull-right article-options">
                        @if (ViewBag.CanShowAllQuestion)
                        {
                            <li>
                                <button type="reset" class="btn btn-default btn-xs btnCustom mtb-xsm SeeAllQuizQuestion" data-original-title="See All Questions" data-placement="bottom" data-toggle="tooltip">See all</button>

                            </li>

                        }
                        @if (ViewBag.IsQuizCompleted)
                        {
                            <li>
                                <a href="#" class="btn btn-default btn-xs btnCustom mtb-xsm QuizReport" data-original-title="Quiz Report" data-placement="bottom" data-toggle="tooltip" data-val="@ViewBag.QuizEncryptData">Quiz Report</a>
                            </li>
                        }
                        else
                        {
                            <li>
                                <a href="#" class="btn btn-default btn-xs btnCustom mtb-xsm QuizPlay" data-original-title="Start Quiz" data-placement="bottom" data-toggle="tooltip" data-val="@ViewBag.QuizEncryptData">Start Quiz</a>
                            </li>
                        }

                    </ul>
                </div>
                <div class="cart-footer">
                    <ul class="nav nav-tabs">
                        <li class="active"><a href="#home" data-toggle="tab">Overview</a></li>


                    </ul>

                    <div class="tab-content">
                        <div class="tab-pane fade in active" id="home">
                            @Html.Raw(ViewBag.QuizDescription)
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
<div aria-hidden="true" aria-labelledby="myModalLabel" role="dialog" tabindex="-1" id="myModal" class="modal fade in">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <a aria-hidden="true" data-dismiss="modal" class="close">×</a>
                <h4 id="myModalLabel" class="modal-title">Entrance Questions</h4>
            </div>
            <div class="modal-body">
                @Html.Raw(ViewBag.Questions)
            </div>
            <div class="modal-footer">
                <button data-dismiss="modal" class="btn btn-default" type="button">Close</button>
            </div>
        </div>
        <!-- /.modal-content -->
    </div>
    <!-- /.modal-dialog -->
</div>
<div id="defaultCountdown" style="display:none"></div>
@(Html.Kendo().Window()
    .Name("popupWindow")
    .Title("Error")
    .Content(@<text>
        <h4>Sorry!! This Quiz has been Expired. </h4>
        <div class="pull-right">
            <button id="Yes" class="k-button">Close</button>
        </div>
    </text>)
    .Draggable()
    .Resizable()
    .Width(600)
    .Visible(false)
    .Actions(actions => actions.Close())
    .Events(ev => ev.Close("onClose"))
)

@(Html.Kendo().Window()
    .Name("PopUpQuestionMandatory")
    .Title("Mandatory Question")
    .Content(@<text>
        <h4>This Question cannot be skipped. </h4>
        <div class="pull-right">
            <button id="ConfirmMandatoryquestion" class="k-button">Ok</button>
        </div>
    </text>)
    .Draggable()
    .Resizable()
    .Width(600)
    .Visible(false)
    .Actions(actions => actions.Close())
    .Events(ev => ev.Close("onCloseMandatoryQuestion"))
)




