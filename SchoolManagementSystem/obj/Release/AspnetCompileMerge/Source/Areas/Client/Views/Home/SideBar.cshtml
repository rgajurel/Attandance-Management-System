
<script src="~/Content/JS/FrontEnd/sideBarClick.js"></script>
<div class="sidebar sidebar-main">
    <div class="sidebar-content">
        <div class="sidebar-category sidebar-category-visible">
            <div class="category-content no-padding">
                <ul class="navigation navigation-main navigation-accordion">

                    <li class="">
                        <a href="#" class="has-ul active">
                            <i class="fa fa-home" aria-hidden="true"></i>
                            <span>Dashboard</span><span class="pull-right"><i class="fa fa-angle-right"></i></span>
                        </a>
                        <ul class="hidden-ul" style="display: none;">
                            <li>@Html.ActionLink("DashBoard", "Parents", "Parents", new { Area = "Client" }, null)</li>
                        </ul>
                    </li>
                    <li class="">
                        <a href="#" class="has-ul active">
                            <i class="fa fa-book" aria-hidden="true"></i>
                            <span>Result</span><span class="pull-right"><i class="fa fa-angle-right"></i></span>
                        </a>
                        <ul class="hidden-ul" style="display: none;" id="StudentsResult">

                            @try
                            {
                                foreach (var students in ViewBag.StudentsMenu)
                                {
                                    string studentName = students.StudentName;                                    
                                    <li><a href="#" onclick="getTerms('@students.Id','@students.AcademicYear','@studentName','@students.Faculty','@students.Class','@students.Section')">@studentName</a></li>
                                }
                            }
                            catch { }

                        </ul>
                    </li>
                    <li class="">
                        <a href="#" class="has-ul active">
                            <i class="fa fa-calculator" aria-hidden="true"></i>
                            <span>Fee Details</span><span class="pull-right"><i class="fa fa-angle-right"></i></span>
                        </a>
                        <ul class="hidden-ul" style="display:none;" id="StudentsFee">
                            @try
                            {
                                foreach (var students in ViewBag.StudentsMenu)
                                {
                                    string studentName = students.StudentName;
                                    <li><a href="#" onclick="findFeeDetails('@students.Id','@students.AcademicYear','@studentName')">@studentName</a></li>

                                }
                            }
                            catch { }
                        </ul>
                    </li>

                    <li class="">
                        <a href="#" class="has-ul active">
                            <i class="fa fa-user" aria-hidden="true"></i>
                            <span>Students Profile</span><span class="pull-right"><i class="fa fa-angle-right"></i></span>
                        </a>
                        <ul class="hidden-ul" style="display:none;" id="StudentsProfile">
                            @try
                            {
                                foreach (var students in ViewBag.StudentsMenu)
                                {
                                    string studentName = students.StudentName;
                                    <li><a href="#" onclick="findStudent('@students.Id','@studentName')">@studentName</a></li>
                                }
                            }catch { }
                        </ul>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>


