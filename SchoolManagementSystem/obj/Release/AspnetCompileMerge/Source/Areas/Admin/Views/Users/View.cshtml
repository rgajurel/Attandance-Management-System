@model DomainEntities.User
@using Kendo.Mvc.UI
<script src="~/Content/JS/BackEnd/Users.js"></script>
<script src="~/Scripts/jquery.validate.min.js"></script>
<script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>

<div class="row">
    <div class="col-md-12">
        <ol class="breadcrumb">
            <li><i class="fa fa-home"></i><a href="/Admin/SchoolInformation">HR/Payroll</a></li>
            <li><a href="/Admin/Users">Manage User Registration</a></li>
            <li class="pull-right"><button class="btn btn-danger add" type="submit">Create New</button></li>
        </ol>
    </div>
</div>
<div id="showUsers" style="margin-top:10px">
    <div style="margin-top:10px">@Html.Partial("~/Areas/Admin/Views/Users/UsersList.cshtml")</div>
</div>

<div id="saveContainer" style="display:none">
    @using (Html.BeginForm("", "", FormMethod.Post, new { enctype = "multipart/form-data", id = "formUserSave", name = "formUserSave", onsubmit = "return false;" }))
    {
        @Html.HiddenFor(model => model.EmployeeID)
        @Html.HiddenFor(model => model.ID, new { Value = "0" })
        <div class="row">
            <div class="col-lg-12">
                <div class="panel panel-default">
                    <div class="panel-heading">
                        Add User
                    </div>
                    <!-- /.panel-heading -->
                    <div class="panel-body">
                        <!-- Nav tabs -->
                        <ul class="nav nav-tabs" id="userEditTabs">
                            <li class="active">
                                <a href="#userCrendentialsTab2" data-toggle="tab" id="userCrendentials-tabLink2">User Credentials</a>
                            </li>
                            <li>
                                <a href="#userGroupTab2" data-toggle="tab" id="userGroup-tabLink2">User Group</a>
                            </li>
                            <li>
                                <a href="#userRoleTab2" data-toggle="tab" id="userRole-tabLink2">User Role</a>
                            </li>
                        </ul>

                        <!-- Tab panes -->
                        <div class="tab-content">
                            <div class="tab-pane fade in active" id="userCrendentialsTab2">

                                @Html.AntiForgeryToken()
                                <div class="col-lg-12">
                                    <br />

                                    <div class="row">
                                        <div class="col-lg-2">
                                            <label>
                                                @Html.CheckBoxFor(model => model.IsSuperAdmin)
                                                Is Super User
                                            </label>
                                        </div>
                                        <div class="col-lg-2">
                                            <label>
                                                @Html.CheckBoxFor(model => model.IsAdmin)
                                                Is Admin User
                                            </label>
                                        </div>
                                        <div class="col-lg-2">
                                            <label>
                                                @Html.CheckBoxFor(model => model.IsClientUser)
                                                Is Employee User
                                            </label>
                                        </div>
                                        @*<div class="col-lg-2">
                                                <label>
                                                    @Html.CheckBoxFor(model => model.IsParentUser)
                                                    Is Parent User
                                                </label>
                                            </div>

                                            <div class="col-lg-2">
                                                <label>
                                                    @Html.CheckBoxFor(model => model.IsStudentUser)
                                                    Is Student User
                                                </label>
                                            </div>*@

                                    </div>
                                    <br />
                                    <div class="row">

                                        <div class="col-md-3">

                                            @Html.LabelFor(model => model.OrganisationID)<span style="color:red">*</span>
                                            @Html.DropDownListFor(model => model.OrganisationID, (SelectList)ViewBag.allOrganisation, "--Organisation--", new { @class = "form-control", required = "required" })
                                            @Html.ValidationMessageFor(model => model.OrganisationID, String.Empty, new { @class = "text-danger" })
                                        </div>

                                        <div class="col-lg-3">
                                            @Html.LabelFor(model => model.Name, new { @style = "" })<span style="color:red">*</span>
                                            @(Html.Kendo().AutoCompleteFor(model => model.Name)
          .Name("Name")
          .DataTextField("Name")
          .Filter("contains")
          .Placeholder("Search by Name")
           .Events(events => events.Select("EmployeeSelect"))
          .MinLength(0)
          .HtmlAttributes(new { style = "width:100%" })
          .DataSource(source =>
          {
              source.Read(read =>
              {
                  read.Action("AutoComplete", "Users")
                      .Data("onAdditionalData");
              })
              .ServerFiltering(true);
          })
                                            )
                                            @Html.ValidationMessageFor(model => model.Name, String.Empty, new { @class = "text-danger" })
                                        </div>

                                        <div class="col-lg-3">
                                            <div class="form-group">
                                                @Html.LabelFor(model => model.Email, new { @style = "" })<span style="color:red">*</span>

                                                @Html.TextBoxFor(model => model.Email, new { @class = "email form-control" })
                                                @Html.ValidationMessageFor(model => model.Email, String.Empty, new { @class = "text-danger" })
                                            </div>
                                        </div>

                                        <div class="col-lg-3">
                                            <div class="form-group">
                                                @Html.LabelFor(model => model.UserName, new { @style = "" })<span style="color:red">*</span>

                                                @Html.TextBoxFor(model => model.UserName, new { @class = "form-control" })
                                                @Html.ValidationMessageFor(model => model.UserName, String.Empty, new { @class = "text-danger" })
                                            </div>

                                        </div>


                                    </div>
                                    <div class="row">
                                        <div class="col-lg-3">
                                            @Html.LabelFor(model => model.Password, new { @style = "" })<span style="color:red">*</span>

                                            @Html.PasswordFor(model => model.Password, new { @class = "form-control" })
                                            @Html.ValidationMessageFor(model => model.Password, String.Empty, new { @class = "text-danger" })
                                        </div>
                                        <div class="col-lg-3">
                                            @Html.LabelFor(model => model.ConformPassword, new { @style = "" })<span style="color:red">*</span>

                                            @Html.PasswordFor(model => model.ConformPassword, new { @class = "form-control" })
                                            @Html.ValidationMessageFor(model => model.ConformPassword, String.Empty, new { @class = "text-danger" })
                                        </div>
                                        <div class="col-lg-3">
                                            @Html.LabelFor(model => model.UserID, new { @style = "" })<span style="color:red">*</span>

                                            @Html.TextBoxFor(model => model.UserID, new { @class = "form-control" })
                                            @Html.ValidationMessageFor(model => model.UserID, String.Empty, new { @class = "text-danger" })
                                        </div>

                                        <div class="form-group col-sm-3">
                                            @Html.LabelFor(model => model.Status)<span style="color:red">*</span>
                                            @Html.DropDownListFor(model => model.Status,
new SelectList(new List<SelectListItem> {
                 new SelectListItem { Text = "Active", Value = "1" },
                 new SelectListItem { Text = "InActive", Value = "0" }
}, "Value", "Text"), new { @class = "form-control" })

                                            @Html.ValidationMessageFor(model => model.Status, String.Empty, new { @class = "text-danger" })
                                        </div>
                                    </div>



                                </div>

                            </div>

                            <div class="tab-pane fade" id="userGroupTab2">
                                <p id="errorMessageUserSave" class="txtRed text-center"></p>
                                <h4>Group list</h4>
                                <p class="user-group-list"><input type="checkbox" class="is-ldap-user" />a1group</p>
                            </div>

                            <div class="tab-pane fade" id="userRoleTab2">
                                <p id="errorMessageUserRoleSave" class="txtRed text-center"></p>
                                <h4>Role list</h4>

                                <p class="user-role-list">
                                    <input type="checkbox" class="is-ldap-user" />a1Role
                                </p>

                            </div>

                        </div>
                    </div>
                    <!-- /.panel-body -->
                </div>
                <!-- /.panel -->
            </div>
            <!-- /.col-lg-6 -->
        </div>
        <div class="row">
            <div class="col-lg-12">
                <button data-id="0" type="submit" value="Save" class="save-user btn btn-danger">Save</button>
                <button class="btn" id="btnCancelUpdateUser">Cancel</button>

            </div>
            <!-- /.col-lg-4 -->
        </div>
    }
</div>