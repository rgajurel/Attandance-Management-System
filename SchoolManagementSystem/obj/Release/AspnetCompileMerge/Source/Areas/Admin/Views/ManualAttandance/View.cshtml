
@model DomainEntities.Attandance
@using Kendo.Mvc.UI
<script src="~/Scripts/jquery.validate.min.js"></script>
<script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>
<script src="~/Content/JS/BackEnd/ManualAttandance.js"></script>


<div class="row">
    <div class="col-md-12">
        <ol class="breadcrumb">
            <li><i class="fa fa-home"></i><a href="/Admin/AccumulativeLeave">HR/Payroll</a></li>
            <li><a href="/Admin/AccumulativeLeave">Manual Attandance</a></li>
            <li class="pull-right"><button class="btn btn-danger create" type="submit">Create New</button></li>
        </ol>
    </div>
</div>
<div style="display:none" id="hide">
    <div class="content">
        <div class="row">
            <div class="col-sm-12">
                <div class="panel panel-default">
                    <div class="panel-heading">
                        <h4 class="panel-title">Accumulative Leave Entry</h4>
                    </div>                  
                    <div class="panel-body">
                        <div class="col-sm-12">
                            @using (Html.BeginForm("", "", FormMethod.Post, new { enctype = "multipart/form-data", autocomplete="off",id = "formTakeLeave", name = "formTakeLeave", onSubmit = "return false;" }))
                            {
                                @Html.AntiForgeryToken()
                                <div class="row">
                                    <div class="form-group">

                                        <div class="col-md-3">
                                            @Html.HiddenFor(model => model.ID)
                                            @Html.LabelFor(model => model.OrganisationID)<span style="color:red">*</span>
                                            @Html.DropDownListFor(model => model.OrganisationID, Enumerable.Empty<SelectListItem>(), "--Organisation--", new { @class = "form-control", required = "required" })
                                            @Html.ValidationMessageFor(model => model.OrganisationID, String.Empty, new { @class = "text-danger" })
                                        </div>
                                        <div class="col-md-3">
                                            @Html.LabelFor(model => model.EmployeeID)<span style="color:red">*</span>
                                            @Html.DropDownListFor(model => model.EmployeeID, Enumerable.Empty<SelectListItem>(), "--Select--", new { @class = "form-control" })
                                            @Html.ValidationMessageFor(model => model.EmployeeID, String.Empty, new { @class = "text-danger" })
                                        </div>
                                        <div class="col-md-3">
                                            @Html.LabelFor(model => model.Year)<span style="color:red">*</span>
                                            @Html.DropDownListFor(model => model.Year, (SelectList)ViewBag.sessionList, new { @class = "form-control" })
                                            @Html.ValidationMessageFor(model => model.Year, String.Empty, new { @class = "text-danger" })
                                        </div>
                                        <div class="col-md-3">
                                            @Html.LabelFor(model => model.Month)<span style="color:red">*</span>
                                            @Html.DropDownListFor(model => model.Month, ViewBag.monthList as SelectList, new { @class = "form-control" })
                                            @Html.ValidationMessageFor(model => model.Month, String.Empty, new { @class = "text-danger" })
                                        </div>

                                    </div>
                                </div>

                                                <div class="row">
                                                    <div class="form-group">


                                                        <div class="col-md-3 nepalishow">
                                                            @Html.LabelFor(model => model.NepaliDateFrom)
                                                            @Html.TextBoxFor(model => model.NepaliDateFrom, new { @class = "form-control" })

                                                            @Html.ValidationMessageFor(model => model.NepaliDateFrom, String.Empty, new { @class = "text-danger" })
                                                        </div>
                                                        <div class="col-md-3 englishshow">
                                                            @Html.LabelFor(model => model.DateFrom)
                                                            @(Html.Kendo().DateTimePickerFor(m => m.DateFrom)
                                                            .Name("DateFrom")
                                                            .Value(DateTime.Now)
                                                            .Format("yyyy-MM-dd")
                                                            .HtmlAttributes(new { @class = "form-control" })
                                                            )
                                                            @Html.ValidationMessageFor(model => model.DateFrom, String.Empty, new { @class = "text-danger" })
                                                        </div>
                                                        <div class="col-md-3 nepalishow">
                                                            @Html.LabelFor(model => model.NepaliDateTo)
                                                            @Html.TextBoxFor(model => model.NepaliDateTo, new { @class = "form-control" })
                                                            @Html.ValidationMessageFor(model => model.NepaliDateTo, String.Empty, new { @class = "text-danger" })
                                                        </div>
                                                        <div class="col-md-3 englishshow">
                                                            @Html.LabelFor(model => model.DateTo)
                                                            @(Html.Kendo().DateTimePickerFor(m => m.DateTo)
                                                            .Name("DateTo")
                                                            .Value(DateTime.Now)
                                                            .Format("yyyy-MM-dd")
                                                            .HtmlAttributes(new { @class = "form-control" })
                                                            )
                                                            @Html.ValidationMessageFor(model => model.DateTo, String.Empty, new { @class = "text-danger" })
                                                        </div>
                                                        <div class="col-md-3">
                                                            @Html.LabelFor(model => model.LeaveDaysID)<span style="color:red">*</span>
                                                            @Html.DropDownListFor(model => model.LeaveDaysID, Enumerable.Empty<SelectListItem>(), "--Select--", new { @class = "form-control" })
                                                            @Html.ValidationMessageFor(model => model.LeaveDaysID, String.Empty, new { @class = "text-danger" })
                                                        </div>
                                                        <div class="col-md-3">
                                                            @Html.LabelFor(model => model.Days)<span style="color:red">*</span>
                                                            @Html.TextBoxFor(model => model.Days, new { @class = "form-control" })
                                                            @Html.ValidationMessageFor(model => model.Days, String.Empty, new { @class = "text-danger" })
                                                        </div>

                                                    </div>
                                                </div>

                                                <div class="row">
                                                    <div class="form-group">                                                     
                                                        <div class="col-md-3">
                                                            @Html.LabelFor(model => model.EntryTime)<span style="color:red">*</span>
                                                            @Html.TextBoxFor(model => model.EntryTime, new { @class = "form-control" })
                                                            @Html.ValidationMessageFor(model => model.EntryTime, String.Empty, new { @class = "text-danger" })
                                                        </div>

                                                        <div class="col-md-3">
                                                            @Html.LabelFor(model => model.ExitTime)<span style="color:red">*</span>
                                                            @Html.TextBoxFor(model => model.ExitTime, new { @class = "form-control" })
                                                            @Html.ValidationMessageFor(model => model.ExitTime, String.Empty, new { @class = "text-danger" })
                                                        </div>

                                                        <div class="col-md-3">
                                                            @Html.LabelFor(model => model.Status)
                                                            @Html.DropDownListFor(model => model.Status,
new SelectList(new List<SelectListItem> {
                 new SelectListItem { Text = "Present", Value = "4" },
                 new SelectListItem { Text = "Absent", Value = "5" }
}, "Value", "Text"), new { @class = "form-control" })


                                                            @Html.ValidationMessageFor(model => model.Status, String.Empty, new { @class = "text-danger" })



                                                        </div>
                                                    </div>


                                                </div>

                                                <div class="row">
                                                    <div class="form-group">


                                                        <div class="col-md-12">
                                                            @Html.LabelFor(model => model.Description)
                                                            @Html.TextBoxFor(model => model.Description, new { @class = "form-control" })
                                                            @Html.ValidationMessageFor(model => model.Description, String.Empty, new { @class = "text-danger" })
                                                        </div>
                                                        
                                                    </div>
                                                </div>
                                                <div class="row">                                                   
                                                        <div class="col-md-4" style="margin-top:10px">
                                                            <input class="btn btn-danger " name="takeLeaveSubmit" id="takeLeaveSubmit" value="Save" type="submit" />
                                                            <button type="button" class="btn cancel" name="Cancel">Cancel</button>                                                          
                                                      
                                                    </div>
                                                </div>

                            }
                        </div>
                    </div>
                </div>

            </div>

        </div>

    </div>
</div>
          


<div class="row" id="show">
    <div class="col-md-12">
        @Html.Partial("~/Areas/Admin/Views/ManualAttandance/ManualAttandanceList.cshtml")
    </div>
</div>

<style>
    #Description {
        height: 50px;
    }
</style>