


@using Kendo.Mvc.UI
@(Html.Kendo().Grid<DomainEntities.LangaugeParameter>()
    .Name("LangaugeParmeterGrid")
            .Columns(columns =>
            {
                columns.Bound(c => c.ID).Hidden();
                columns.Bound(c => c.SN).Title("S.N").Width(20);
                columns.Bound(c => c.Language).Title("Language").Width(150);
                columns.Bound(c => c.Page).Title("Page").Width(150);
                columns.Bound(c => c.Key).Title("Original(Key)").Width(150);
                columns.Bound(c => c.TranslatedWord).Title("Translated Word").Width(150);
                columns.Bound(c => c.OriginalWordInEnglish).Title("Original Word(English)").Width(150);

                columns.Command(command =>
                {
                    command.Custom("Edit").Text(" ").Click("Edit");
                   // command.Custom("Delete").Text(" ").Click("Delete");

                }).Width(50).Title("Action");

            })


                     @*.ToolBar(toolbar =>
                     {
                         toolbar.Template(@<text>


        <div class="right-inner-addon" style="width:200px">

            <input type="search"
                   class="form-control"
                   placeholder="Search By Language" id="FieldFilter" />

        </div>
                    </text>);
                     })*@


                    //.Filterable()
                    //.Sortable(sortable => sortable
                    // .AllowUnsort(true)
                    // .SortMode(GridSortMode.MultipleColumn))
                    .Pageable(
              page => page.Refresh(true)
             .PageSizes(new int[] { 10, 20, 40, 60, 80, 100 })
              .PreviousNext(true))

            .Reorderable(reorder => reorder.Columns(true))
                    .DataSource(dataSource => dataSource
                        .Ajax()
                        .ServerOperation(false)
                                .Model(model =>
                                {
                                    model.Id(p => p.ID);
                                    model.Field(p => p.LanguageID).Editable(false);

                                })
                  .Read(read => read.Action("GetAll", "LanguageParameter"))// Action invoked when the user saves a new data item
                  .PageSize(10)
             )
.Events(ev => ev.DataBound("resetRowNumber"))

)








