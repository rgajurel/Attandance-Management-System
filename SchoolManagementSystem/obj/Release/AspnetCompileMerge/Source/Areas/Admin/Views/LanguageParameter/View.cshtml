
@model DomainEntities.LangaugeParameter
<script src="~/Scripts/jquery.validate.min.js"></script>
<script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>
<script src="~/Content/JS/BackEnd/LanguageParameter.js"></script>
<div class="row">
    <div class="col-md-12">
        <ol class="breadcrumb">
            <li><i class="fa fa-home"></i><a href="/Admin/SchoolInformation">Settings</a></li>
            <li><a href="/Admin/Language">Language Parameter</a></li>
            <li class="pull-right"><button class="btn btn-danger create" type="submit">Create New</button></li>
        </ol>
    </div>
</div>   



<div style="display:none" id="hide">
    <div class="content">
        <div class="row">
            <div class="col-sm-12">
                <div class="panel panel-default">
                    <div class="panel-heading">
                        <h4 class="panel-title">Language Parameter</h4>
                    </div>
                    <div class="panel-body">
                        <div class="col-lg-12">
                           @using (Html.BeginForm("", "", FormMethod.Post, new { enctype = "multipart/form-data", id = "formLanguageParameter",autocomplete="off", name = "formLanguageParameter", onSubmit = "return false;" }))
                           {
                                @Html.AntiForgeryToken()
                                <div class="row">
                                    <div class="col-md-3">
                                        @Html.HiddenFor(model => model.ID)
                                        @Html.LabelFor(model => model.LanguageID)<span style="color:red">*</span>
                                        @Html.DropDownListFor(model => model.LanguageID, Enumerable.Empty<SelectListItem>(), "--Select--", new { @class = "form-control" })
                                        @Html.ValidationMessageFor(model => model.LanguageID, String.Empty, new { @class = "text-danger" })
                                    </div>
                                    <div class="col-md-3">
                                        @Html.LabelFor(model => model.Page)<span style="color:red">*</span>
                                        @Html.TextBoxFor(model => model.Page, new { @class = "form-control"})
                                        @Html.ValidationMessageFor(model => model.Page, String.Empty, new { @class = "text-danger" })
                                    </div>
                                    <div class="col-md-3">
                                        @Html.LabelFor(model => model.Key)<span style="color:red">*</span>
                                        @Html.TextBoxFor(model => model.Key, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(model => model.Key, String.Empty, new { @class = "text-danger" })
                                    </div>

                                    <div class="col-sm-3">
                                        @Html.LabelFor(model => model.OriginalWordInEnglish)<span style="color:red">*</span>
                                        @Html.TextBoxFor(model => model.OriginalWordInEnglish, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(model => model.OriginalWordInEnglish, String.Empty, new { @class = "text-danger" })

                                    </div>
                                    
                                </div>
                            <div class="row">
                                <div class="col-md-3">
                                    @Html.LabelFor(model => model.TranslatedWord)<span style="color:red">*</span>
                                    @Html.TextBoxFor(model => model.TranslatedWord, new { @class = "form-control" })
                                    @Html.ValidationMessageFor(model => model.TranslatedWord, String.Empty, new { @class = "text-danger" })
                                </div>
                                <div class="col-md-4" style="margin-top:28px">                                   
                                        <input class="btn btn-danger" name="Save" id="Save" value="Save" type="submit">
                                        <button type="button" class="btn cancel" name="Cancel">Cancel</button>                                    
                                </div>
                            </div>
                            }
                        </div>

                    </div>

                </div>
            </div>

        </div>

    </div>
</div> 
     

<div class="row" id="show">
    <div class="col-md-12">
       @Html.Partial("~/Areas/Admin/Views/LanguageParameter/LanguageParameterList.cshtml")
    </div>
</div>  