

@model DomainEntities.Class

<script src="~/Content/vendor/multiselectdropdown/js/jquery.sumoselect.js"
        type="text/javascript"></script>
<link href="~/Content/vendor/multiselectdropdown/css/dropdownliststyle.css"
      rel="stylesheet" type="text/css" />
<script src="~/Scripts/jquery.validate.min.js"></script>
<script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>
<script src="~/Content/JS/BackEnd/Class.js"></script>
<div class="row">
    <div class="col-md-12">
        <ol class="breadcrumb">
            <li><i class="fa fa-home"></i><a href="/Admin/SchoolInformation">Students</a></li>
            <li><a href="/Admin/OrganisationType">Class/Faculty</a></li>
            <li class="pull-right"><button class="btn btn-danger create" type="submit">Create New</button></li>
        </ol>
    </div>
</div>  

<div style="display:none" id="hide">
    <div class="content">
        <div class="row">
            <div class="col-sm-12">
                <div class="panel panel-default">
                    <div class="panel-heading">
                        <h4 class="panel-title">Class Faculty</h4>
                    </div>
                    <div class="panel-body">
                        <div class="col-sm-12">
                            @using (Html.BeginForm("", "", FormMethod.Post, new { enctype = "multipart/form-data", id = "formClass", name = "formClass",autocomplete="off", onSubmit = "return false;" }))
                            {
                                @Html.AntiForgeryToken()
                                <div class="row">

                                    <div class="col-md-3">
                                        @Html.HiddenFor(model => model.ID)
                                        @Html.LabelFor(model => model.ClassTypeID)<span style="color:red">*</span>
                                        @Html.DropDownListFor(model => model.ClassTypeID, (SelectList)ViewBag.classTypeList, "--Select--", new { @class = "form-control", required = "required" })
                                        @Html.ValidationMessageFor(model => model.ClassTypeID, String.Empty, new { @class = "text-danger" })
                                    </div>
                                    <div class="col-md-3">
                                        @Html.LabelFor(model => model.ClassID)<span style="color:red">*</span>
                                        @Html.DropDownListFor(model => model.ClassID, (SelectList)ViewBag.classList, "--Select--", new { @class = "form-control", required = "required" })
                                        @Html.ValidationMessageFor(model => model.ClassID, String.Empty, new { @class = "text-danger" })
                                    </div>
                                    <div class="col-md-3">
                                        @Html.LabelFor(model => model.FacultyID)<span style="color:red">*</span>
                                        @Html.DropDownListFor(model => model.FacultyID, (SelectList)ViewBag.facultyList, "--Select--", new { @class = "form-control" })
                                        @Html.ValidationMessageFor(model => model.FacultyID, String.Empty, new { @class = "text-danger" })
                                    </div>
                                    <div class="col-md-3">
                                        @Html.LabelFor(model => model.SectionID)<span style="color:red">*</span>
                                        @Html.DropDownListFor(model => model.SectionID, (SelectList)ViewBag.sectionList, new { @class = "form-control", @multiple = "multiple" })
                                        <span style="color:red" id="SectionIDs"></span>
                                    </div>

                                </div>

                                <div class="row">
                                    <div class="col-md-3" style="margin-top:10px">
                                        <input class="btn btn-danger" name="Save" id="Save" value="Save" type="submit">
                                        <button type="button" class="btn cancel" name="Cancel">Cancel</button>

                                    </div>
                                </div>
                                   

                            }

                        </div>

                    </div>

                </div>
            </div>

        </div>

    </div>
</div> 



<div class="row" id="show">
    <div class="col-md-12">
        @Html.Partial("~/Areas/Admin/Views/Class/ClassList.cshtml")
    </div>
</div>  
