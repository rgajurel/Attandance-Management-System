@model DomainEntities.UserLogin
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Welcome</title>
    <link rel="icon" href="~/Content/Images/School/attandance.png" type="image/x-icon" />  
    <link rel='stylesheet prefetch' href='~/Content/vendor/css/font-awesome.css'>
    <link href="~/Content/CSS/style.css" rel="stylesheet" />
     </head>

<body>
    <div class="container">
        <div class="info">

        </div>
    </div>
    <div class="form">
                <div class="thumbnail"><img src="~/Content/Images/School/attandance.png" /></div>
        <div class="text-center" style="margin-bottom:10px;color:#EF3B3A;font-weight:bold">Attendance Management System</div>
        @using (Html.BeginForm("Login", "Login", new { ReturnUrl = ViewBag.ReturnUrl }, FormMethod.Post, new { enctype = "multipart/form-data",autocomplete="off" }))
        {
            @Html.AntiForgeryToken()

            <div class="row">
                <div class="col-lg-12">
                    <div class="form-group">
                        @Html.ValidationMessageFor(model => model.UserName, String.Empty, new { @style = "color:#ef3b3a" })
                        @Html.TextBoxFor(model => model.UserName, new { @class = "form-control", @Required = "Required", placeholder = "Enter UserName" })
                      
                    </div>
                </div>
                <div class="col-lg-12">
                    <div class="form-group">  
                        @Html.ValidationMessageFor(model => model.Password, String.Empty, new { @style = "color:#ef3b3a" })                    
                        @Html.PasswordFor(model => model.Password, new { @class = "form-control", @Required = "Required", Placeholder = "Enter Password" })
                       
                    </div>
                </div>
              

    </div>
                <button>Login</button>
                <p class="message" style="font-weight:bold">Forgot Password? <a style="font-weight:bold" href="#">Reset</a></p>
                <div class="col-lg-12">
                    <h5 style="text-align:center;color:#ef3b3a">@TempData["Success"]</h5>
                    <h5 style="text-align:center;color:#ef3b3a">@TempData["error"]</h5>
                    <h5 style="text-align:center;color:#ef3b3a">@TempData["login"]</h5>
                </div>
        }
            </div>
    <script src="~/Scripts/jquery-1.10.2.js"></script>
    <script src="~/Scripts/jquery.validate.min.js"></script>
    <script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>








</body>

</html>
<style>
    .form .thumbnail
     {
        background: #EF3B3A;
        background-image: initial;
        background-position-x: initial;
        background-position-y: initial;
        background-size: initial;
        background-repeat-x: initial;
        background-repeat-y: initial;
        background-attachment: initial;
        background-origin: initial;
        background-clip: initial;
        background-color: rgb(239, 59, 58);
        width: 152px;
        height: 146px;
        margin: 0 auto 30px;
        padding: 35px 30px;
        border-top-left-radius: 100%;
        border-top-right-radius: 100%;
        border-bottom-left-radius: 100%;
        border-bottom-right-radius: 100%;
        box-sizing: border-box;
    }
    .text-danger{
        color:orangered;
    }
    body:before{
        background: rgba(174, 63, 63, 0.8);
    }
</style>