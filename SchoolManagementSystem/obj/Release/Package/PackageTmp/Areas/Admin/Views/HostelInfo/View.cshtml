
@model DomainEntities.HostelInfo
<script src="~/Scripts/jquery.validate.min.js"></script>
<script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>
<script src="~/Content/JS/BackEnd/HostelInfo.js"></script>
<div class="page-header">
    <div class="breadcrumb-line">
        <ul class="breadcrumb">
            <li>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<i class="fa fa-home position-left"></i>Home</li>
            <li>Instiution</li>
            <li class="active">Hostel Details</li>
        </ul>
    </div>
</div>
<div class="row">
    <div class="content">
        <h6 class="content-group text-semibold"></h6>
        <div class="row">
            <div class="col-md-12">
                <div class="panel panel-flat">
                    <div class="panel-heading">                       
                        <div class="panel-body">
                            <div class="row">
                                <div class="col-lg-12">
                                    <div class="panel panel-flat">                                        
                                        <div class="panel-body">
                                            @using (Html.BeginForm("", "", FormMethod.Post, new { enctype = "multipart/form-data", id = "formHostelInfo", name = "formHostelInfo", onSubmit = "return false;" }))
                                            {
                                                @Html.AntiForgeryToken()
                                                <div class="form-group">
                                                    <div class="row">
                                                        <div class="col-md-4">
                                                            @Html.HiddenFor(model => model.ID)
                                                            @Html.LabelFor(model => model.HostelName)<span style="color:red">*</span>
                                                            @Html.TextBoxFor(model => model.HostelName, new { @class = "form-control" })
                                                            @Html.ValidationMessageFor(model => model.HostelName, String.Empty, new { @class = "text-danger" })
                                                        </div>
                                                        <div class="col-md-4">

                                                            @Html.LabelFor(model => model.Address)<span style="color:red">*</span>
                                                            @Html.TextBoxFor(model => model.Address, new { @class = "form-control" })
                                                            @Html.ValidationMessageFor(model => model.Address, String.Empty, new { @class = "text-danger" })
                                                        </div>
                                                        <div class="col-md-4">
                                                            @Html.LabelFor(model => model.ContactNo)<span style="color:red">*</span>
                                                            @Html.TextBoxFor(model => model.ContactNo, new { @class = "form-control" })
                                                            @Html.ValidationMessageFor(model => model.ContactNo, String.Empty, new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="form-group">
                                                    <div class="row">
                                                        <div class="col-md-4">
                                                            @Html.LabelFor(model => model.PersonIncharge)
                                                            @Html.TextBoxFor(model => model.PersonIncharge, new { @class = "form-control" })
                                                            @Html.ValidationMessageFor(model => model.PersonIncharge, String.Empty, new { @class = "text-danger" })
                                                        </div>
                                                        <div class="col-md-4">
                                                            @Html.LabelFor(model => model.InchargePhoneNo)
                                                            @Html.TextBoxFor(model => model.InchargePhoneNo, new { @class = "form-control" })
                                                            @Html.ValidationMessageFor(model => model.InchargePhoneNo, String.Empty, new { @class = "text-danger" })
                                                        </div>

                                                        <div class="col-md-4" style="margin-top:23px">
                                                            <input class="btn btn-info" name="hostelInfoSubmit" id="hostelInfoSubmit" value="Save" type="submit" />
                                                            <input class="btn" name="hostelInfoCancel" id="hostelInfoCancel" value="Cancel" type="reset">
                                                        </div>
                                                    </div>
                                                </div>                                              
                                                                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <a class="heading-elements-toggle"><i class="icon-menu"></i></a>
                        </div>
                        <a class="heading-elements-toggle"><i class="icon-menu"></i></a>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-12">
        <div class="form-group">
            <div id="schoolTypeList">@Html.Partial("~/Areas/Admin/Views/HostelInfo/HostelInfoList.cshtml")</div>
        </div>
    </div>
</div>