@model DomainEntities.CategoryTree
@{
    ViewBag.Title = "Entrance Category";
    Layout = "~/Views/Shared/AdminLayout.cshtml";
    Html.EnableClientValidation(true);
    Html.EnableUnobtrusiveJavaScript(true);
}




<div id="divCategoryList">
    <div class="row">
        <div class="col-lg-12">
            <div class="pageHeaderBox11">
                <h1 class="page-header">Entrance Question Category</h1>
                @*@if (ViewBag.createAccess)
                    {*@
                <div class="pull-right">
                    <button type="submit" class="btn btn-default btnCustom" id="btnCreateCategory">Create Entrance Question Category</button>
                </div>
                @*}*@
            </div>
        </div>
        <!-- /.col-lg-12 -->
    </div>
    <div class="row">


        <div class="form-group">
            <div class="col-md-3">
                <label>Key Words</label>
                <input class="form-control" id="txtSearchKeyword" placeholder="Enter Search Keywords">
            </div>
            <div class="col-md-3">
                <div class="form-group mdl-selectfield">
                    <label>Status</label>
                    @Html.DropDownList("ddlStatus", new SelectList(new List<SelectListItem> {
                 new SelectListItem { Text = "Active", Value = "Active" },
                 new SelectListItem { Text = "InActive", Value = "Inactive" }
}, "Value", "Text"), " All Status", new { @class = "form-control" })
                </div>
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-default btnCustom" id="btnSearchCategory">Search</button>
                <button type="submit" class="btn btn-default btnCancle ResetInputField" id="btnReset">Reset</button>
            </div>
        </div>


        <!-- /.col-lg-4 -->
    </div>
    <div class="row">
        <div class="col-lg-12">
            <div class="table-responsive-scroll">@Html.Partial("/Areas/Admin/Views/EntranceQuestionCategory/EntranceQuestionCategoryTree.cshtml")</div>
        </div>
    </div>
</div>

<div class="row" id="divCategoryForm" style="display:none">
    <div class="col-lg-12">
        <div class="panel panel-default">
            <div class="panel-heading" id="formHeading">
                Add Entrance Question Category
            </div>
            <!-- /.panel-heading -->
            <div class="row panel-body">
                <!-- Nav tabs -->

                @using (Html.BeginForm("", "", FormMethod.Post, new { enctype = "multipart/form-data", id = "formCategory", name = "formCategory", onSubmit = "return false;" }))
                {
                    <div class="col-lg-6 col-md-6">

                        @Html.AntiForgeryToken()
                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                        @Html.HiddenFor(model => model.CategoryTreeID)
                        @Html.HiddenFor(model => model.CategoryType)
                        <div class="form-group mdl-selectfield">
                            @Html.LabelFor(m => m.ParentCategoryID, new { @style = "" })<span class="txtRed"> *</span>
                            @Html.DropDownListFor(model => model.ParentCategoryID, (SelectList)ViewBag.categoryParentList, new { @class = "form-control" })
                            @Html.ValidationMessageFor(model => model.ParentCategoryID, String.Empty, new { @class = "text-danger" })
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(m => m.CategoryName, new { @style = "" })<span class="txtRed"> *</span>
                            @Html.TextBoxFor(model => model.CategoryName, new { @class = "form-control" })
                            @Html.ValidationMessageFor(model => model.CategoryName, String.Empty, new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="col-lg-6 col-md-6">
                        <div class="form-group mdl-selectfield">
                            @Html.LabelFor(m => m.StatusValue, new { @style = "" })<span class="txtRed"> *</span>
                            @Html.DropDownListFor(model => model.StatusValue, new SelectList(new List<SelectListItem> {
                 new SelectListItem { Text = "Active", Value = "1" },
                 new SelectListItem { Text = "InActive", Value = "0" }
}, "Value", "Text"), new { @class = "form-control" })
                            @Html.ValidationMessageFor(model => model.StatusValue, String.Empty, new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="clearfix col-lg-12">
                        <button type="submit" class="btn btn-default btnCustom" id="btnSave">Submit</button>
                        <button type="reset" class="btn btn-default btnCancle" id="btnCancel">Cancel</button>
                    </div>
                }

            </div>

        </div>
        <!-- /.panel -->
    </div>
    <!-- /.col-lg-6 -->
</div>
<div id="popupWindow" class="popup hide">
    <h4>Are you sure you Want to Delete?</h4>
    <div class="pull-right">
        <button id="Yes" class="k-button">Yes</button>
        <button id="No" class="k-button">No</button>
    </div>
</div>
