
@model DomainEntities.Employee
@using Kendo.Mvc.UI
<script src="~/Scripts/jquery.validate.min.js"></script>
<script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>

<script src="~/Content/JS/BackEnd/Employee.js"></script>


<div class="row">
    <div class="col-md-12">
        <ol class="breadcrumb">
            <li><i class="fa fa-home"></i><a href="/Admin/OrganisationInformation">HR/Payroll</a></li>
            <li><a href="/Admin/Employer">Employer Information</a></li>
            <li class="pull-right"><button class="btn btn-danger create" type="submit">Create New</button></li>
        </ol>
    </div>
</div>
<div style="display:none" id="hide">  
    <div class="content">
        <div class="row">
            <div class="col-sm-12">
                <div class="panel panel-default">
                    <div class="panel-heading">
                        <h4 class="panel-title">Employee Profile</h4>
                    </div>
                    @Html.ValidationSummary()
                    <div class="panel-body">
                        <div class="col-sm-12">
                            @using (Html.BeginForm("", "", FormMethod.Post, new { enctype = "multipart/form-data",autocomplete="off", id = "formEmployee", name = "formEmployee", onSubmit = "return false;" }))
                            {
                                @Html.AntiForgeryToken()
                                
                                <div class="row">
                                    <div class="col-md-3">
                                        @Html.LabelFor(model => model.EmpCode)<span style="color:red">*</span>
                                        @Html.TextBoxFor(model => model.EmpCode, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(model => model.EmpCode, String.Empty, new { @class = "text-danger" })

                                    </div>
                                </div>
                                <div class="row">
                                   
                                    @Html.HiddenFor(model => model.ID,new { @Value="0"})
                                   
                                    <div class="col-md-3">

                                        @Html.LabelFor(model => model.Name)<span style="color:red">*</span>
                                        @Html.TextBoxFor(model => model.Name, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(model => model.Name, String.Empty, new { @class = "text-danger" })
                                        
                                    </div>
                                    <div class="col-md-3">
                                        @Html.LabelFor(model => model.Gender)
                                        @Html.DropDownListFor(model => model.Gender,
new SelectList(new List<SelectListItem> {
                 new SelectListItem { Text = "Male", Value = "Male" },
                 new SelectListItem { Text = "Female", Value = "Female" }
}, "Value", "Text"), new { @class = "form-control" })


                                        @Html.ValidationMessageFor(model => model.Gender, String.Empty, new { @class = "text-danger" })
                                    </div>

                                    <div class="col-md-3 nepalishow">
                                        @Html.LabelFor(model => model.NepaliJoioningDate)
                                        @Html.TextBoxFor(model => model.NepaliJoioningDate, new { @class = "form-control" })


                                        @Html.ValidationMessageFor(model => model.NepaliJoioningDate, String.Empty, new { @class = "text-danger" })
                                    </div>
                                    <div class="col-md-3">
                                        @Html.LabelFor(model => model.EnglishJoioningDate)
                                         @(Html.Kendo().DateTimePickerFor(m => m.EnglishJoioningDate)
        .Name("EnglishJoioningDate")
         .Value(DateTime.Now)
         .Format("yyyy-MM-dd")
                                          .HtmlAttributes(new { @class = "form-control" })
                                         )
                                         @Html.ValidationMessageFor(model => model.EnglishJoioningDate, String.Empty, new { @class = "text-danger" })
                                    </div>
                                   
                                    <div class="col-md-3">
                                        @Html.LabelFor(model => model.Qualifications)
                                        @Html.TextBoxFor(model => model.Qualifications, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(model => model.Qualifications, String.Empty, new { @class = "text-danger" })
                                    </div>

                                </div>
                                <div class="row">
                                   
                                    <div class="col-md-3 nepalishow">
                                        @Html.LabelFor(model => model.NepaliDateOfBirth)
                                        @Html.TextBoxFor(model => model.NepaliDateOfBirth, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(model => model.NepaliDateOfBirth, String.Empty, new { @class = "text-danger" })
                                    </div>
                                   
                                    <div class="col-md-3 englishshow">

                                        @Html.LabelFor(model => model.EnglishDateOfBirth)
                                        @(Html.Kendo().DateTimePickerFor(m => m.EnglishDateOfBirth)
                                        .Name("EnglishDateOfBirth")
                                        .Value(DateTime.Now)
                                        .Format("yyyy-MM-dd")
                                        .HtmlAttributes(new { @class = "form-control" })
                                        )
                                        @Html.ValidationMessageFor(model => model.EnglishDateOfBirth, String.Empty, new { @class = "text-danger" })
                                    </div>
                                    

                                    
                                                                   

                                    <div class="col-md-3">
                                        @Html.LabelFor(model => model.Email)
                                        @Html.TextBoxFor(model => model.Email, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(model => model.Email, String.Empty, new { @class = "text-danger" })
                                    </div>
                                    <div class="col-md-3">
                                        @Html.LabelFor(model => model.MobileNo)
                                        @Html.TextBoxFor(model => model.MobileNo, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(model => model.MobileNo, String.Empty, new { @class = "text-danger" })
                                    </div>
                                    <div class="col-md-3">
                                        @Html.LabelFor(model => model.PhoneNo)
                                        @Html.TextBoxFor(model => model.PhoneNo, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(model => model.PhoneNo, String.Empty, new { @class = "text-danger" })
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-3">
                                        @Html.LabelFor(model => model.UserID)<span style="color:red">*</span>
                                        @Html.TextBoxFor(model => model.UserID, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(model => model.UserID, String.Empty, new { @class = "text-danger" })
                                    </div>
                                    <div class="col-md-3">
                                        @Html.LabelFor(model => model.JobTypeID)<span style="color:red">*</span>
                                        @Html.DropDownListFor(model => model.JobTypeID, (SelectList)ViewBag.jobType, "--JobType--", new { @class = "form-control" })
                                        @Html.ValidationMessageFor(model => model.JobTypeID, String.Empty, new { @class = "text-danger" })
                                    </div>

                                    <div class="col-md-3">
                                        @Html.LabelFor(model => model.CitizenshipNo)
                                        @Html.TextBoxFor(model => model.CitizenshipNo, "Select", new { @class = "form-control" })
                                        @Html.ValidationMessageFor(model => model.CitizenshipNo, String.Empty, new { @class = "text-danger" })
                                    </div>

                                    <div class="col-md-3">
                                        <label for="reg_input_logo">Upload Image</label>
                                        <input type="file" id="inputFile" name="inputFile" />
                                    </div>

                                </div>

                                <div class="row">
                                   
                                    <div class="col-md-3">
                                        @Html.LabelFor(model => model.OrganisationID)<span style="color:red">*</span>
                                        @Html.DropDownListFor(model => model.OrganisationID, Enumerable.Empty<SelectListItem>(), "--Organisation--", new { @class = "form-control" })
                                        @Html.ValidationMessageFor(model => model.OrganisationID, String.Empty, new { @class = "text-danger" })
                                    </div>
                                   

                                    <div class="col-md-3">
                                        @Html.LabelFor(model => model.DepartmentID)<span style="color:red">*</span>
                                        @Html.DropDownListFor(model => model.DepartmentID, Enumerable.Empty<SelectListItem>(), "--Department--", new { @class = "form-control" })
                                        @Html.ValidationMessageFor(model => model.DepartmentID, String.Empty, new { @class = "text-danger" })
                                    </div>

                                    <div class="col-md-3">
                                        @Html.LabelFor(model => model.DesignationID)<span style="color:red">*</span>
                                        @Html.DropDownListFor(model => model.DesignationID, Enumerable.Empty<SelectListItem>(), "--Designation--", new { @class = "form-control" })
                                        @Html.ValidationMessageFor(model => model.DesignationID, String.Empty, new { @class = "text-danger" })
                                    </div>

                                    <div class="col-md-3">
                                        @Html.LabelFor(model => model.Status)<span style="color:red">*</span>
                                        @Html.DropDownListFor(model => model.Status,
                                        new SelectList(new List<SelectListItem> {
                                        new SelectListItem { Text = "Active", Value = "Active" },
                                        new SelectListItem { Text = "InActive", Value = "InActive" }
                                        }, "Value", "Text"), new { @class = "form-control" })
                                        @Html.ValidationMessageFor(model => model.Status, String.Empty, new { @class = "text-danger" })
                                    </div> 



                                </div>
                                <div class="row">
                                   

                                  

                                    <div class="col-md-3">
                                        @Html.LabelFor(model => model.EntryTime)<span style="color:red">*</span>
                                        @Html.TextBoxFor(model => model.EntryTime, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(model => model.EntryTime, String.Empty, new { @class = "text-danger" })
                                    </div>

                                    <div class="col-md-3">
                                        @Html.LabelFor(model => model.ExitTime)<span style="color:red">*</span>
                                        @Html.TextBoxFor(model => model.ExitTime, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(model => model.ExitTime, String.Empty, new { @class = "text-danger" })
                                    </div>

                                   


                                </div>
                                <div class="row">
                                 <hr />
                                    <h5 style="font-weight:bold">PERSONNAL DETAILS</h5>
                                    <div class="col-md-3">
                                        @Html.LabelFor(model => model.FatherName)
                                        @Html.TextBoxFor(model => model.FatherName, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(model => model.FatherName, String.Empty, new { @class = "text-danger" })
                                    </div>                                 

                                    <div class="col-md-3">
                                        @Html.LabelFor(model => model.PermanentAddress)
                                        @Html.TextBoxFor(model => model.PermanentAddress, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(model => model.PermanentAddress, String.Empty, new { @class = "text-danger" })
                                    </div>

                                    <div class="col-md-3">
                                        @Html.LabelFor(model => model.TemporaryAddress)
                                        @Html.TextBoxFor(model => model.TemporaryAddress, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(model => model.TemporaryAddress, String.Empty, new { @class = "text-danger" })
                                    </div>                               
                                    
                                </div>

                                <div class="row">
                                    <hr />
                                    <h5 style="font-weight:bold">OTHER DETAILS</h5>

                                    <div class="col-md-3">
                                        @Html.LabelFor(model => model.PANNumber)
                                        @Html.TextBoxFor(model => model.PANNumber, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(model => model.PANNumber, String.Empty, new { @class = "text-danger" })
                                    </div>
                                    <div class="col-md-3">
                                        @Html.LabelFor(model => model.PFNumber)
                                        @Html.TextBoxFor(model => model.PFNumber, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(model => model.PFNumber, String.Empty, new { @class = "text-danger" })
                                    </div>
                                    <div class="col-md-3">
                                        @Html.LabelFor(model => model.CITNumber)
                                        @Html.TextBoxFor(model => model.CITNumber, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(model => model.CITNumber, String.Empty, new { @class = "text-danger" })
                                    </div>

                                    <div class="col-md-3">
                                        @Html.LabelFor(model => model.BankAccountNo)
                                        @Html.TextBoxFor(model => model.BankAccountNo, new { @class = "form-control" })
                                        @Html.ValidationMessageFor(model => model.BankAccountNo, String.Empty, new { @class = "text-danger" })
                                    </div>

                                </div>

                                <div class="row">
                                    <div class="col-md-3" style="margin-top:10px">
                                        <input class="btn btn-danger" name="employeeSubmit" id="employeeSubmit" value="Save" type="submit">
                                        <button type="button" class="btn cancel" name="Cancel">Cancel</button>

                                    </div>
                                </div>
                            }
                        </div>

                    </div>

                </div>
            </div>
        </div>
    </div>
</div>
<div class="row" id="show">
    <div class="col-md-12">
        @Html.Partial("~/Areas/Admin/Views/Employer/EmployerList.cshtml")
    </div>
</div>

<script>
    $('#NepaliJoioningDate').change(function ()
    {
        $('#EnglishJoioningDate').val(BS2AD($('#NepaliJoioningDate').val()));
    });

  
</script>




