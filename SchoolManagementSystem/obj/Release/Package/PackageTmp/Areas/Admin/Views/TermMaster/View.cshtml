

@model DomainEntities.TermMaster

<script src="~/Scripts/jquery.validate.min.js"></script>
<script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>
<script src="~/Content/JS/BackEnd/TermMastertable.js"></script>
<div class="page-header">
    <div class="breadcrumb-line">
        <ul class="breadcrumb">
            <li>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<i class="fa fa-home position-left"></i>Home</li>
            <li>Exam</li>
            <li class="active">Term Master</li>
        </ul>

    </div>
</div>
<div class="row">         
                <!-- rht middle content -->
                <div class="content">
                    <div class="row">
                        <div class="col-lg-12">
                            <div class="panel panel-default">
                                <div class="panel-heading">
                                    <h4 class="panel-title">Add Term Master</h4>
                                </div>
                                <div class="panel-body">
                                    <div class="col-lg-12">
                                        @using (Html.BeginForm("", "", FormMethod.Post, new { enctype = "multipart/form-data", id = "formTermMaster",autocomplete="off", name = "formTermMaster", onSubmit = "return false;" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            <div class="panel-body">
                                                <div class="form-group">
                                                    <div class="row">
                                                        <div class="col-lg-3">
                                                            @Html.HiddenFor(model => model.ID)
                                                            @Html.LabelFor(model => model.TermName)<span style="color:red">*</span>
                                                            @Html.TextBoxFor(model => model.TermName, new { @class = "form-control" })
                                                            @Html.ValidationMessageFor(model => model.TermName, String.Empty, new { @class = "text-danger" })
                                                        </div>
                                                        <div class="col-lg-3">
                                                            @Html.LabelFor(model => model.TermPercentage)<span style="color:red">*</span>
                                                            @Html.TextBoxFor(model => model.TermPercentage, new { @class = "form-control" })
                                                            @Html.ValidationMessageFor(model => model.TermPercentage, String.Empty, new { @class = "text-danger" })
                                                        </div>

                                                       
                                                        <div class="col-md-2">
                                                            <label style="margin-top:28px">Is Final Term</label><span style="color:red">*</span>
                                                            @Html.CheckBoxFor(model => model.IsFinalTerm)
                                                        </div>
                                                        <div class="col-md-3">
                                                            <div class="pulldown">
                                                                <input class="btn btn-danger" name="Save" id="Save" value="Save" type="submit">
                                                                <button type="button" class="btn cancel" name="Cancel">Cancel</button>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    
                                                   
                                                  
                                                  

                                                </div>                                             

                                            </div>
                                        }
                                    </div>                                   
                                </div>
                            </div>                    

                    </div>

                </div>
            </div>
        </div>







<div class="row" id="show">
    <div class="col-md-12">
       @Html.Partial("~/Areas/Admin/Views/TermMaster/TermMasterList.cshtml")
    </div>
</div>  



  
       
                
           
     


