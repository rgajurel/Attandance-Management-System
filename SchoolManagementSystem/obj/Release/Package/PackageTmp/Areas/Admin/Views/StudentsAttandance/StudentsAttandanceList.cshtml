


@using Kendo.Mvc.UI
@(Html.Kendo().Grid<DomainEntities.StudentsAttandance>()
    .Name("StudentsAttadanceList")
            .Columns(columns =>
            {
            columns.Bound(c => c.SN).Title("S.N").Width(10);
            //columns.Bound(p => p.IsAdmin).ClientTemplate("<input type='checkbox' name='chkbx' class='chkbx' ></input>").Title("Check").Width(100);
              columns.Template(@<text></text>).ClientTemplate("<input type='checkbox' #= IsAttend ? checked='checked':'' # class='chkbx' />").Title("Check").Width(40);

                columns.Bound(c => c.ClassID).Hidden();
                columns.Bound(c => c.ID).Hidden();
                columns.Bound(c => c.FacultyID).Hidden();
                columns.Bound(c => c.StudentID).Hidden();
                columns.Bound(c => c.SessionID).Hidden();
                columns.Bound(c => c.Section).Hidden();
                columns.Bound(c => c.StudentName).Title("Student Name").Width(150);
                columns.Bound(c => c.RollNo).Title("Roll No").Width(50);
                columns.Bound(c => c.PresentDays).Title("Present Days").Width(50);
                columns.Bound(c => c.TotalDays).Title("Total Days").Width(50);            


            })


            @*.ToolBar(toolbar =>
                             {
                             toolbar.Template(@<text>


                <div class="right-inner-addon" style="width:200px">

                    <input type="search"
                           class="form-control"
                           placeholder="Search By Name" id="FieldFilter" />

                </div>
                            </text>);
                             })*@
 //.Scrollable())
 //.Selectable()

 .Editable(editable => editable.Mode(GridEditMode.InCell))
                    //.Filterable()
                    //.Sortable(sortable => sortable
                    // .AllowUnsort(true)
                    // .SortMode(GridSortMode.MultipleColumn))
                    .Pageable(
              page => page.Refresh(true)
             .PageSizes(new int[] { 100 })
              .PreviousNext(true))
            //   .PersistSelection(true)
            .Reorderable(reorder => reorder.Columns(true))
            
     .Navigatable()
                    .DataSource(dataSource => dataSource
                        .Ajax()

                        .ServerOperation(false)
                                .Model(model =>
                                {
                                    model.Id(p => p.SN);
                                    model.Field(p => p.SN).Editable(false);
                                    model.Field(p => p.StudentName).Editable(false);
                                    model.Field("PresentDays",typeof(int)).Editable(true);
                                    model.Field(p => p.TotalDays).Editable(false);
                                })
                  .Read(read => read.Action("GetAll", "StudentsAttandance").Data("ParamToAttandanceList"))// Action invoked when the user saves a new data item
                    .Events(e => e.Error("onError"))
                  .PageSize(100)

             )

.Events(ev => ev.DataBound("resetRowNumberAttandanceEntryGrid"))

.Events(ev => ev.Save("Save"))


)








