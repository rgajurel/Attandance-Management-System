



@using Kendo.Mvc.UI
@(Html.Kendo().Grid<DomainEntities.GradeMaster>()
    .Name("GradeMasterGrid")
            .Columns(columns =>
            {

                columns.Bound(c => c.ID).Title("S.N").Width(20).Hidden();
                columns.Bound(c => c.SN).Title("S.N").Width(20);
                columns.Bound(c => c.Grade).Title("Grade").Width(150);
                columns.Bound(c => c.GradePoint).Title("Grade Point").Width(150);
                columns.Bound(c => c.MarksFrom).Title("Marks From").Width(150);
                columns.Bound(c => c.MarksTo).Title("Marks To").Width(150);


                //columns.Bound(c => c.Type).Title("Modified On").Width(50).ClientTemplate("#= customDate(data) #").Format(ViewBag.settingDateFormat);

                columns.Command(command =>
                {
                    command.Custom("Edit").Text(" ").Click("Edit");
                    command.Custom("Delete").Text(" ").Click("Delete");

                }).Width(50).Title("Action");

            })


                     @*.ToolBar(toolbar =>
                     {
                         toolbar.Template(@<text>


        <div class="right-inner-addon" style="width:200px">

            <input type="search"
                   class="form-control"
                   placeholder="Search By Name" id="FieldFilter" />

        </div>
                    </text>);
                     })*@


                    //.Filterable()
                    //.Sortable(sortable => sortable
                    // .AllowUnsort(true)
                    // .SortMode(GridSortMode.MultipleColumn))
                    .Pageable(
              page => page.Refresh(true)
             .PageSizes(new int[] { 10, 20, 40, 60, 80, 100 })
              .PreviousNext(true))

            .Reorderable(reorder => reorder.Columns(true))
                    .DataSource(dataSource => dataSource
                        .Ajax()
                        .ServerOperation(false)
                                .Model(model =>
                                {
                                    model.Id(p => p.ID);
                                    model.Field(p => p.Grade).Editable(false);

                                })
                  .Read(read => read.Action("GetAll", "GradeMaster"))// Action invoked when the user saves a new data item
                  .PageSize(10)
             )
.Events(ev => ev.DataBound("resetRowNumber"))

)
</div>







