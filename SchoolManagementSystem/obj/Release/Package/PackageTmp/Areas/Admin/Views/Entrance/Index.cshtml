@model DomainEntities.EntranceEntity
@using Kendo.Mvc.UI
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/AdminLayout.cshtml";
    Html.EnableClientValidation(true);
    Html.EnableUnobtrusiveJavaScript(true);
}

@using (Html.BeginForm("", "", FormMethod.Post, new { @class = "entrance-form" }))
{
    @Html.AntiForgeryToken()
    <div class="row" id="divEntranceForm" style="display:none">
        <div class="col-lg-12">
            <div class="panel panel-default">
                <div class="panel-heading" id="formHeading">
                    Add Entrance
                </div>
                <!-- /.panel-heading -->
                <div class="row panel-body">

                    @Html.HiddenFor(Model => Model.EntranceID)
                    <div class="col-lg-6 col-md-6">
                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                        <div class="form-group">
                            @Html.LabelFor(model => model.EntranceTitle, "Entrance Title")<span class="txtRed"> *</span>
                            @Html.EditorFor(model => model.EntranceTitle, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.EntranceTitle, "", new { @class = "text-danger" })
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(model => model.EntranceAppearingPoints, "Entrance Appearing Points")<span class="txtRed"> *</span>
                            @Html.EditorFor(model => model.EntranceAppearingPoints, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.EntranceAppearingPoints, "", new { @class = "text-danger" })
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(m => m.MetaTitle, new { @style = "" })
                            @Html.TextBoxFor(model => model.MetaTitle, new { @class = "form-control" })
                            @Html.ValidationMessageFor(model => model.MetaTitle, String.Empty, new { @class = "text-danger" })
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(m => m.MetaKeyword, new { @style = "" })
                            @Html.TextBoxFor(model => model.MetaKeyword, new { @class = "form-control" })
                            @Html.ValidationMessageFor(model => model.MetaKeyword, String.Empty, new { @class = "text-danger" })
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(m => m.MetaDescription, new { @style = "" })
                            @Html.TextAreaFor(model => model.MetaDescription, 3, 4, new { @class = "form-control" })
                            @Html.ValidationMessageFor(model => model.MetaDescription, String.Empty, new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="col-lg-6 col-md-6">
                        <div class="form-group calendar-date">
                            @Html.LabelFor(model => model.StartDate, "Start Date")<span class="txtRed"> *</span>
                            <br />
                            @Html.TextAreaFor(model => model.StartDate, new { @onkeydown = "javascript:return false;" })
                            @Html.ValidationMessageFor(model => model.StartDate, "", new { @class = "text-danger" })
                        </div>

                        <div class="form-group" style="display:none">
                            @Html.LabelFor(model => model.TotalQuestion, "No. of Question")<span class="txtRed"> *</span>
                            @Html.TextBoxFor(model => model.TotalQuestion, new { @class = "form-control", @type = "number", min = "1", @Value = 1 })
                            @Html.ValidationMessageFor(model => model.TotalQuestion, "", new { @class = "text-danger" })
                        </div>
                        <div class="form-group calendar-date">
                            @Html.LabelFor(model => model.EndDate, "End Date")<span class="txtRed"> *</span>
                            <br />
                            @Html.TextAreaFor(model => model.EndDate, new { @onkeydown = "javascript:return false;" })
                            @Html.ValidationMessageFor(model => model.EndDate, "", new { @class = "text-danger" })
                        </div>
                        <div class="form-group">
                            @Html.Label("User Group")<span class="txtRed"> *</span>
                            @Html.DropDownListFor(Model => Model.NotificationID, (SelectList)ViewBag.GetAllUserGroup, new { @class = "form-control", @multiple = true })
                            @Html.ValidationMessageFor(model => model.NotificationID, "", new { @class = "text-danger" })
                        </div>
                        <div class="form-group mdl-selectfield">
                            @Html.LabelFor(model => model.StatusValue, "Status")<span class="txtRed"> *</span>
                            @Html.DropDownListFor(model => model.StatusValue, new SelectList(new List<SelectListItem> {
                        new SelectListItem { Text = "Active", Value = "1" },
                        new SelectListItem { Text = "InActive", Value = "0" }
                        }, "Value", "Text"), new { @class = "form-control" })
                            @Html.ValidationMessageFor(model => model.StatusValue, "", new { @class = "text-danger" })
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(model => model.CanShowCorrectAnswer, "Show Correct Answer")<span class="txtRed"> *</span>
                            <br />
                            @Html.RadioButtonFor(Model => Model.CanShowCorrectAnswer, "true") Yes
                            @Html.RadioButtonFor(Model => Model.CanShowCorrectAnswer, "false", new { @checked = "checked" }) No
                            @Html.ValidationMessageFor(model => model.CanShowCorrectAnswer, "", new { @class = "text-danger" })
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(model => model.IsPauseAllowed, "Allow Pause")<span class="txtRed"> *</span>
                            <br />
                            @Html.RadioButtonFor(Model => Model.IsPauseAllowed, "true") Yes
                            @Html.RadioButtonFor(Model => Model.IsPauseAllowed, "false", new { @checked = "checked" }) No
                            @Html.ValidationMessageFor(model => model.IsPauseAllowed, "", new { @class = "text-danger" })
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(model => model.CanShowAllQuestions, "Show all question once")<span class="txtRed"> *</span>
                            <br />
                            @Html.RadioButtonFor(Model => Model.CanShowAllQuestions, "true") Yes
                            @Html.RadioButtonFor(Model => Model.CanShowAllQuestions, "false", new { @checked = "checked" }) No
                            @Html.ValidationMessageFor(model => model.CanShowAllQuestions, "", new { @class = "text-danger" })
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(model => model.CanSeePreviousAnswer, "Allow to see previous Question")<span class="txtRed"> *</span>
                            <br />
                            @Html.RadioButtonFor(Model => Model.CanSeePreviousAnswer, "true") Yes
                            @Html.RadioButtonFor(Model => Model.CanSeePreviousAnswer, "false", new { @checked = "checked" }) No
                            @Html.ValidationMessageFor(model => model.CanSeePreviousAnswer, "", new { @class = "text-danger" })
                        </div>
                        <div class="form-group" style="display:none">
                            @Html.LabelFor(model => model.IsQuestionManual, "Add Question Manually")<span class="txtRed"> *</span>
                            <br />
                            @Html.RadioButtonFor(Model => Model.IsQuestionManual, "true", new { @checked = "checked" }) Yes
                            @Html.RadioButtonFor(Model => Model.IsQuestionManual, "false") No
                            @Html.ValidationMessageFor(model => model.IsQuestionManual, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="col-lg-12 clearfix">
                        <div class="form-group clearfix mtb-sm">
                            <button id="btnChooseQuestionManually" class="btn btn-default btnCustom pull-left">Choose Manual Question</button>
                        </div>
                        <div id="divActualAnswerGrid">
                        </div>
                        <div class="form-group clearfix">
                            @Html.LabelFor(model => model.EntranceDescription, "Entrance Description")<span class="txtRed"> *</span>
                            @Html.TextAreaFor(model => model.EntranceDescription, new { @class = "form-control" })
                            @Html.ValidationMessageFor(model => model.EntranceDescription, "", new { @class = "text-danger" })
                        </div>
                        <div class="form-group clearfix">
                            @Html.LabelFor(model => model.StartPageDescription, "Start Page Description")<span class="txtRed"> *</span>
                            @Html.TextAreaFor(model => model.StartPageDescription, new { @class = "form-control" })
                            @Html.ValidationMessageFor(model => model.StartPageDescription, "", new { @class = "text-danger" })
                        </div>
                        <div class="form-group clearfix">
                            @Html.LabelFor(model => model.EndPageDescription, "End Page Description")<span class="txtRed"> *</span>
                            @Html.TextAreaFor(model => model.EndPageDescription, new { @class = "form-control" })
                            @Html.ValidationMessageFor(model => model.EndPageDescription, "", new { @class = "text-danger" })
                        </div>


                    </div>

                    <div class="col-lg-12">
                        <button type="submit" class="btn btn-default btnCustom" id="btnSave">Submit</button>
                        <button type="reset" class="btn btn-default btnCancle" id="btnCancel">Cancel</button>
                    </div>
                </div>

            </div>
            <!-- /.panel -->
        </div>
        <!-- /.col-lg-6 -->
    </div>



    <!-- Choose Manual Question Modal -->
    <div class="row" id="divChooseEntranceQuestion" style="display:none">
        <div class="col-lg-12">
            <div class="panel panel-default">
                <div class="panel-heading" id="formHeading">
                    Choose Entrance Question
                    <button type="reset" class="btn btn-default btn-xs btnCustom pull-right" id="btnBackToMainForm">Back</button>
                </div>
                <!-- /.panel-heading -->
                <div class="row panel-body">
                    <div class="col-lg-12">
                        @*<p>Selected List</p>*@
                        <div id="SelectedQuestionGrid">
                        </div>
                    </div>
                    <div class="col-lg-12">
                        <div class="row">
                            <div class="form-group">

                                <div class="col-md-3">
                                    <label>Search Question</label>
                                    <input class="form-control" id="txtSearchQuestion" placeholder="Search Question">
                                </div>
                                <div class="col-md-3">
                                    <label>Select Difficulty Level</label>
                                    @Html.DropDownList("ddlSearchQuestionDifficulty", (SelectList)ViewBag.EntranceQestionDifficulty, "All Question Difficulty", new { @class = "form-control" })
                                </div>
                                <div class="col-md-3">
                                    <label>Select Category</label>
                                    @Html.DropDownList("ddlSearchQuestionCategory", (SelectList)ViewBag.EntraceQuestionCategory, "All Question Category", new { @class = "form-control" })
                                </div>
                                <div class="col-md-3">
                                    <label>Question Type</label>
                                    <select class="form-control" id="ddlSearchQuestionType">
                                        <option value="-1">All</option>
                                        <option value="1">Mandatory</option>
                                        <option value="0">Optional</option>
                                    </select>
                                </div>
                                <div class="col-md-3">
                                    <button type="submit" class="btn btn-default btnCustom" id="btnSearchEntranceQuestion">Search</button>
                                    <button type="submit" class="btn btn-default btnCancel ResetInputField" id="btnClearSearch">Reset</button>
                                </div>
                            </div>

                            <!-- /.col-lg-4 -->
                        </div>
                        <div id="divMainGridContainer" class="table-responsive-scroll">@Html.Partial("~/Areas/Admin/Views/Entrance/EntranceQuestionGrid.cshtml")</div>

                    </div>
                </div>
                <div class="col-lg-12">
                    <button type="button" class="btn btn-warning btnViewSelected" id="btnViewAllSelectedQuestion">View Selected Question</button>
                    <button id="btnConfirmSelectedAnswer" class="btn btn-default btnCustom">Confirm</button>
                </div>
            </div>
            <!-- /.panel -->
        </div>
        <!-- /.col-lg-6 -->
    </div>


    <!-- Choose Dynaimic Question Modal -->
    @*<div class="row" id="divChooseDynamicQuizQuestion" style="display:none">
            <div class="col-lg-12">
                <div class="panel panel-default">
