    <div id="divEntranceGrid">
        <div class="row">
            <div class="col-md-12 pageHeaderBox11">
                <h1 class="page-header">Entrance</h1>
                <div class="pull-right">
                    @*@if (ViewBag.createAccess == true)
                        {*@
                    <button type="submit" class="btn btn-default btnCustom" id="btnCreateEntrance">Create Entrance</button>
                    @*}*@

                </div>
            </div>
        </div>

        <div class="row">
            <div class="panel panel-flat">
                <div class="panel-body">
                    <div class="form-group">
                        <div class="col-md-2">
                            <label>Entrance Title</label>
                            <input class="form-control" id="txtSearchEntranceTitle" placeholder="Search Entrance Title">
                        </div>

                        <div class="col-md-2">
                            <label>Status</label>
                            @Html.DropDownList("ddlSearchEntranceStatus", new SelectList(new List<SelectListItem> {
                        new SelectListItem { Text = "Active", Value = "Active" },
                        new SelectListItem { Text = "InActive", Value = "Inactive" }
                        }, "Value", "Text"), " All Status", new { @class = "form-control" })
                        </div>
                        <div class="col-md-2">
                            <label>Started From</label>
                            @Html.TextArea("txtSearchEntranceStartedFrom", new { @onkeydown = "javascript:return false;", @placeholder = "Entrance Started From" })
                            @*@(Html.Kendo().DatePicker().Name("txtSearchQuizStartedFrom").HtmlAttributes(new { onkeydown = "javascript:return false;" ,@placeholder="Quiz Started From" }))*@
                        </div>
                        <div class="col-md-2">
                            <label>Started To</label>
                            @Html.TextArea("txtSearchEntranceStartedTo", new { @onkeydown = "javascript:return false;", @placeholder = "Entrance Started To" })
                            @*@(Html.Kendo().DatePicker().Name("txtSearchQuizStartedTo").HtmlAttributes(new { onkeydown = "javascript:return false;" ,@placeholder = "Quiz Started To" }))*@
                        </div>
                        <div class="col-md-2">
                            <label>End From</label>
                            @*@Html.TextArea("txtSearchQuizEndFrom", new { @onkeydown = "javascript:return false;", @placeholder = "Quiz Ended From" })*@
                            @(Html.Kendo().DatePicker().Name("txtSearchEntranceEndFrom").HtmlAttributes(new { onkeydown = "javascript:return false;", @placeholder = "Entrance Ended From" }))
                        </div>
                        <div class="col-md-2">
                            <label>End To</label>
                            @*@Html.TextArea("txtSearchQuizEndTo", new { @onkeydown = "javascript:return false;", @placeholder = "Quiz Ended To" })*@
                            @(Html.Kendo().DatePicker().Name("txtSearchEntranceEndTo").HtmlAttributes(new { onkeydown = "javascript:return false;", @placeholder = "Entrance Ended To" }))
                        </div>
                        <div class="col-md-2">
                            <button type="submit" class="btn btn-default btnCustom" id="btnSearchEntrance">Search</button>
                            <button type="submit" class="btn btn-default btnCancle ResetInputField" id="btnClearEntranceSearch">Reset</button>
                        </div>
                    </div>
                </div>
            </div>
            <!-- /.col-lg-4 -->
        </div>
        <div class="changeStatusOption hide">
            <div class="col-lg-3 col-md-3">
                <label>Status</label>
                @Html.DropDownList("ddlChangeEntranceStatus", new SelectList(new List<SelectListItem> {
            new SelectListItem { Text = "Active", Value = "Active" },
            new SelectListItem { Text = "InActive", Value = "Inactive" }
            }, "Value", "Text"), new { @class = "form-control" })

            </div>
            <div class="col-lg-3 col-md-3 mg-tb">
                <button type="submit" class="btn btn-default btnCustom" id="btnSaveStatusForSelectedQuiz">Save</button>
            </div>
        </div>
        <div class="row clearfix">
            <div class="col-lg-12">
                <div class="">
                    <!-- /.panel-heading -->
                    <div class="row panel-body">
                        <div id="divMainGridContainer" class="table-responsive-scroll">@Html.Partial("~/Areas/Admin/Views/Entrance/EntranceListing.cshtml")</div>
                    </div>
                </div>
                <!-- /.panel -->
            </div>
        </div>
    </div>

}
<div class="modal fade" id="EntranceBatchUpdateModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
    <div class="modal-dialog" role="document">
        <div class="modal-content modal-dashboard">

            <div class="modal-header">
                <p>Are you sure?</p>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-lg-12 listing">
                        <label>Quiz</label>
                        <ol class="UpdateStatusListingBody">
                            <li>
                                <span>The Quiz Name (eg Sandeep) is unfinished.</span>
                            </li>
                        </ol>
                    </div>

                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal" id="btnCancelUpdate">No</button>
                <button type="button" class="btn btn-primary" data-dismiss="modal" id="btnConfirmUpdate">Yes</button>
            </div>
        </div>
    </div>
</div>

<script>
    var CustomRecordPerPage = '@ViewBag.ItemPerPage';
</script>
<script src="~/Content/vendor/multiselectdropdown/js/jquery.sumoselect.js" type="text/javascript"></script>
<link href="~/Content/vendor/multiselectdropdown/css/dropdownliststyle.css" rel="stylesheet" type="text/css" />
<script src="~/Content/JS/Common.js"></script>
<script src="~/Scripts/jquery.validate.min.js"></script>
<script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>
<script src="~/Content/JS/BackEnd/EntranceAdmin.js"></script>


