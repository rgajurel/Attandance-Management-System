            @using Kendo.Mvc.UI
            @(Html.Kendo().Grid<DomainEntities.BusInfo>()
    .Name("BusInfoGrid")

            .Columns(columns =>
            {
                // columns.Template(t => { }).Title("Row No").ClientTemplate("#= renderNumber(data) #").Hidden();
                //columns.Template(t => { }).Title("S.N").ClientTemplate("#= renderRecordNumber(data) #").Width(50);
                columns.Bound(c => c.ID).Hidden();
                columns.Bound(c => c.SN).Title("S.N").Width(20);
                columns.Bound(c => c.BusNo).Title("Bus No").Width(150);
                columns.Bound(c => c.DriverName).Title("Driver Name").Width(150);
                columns.Bound(c => c.DriverPhoneNo).Title("Driver Phone No").Width(150);
                columns.Bound(c => c.SupporterName).Title(" Supporter Name").Width(150);               

                //columns.Bound(c => c.Type).Title("Modified On").Width(50).ClientTemplate("#= customDate(data) #").Format(ViewBag.settingDateFormat);

                columns.Command(command =>
                {
                    command.Custom("Edit").Text(" ").Click("Edit");
                   command.Custom("Delete").Text(" ").Click("Delete");

                }).Width(50).Title("Action");

            })


                     .ToolBar(toolbar =>
                     {
                         toolbar.Template(@<text>


                <div class="right-inner-addon" style="width:200px">

                    <input type="search"
                           class="form-control"
                           placeholder="Search" id="FieldFilter" />

                </div>
                        </text>);
                     })


                    //.Filterable()
                    //.Sortable(sortable => sortable
                    // .AllowUnsort(true)
                    // .SortMode(GridSortMode.MultipleColumn))
                    .Pageable(
              page => page.Refresh(true)
             .PageSizes(new int[] { 10, 20, 40, 60, 80, 100 })
              .PreviousNext(true))

            .Reorderable(reorder => reorder.Columns(true))
                    .DataSource(dataSource => dataSource
                        .Ajax()
                        .ServerOperation(false)
                                .Model(model =>
                                {
                                    model.Id(p => p.ID);
                                    model.Field(p => p.BusNo).Editable(false);

                                })
                  .Read(read => read.Action("GetAll", "BusInfo"))// Action invoked when the user saves a new data item
                  .PageSize(10)
             )
.Events(ev => ev.DataBound("resetRowNumber"))

            )
        </div>








    </div>
</div>
</div>