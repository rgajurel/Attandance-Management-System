
@using Kendo.Mvc.UI
@model DomainEntities.UserGroup
<script src="~/Scripts/jquery.validate.min.js"></script>
<script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>
<script src="~/Content/JS/BackEnd/UserGroup.js"></script>

    <div class="content">
        <div class="row">
            <div class="col-sm-12">
                <div class="panel panel-default">
                    <div class="panel-heading">
                        <h4 class="panel-title">User Group</h4>
                    </div>
                    <div class="panel-body">
                        <div class="col-sm-12">
                            @using (Html.BeginForm("", "", FormMethod.Post, new { enctype = "multipart/form-data", id = "formUserGroup", name = "formUserGroup", onSubmit = "return false;" }))
                            {
                                @Html.AntiForgeryToken()
                                <div class="row">
                                    <div class="form-group">
                                        <div class="col-md-3">

                                            @Html.LabelFor(model => model.OrganisationID)<span style="color:red">*</span>
                                            @Html.DropDownListFor(model => model.OrganisationID, (SelectList)ViewBag.allOrganisation, "--Organisation--", new { @class = "form-control", required = "required" })
                                            @Html.ValidationMessageFor(model => model.OrganisationID, String.Empty, new { @class = "text-danger" })
                                        </div>
                                        <div class="col-md-3">
                                            @Html.HiddenFor(model => model.ID, new { @Value = "0" })
                                            @Html.LabelFor(model => model.GroupName)<span style="color:red">*</span>
                                            @Html.TextBoxFor(model => model.GroupName, new { @class = "form-control", required = "required" })
                                            @Html.ValidationMessageFor(model => model.GroupName, String.Empty, new { @class = "text-danger" })
                                        </div>


                                        <div class="col-md-3">
                                            @Html.LabelFor(model => model.StatusValue)<span style="color:red">*</span>
                                            @Html.DropDownListFor(model => model.StatusValue, new List<SelectListItem>
{
    new SelectListItem{ Text="Active", Value = "1" },
    new SelectListItem{ Text="InActive", Value = "2" },
 }, "--Select--", new { @class = "form-control" })
                                            @Html.ValidationMessageFor(model => model.StatusValue, String.Empty, new { @class = "text-danger" })
                                        </div>

                                        <div class="col-md-3 pulldown">
                                            <input class="btn btn-danger" name="userGroupSave" id="userGroupSave" value="Save" type="submit" />
                                            <input class="btn" name="userGroupCancel" id="userGroupCancel" value="Cancel" type="reset">
                                            <button type="button" id="Search" class="btn btn-primary">Search</button>

                                        </div>

                                    </div>
                                </div>


                            }
                        </div>

                    </div>
                </div>

            </div>

        </div>

    </div>
     
<div class="row">
    <div class="col-lg-12">
        <div id="userGroupList">@Html.Partial("~/Areas/Admin/Views/UserGroup/UserGroupList.cshtml")</div>
    </div>
</div>
