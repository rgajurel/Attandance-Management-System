



<div class="row" style="margin-top:10px">
    <div class="col-lg-12">
        <div class="pageHeaderBox11">


        </div>
    </div>
    <!-- /.col-lg-12 -->
</div>

@using Kendo.Mvc.UI
@(Html.Kendo().Grid<DomainEntities.TaxMaster>()
    .Name("TaxMasterGrid")
            .Columns(columns =>
            {
                columns.Bound(c => c.ID).Hidden();
                columns.Bound(c => c.SN).Title("S.N").Width(20);
                columns.Bound(c => c.AmountFrom).Title("Amounts From").Width(150);
                columns.Bound(c => c.AmountTo).Title("Amounts To").Width(150);
                columns.Bound(c => c.TaxPercentage).Title("%").Width(150);
                columns.Bound(c => c.SortOrder).Title("Sort Order").Width(150);
                columns.Bound(c => c.AddedBy).Title("Added By").Width(150);
                columns.Bound(c => c.AddedOn).Title("Added On").Width(150).Format("{0:MM-dd-yyyy}");

                //columns.Bound(c => c.Type).Title("Modified On").Width(50).ClientTemplate("#= customDate(data) #").Format(ViewBag.settingDateFormat);

                columns.Command(command =>
                {
                    command.Custom("Edit").Text(" ").Click("Edit");
                    command.Custom("Delete").Text(" ").Click("Delete");

                }).Width(50).Title("Action");

            })

                     @*.ToolBar(toolbar =>
                     {
                         toolbar.Template(@<text>


        <div class="right-inner-addon" style="width:200px">

            <input type="search"
                   class="form-control"
                   placeholder="Search By " id="FieldFilter" />

        </div>
                        </text>);
                     })*@


                    //.Filterable()
                    //.Sortable(sortable => sortable
                    // .AllowUnsort(true)
                    // .SortMode(GridSortMode.MultipleColumn))
                    .Pageable(
              page => page.Refresh(true)
             .PageSizes(new int[] { 10, 20, 40, 60, 80, 100 })
              .PreviousNext(true))

            .Reorderable(reorder => reorder.Columns(true))
                    .DataSource(dataSource => dataSource
                        .Ajax()
                        .ServerOperation(false)
                                .Model(model =>
                                {
                                    model.Id(p => p.ID);
                                    model.Field(p => p.AmountFrom).Editable(false);
                                    model.Field(p => p.AmountTo).Editable(false);

                                })
                  .Read(read => read.Action("GetAll", "TaxMaster"))// Action invoked when the user saves a new data item
                  .PageSize(5)
             )
.Events(ev => ev.DataBound("resetRowNumber"))

)








