
<script src="~/Scripts/jquery.validate.min.js"></script>
<script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>
<script src="~/Content/JS/BackEnd/DailyAttandanceReport.js"></script>

@using Kendo.Mvc.UI
@model DomainEntities.DailyAttandanceReport
@using (Html.BeginForm("", "", FormMethod.Post, new { enctype = "multipart/form-data", autocomplete = "off", id = "formDailyAttandanceReport", name = "formDailyAttandanceReport", onSubmit = "return false;" }))
{
    <div class="x_panel">
        <div class="col-md-3">
            @Html.LabelFor(model => model.OrganisationID)<span style="color:red">*</span>
            @Html.DropDownListFor(model => model.OrganisationID, Enumerable.Empty<SelectListItem>(), "--Organisation--", new { @class = "form-control", required = "required" })
            @Html.ValidationMessageFor(model => model.OrganisationID, String.Empty, new { @class = "text-danger" })
        </div>
        <div class="col-md-2">
            @Html.LabelFor(model => model.Year)<span style="color:red">*</span>
            @Html.DropDownListFor(model => model.Year, (SelectList)ViewBag.sessionList, "--Select--", new { @class = "form-control", required = "required" })
            @Html.ValidationMessageFor(model => model.Year, String.Empty, new { @class = "text-danger" })
        </div>

        <div class="col-md-2">
            @Html.LabelFor(model => model.Month)<span style="color:red">*</span>
            @Html.DropDownListFor(model => model.Month, (SelectList)ViewBag.monthList, "--Select--", new { @class = "form-control", required = "required" })
            @Html.ValidationMessageFor(model => model.Month, String.Empty, new { @class = "text-danger" })
        </div>
     <div class="col-md-2 nepalishow">        
             @Html.LabelFor(model => model.NepaliDate)
             @Html.TextBoxFor(model => model.NepaliDate, new { @class = "form-control" })

             @Html.ValidationMessageFor(model => model.NepaliDate, String.Empty, new { @class = "text-danger" })
         </div>
         <div class="col-md-2 englishshow">
             @Html.LabelFor(model => model.Date)
             @(Html.Kendo().DateTimePickerFor(m => m.Date)
                                                            .Name("Date")
                                                            .Value(DateTime.Now)
                                                            .Format("yyyy-MM-dd")
                                                            .HtmlAttributes(new { @class = "form-control" })
             )
             @Html.ValidationMessageFor(model => model.Date, String.Empty, new { @class = "text-danger" })
         </div>     

        <div class="col-md-3">
            <button style="margin-top:26px" class="btn btn-danger" id="dailyAttandanceReport">Generate</button>
        </div>
    </div>

}

<div id="attandanceResults">

</div>

