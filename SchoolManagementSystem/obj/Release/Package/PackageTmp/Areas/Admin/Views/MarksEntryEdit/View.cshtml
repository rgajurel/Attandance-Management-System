            @Html.ValidationMessageFor(model => model.FullMarksTheory, String.Empty, new { @class = "text-danger" })
        </div>
        <div class="col-sm-2">
            @Html.LabelFor(model => model.PassMarksTheory)
            @Html.TextBoxFor(model => model.PassMarksTheory, new { @class = "form-control", @placeholder = "From", @readonly = "true" })
            @Html.ValidationMessageFor(model => model.PassMarksTheory, String.Empty, new { @class = "text-danger" })
        </div>

        <div class="col-sm-2">
            @Html.LabelFor(model => model.FullMarksPractical)
            @Html.TextBoxFor(model => model.FullMarksPractical, new { @class = "form-control", @placeholder = "From", @readonly = "true" })
            @Html.ValidationMessageFor(model => model.FullMarksPractical, String.Empty, new { @class = "text-danger" })
        </div>
        <div class="col-sm-2">
            @Html.LabelFor(model => model.PassMarksPractical)
            @Html.TextBoxFor(model => model.PassMarksPractical, new { @class = "form-control", @placeholder = "From", @readonly = "true" })
            @Html.ValidationMessageFor(model => model.PassMarksPractical, String.Empty, new { @class = "text-danger" })
        </div>

        <div class="col-sm-2">
            @Html.LabelFor(model => model.CreditPoint)
            @Html.TextBoxFor(model => model.CreditPoint, new { @class = "form-control", @placeholder = "From", @readonly = "true" })
            @Html.ValidationMessageFor(model => model.CreditPoint, String.Empty, new { @class = "text-danger" })
        </div>


    </div>

</div>
   



