
@model DomainEntities.MarksEntry

<script src="~/Scripts/jquery.validate.min.js"></script>
<script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>
<script src="~/Scripts/Client Scripts/mvcfoolproof.unobtrusive.min.js"></script>
<script src="~/Content/JS/BackEnd/MarksEntryEdit.js"></script>

<div class="row">
    <div class="col-md-12">
        <ol class="breadcrumb">
            <li><i class="fa fa-home"></i><a href="/Admin/SchoolInformation">Exam</a></li>
            <li><a href="/Admin/OrganisationType">Marks Entry Update</a></li>

        </ol>
