<script>

    $(document).ready(function () {
        $('[class^=tbl_]').fadeOut(0);
        $('[class^=tblData_]').fadeOut(0);
    })

    function FadeHideAll() {
        var expandStatus = $("#expandMultiple").attr('class');
        if (expandStatus == "fa fa-plus") {
            $("#expandMultiple").toggleClass('fa-plus fa-minus');
            $('[id^=bill_]').removeClass("fa-plus").addClass("fa-minus");
            $('[class^=tbl_]').fadeIn(200);
            $('[class^=tblData_]').fadeIn(200);
        } else {
            $("#expandMultiple").toggleClass('fa-minus fa-plus');
            $('[id^=bill_]').removeClass("fa-minus").addClass("fa-plus");
            $('[class^=tbl_]').fadeOut(200);
            $('[class^=tblData_]').fadeOut(200);
        }
    }

    function expand(id) {
        var expandStatus = $("#bill_" + id + "").attr('class');
        if (expandStatus == "fa fa-plus") {
            $("#bill_" + id + "").toggleClass('fa-plus fa-minus');
            $(".tbl_" + id + "").fadeIn(200)
            $(".tblData_" + id + "").fadeIn(200)
        } else {
            $("#bill_" + id + "").toggleClass('fa-minus fa-plus');
            $(".tbl_" + id + "").fadeOut(200);
            $(".tblData_" + id + "").fadeOut(200);
        }
    }
</script>
@using System.Data
<div class="page-header">
    <div class="breadcrumb-line">
        <ul class="breadcrumb">
            <li>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<i class="fa fa-home position-left"></i>Parents</li>
            <li class="active">Student Fee Details</li>
        </ul>

    </div>
</div>
@{
    decimal totalFee = 0;
    decimal totalDiscount = 0;
    decimal totalPaid = 0;
}
<br />

<div class="container-fluid">
    <ul class="nav nav-tabs" role="tablist">
        <li class="nav-item active">
            <a class="nav-link" data-toggle="tab" href="#history">Payment History</a>
        </li>
        <li class="nav-item">
            <a class="nav-link" data-toggle="tab" href="#particular">Fee Particulars</a>
        </li>
        <li class="nav-item">
            <a class="nav-link" data-toggle="tab" href="#calculation">Calculation</a>
        </li>
    </ul>


    <div class="tab-content">
        <div id="history" class="tab-pane active" style="max-height:400px;overflow-y:auto">
            <br>
            <table class="table table-responsive table-condensed">
                <thead>
                    <tr class="success">
                        <th>Bill No</th>
                        <th>Payment Date(B.S)</th>
                        <th>Total Fee</th>
                        <th>Total Discount</th>
                        <th>Previous Due</th>
                        <th>Grand Total</th>
                        <th>Total Paid</th>
                        <th>Payment Due</th>
                        <th><a onclick="FadeHideAll()"><i id="expandMultiple" class="fa fa-plus" aria-hidden="true"></i></a></th>
                    </tr>
                </thead>
                <tbody>
                    @{

                        int billNoLater = 0;
                        int billNoEarlier = 0;
                        foreach (var collection in ViewBag.StudentsCollection)
                        {
                            if (billNoEarlier != collection.ID)
                            {
                                totalPaid += collection.TotalPaid;
                    <tr class="info">
                        <td>@collection.ID</td>
                        <td>@collection.PaymentMiti</td>
                        <td>@collection.TotalFee</td>
                        <td>@collection.TotalDiscount</td>
                        <td>@collection.previousDue</td>
                        <td>@collection.GrandTotal</td>
                        <td>@collection.TotalPaid</td>
                        <td>@collection.PaymentDue</td>
                        <td><a onclick="expand(@collection.ID)"><i id="bill_@collection.ID" class="fa fa-plus" aria-hidden="true"></i></a></td>
                    </tr>

                                var data = ViewBag.StudentsCollection as List<DomainEntities.CollectionDetailsForlient>;
                                var filteredData = data.Where(w => w.ID == collection.ID).Select(i =>
                        new { type = i.FeeType, month = i.Month, fee = i.Fee, discount = i.Discount }).ToArray();
                                int count = 0;
                                foreach (var dataItem in filteredData)
                                {
                                    if (count == 0)
                                    {
                    <tr class="tbl_@collection.ID" style="background-color: #f5f5f5;">
                        <td colspan="2">Particular</td>
                        <td>Month</td>
                        <td>Fee</td>
                        <td>Discount</td>
                    </tr>
                                    }
                    <tr class="tblData_@collection.ID" style="background-color: #fafafa;">
                        <td colspan="2">@dataItem.type</td>
                        <td>@dataItem.month</td>
                        <td>@dataItem.fee</td>
                        <td>@dataItem.discount</td>
                    </tr>
                                    count++;
                                }
                            }
                            billNoEarlier = collection.ID;
                            billNoLater = collection.ID;

                        }
                    }
                <tbody>
            </table>
            <br />
            <p style="font-weight:bold;font-size:medium;float:right;padding-right:20px;">Total Paid :: @totalPaid</p>
        </div>

        <div id="particular" class="tab-pane fade" style="max-height:400px;overflow-y:auto">
            <br>
            <table class="table table-responsive table-striped table-condensed">
                <thead>
                    <tr class="success">
                        <th>Particular</th>
                        <th>Month</th>
                        <th>Fee</th>
                        <th>Discount</th>
                    </tr>
                </thead>
                <tbody>
                    @{

                        foreach (var student in ViewBag.StudentsFee)
                        {
                            totalFee += student.Fee;
                            totalDiscount += student.Discount;

                    <tr>
                        <td>@student.Type</td>
                        <td>@student.Month</td>
                        <td>@student.Fee</td>
                        <td>@student.Discount</td>
                    </tr>
                        }
                    }
                    <tr class="info">
                        <td colspan="2">Total</td>
                        <td>@totalFee</td>
                        <td>@totalDiscount</td>
                    </tr>
                </tbody>
            </table>
            <br />
            @{
                decimal totalAmount = totalFee - totalDiscount;
            }
            <p style="font-weight:bold;font-size:medium;float:right;padding-right:20px;">Total Amount :: Fee - Discount = @totalAmount</p>
        </div>

        <div id="calculation" class="tab-pane fade" style="max-height:400px;overflow-y:auto">
            <br />
            @{ 
                decimal totalBill = totalFee - totalDiscount;
                decimal totalRemaining = totalBill - totalPaid;
            }
            <table class="table table-responsive table-condensed">
                <thead>
                    <tr>
                        <td>Total Bill</td>
                        <td>@totalBill</td>
                    </tr>
                    <tr>
                        <td>Total Paid</td>
                        <td>@totalPaid</td>
                    </tr>
                    <tr class="success">
                        <td>Total Remaining</td>
                        <td>@totalRemaining</td>
                    </tr>
            </table>
        </div>
    </div>
</div>
